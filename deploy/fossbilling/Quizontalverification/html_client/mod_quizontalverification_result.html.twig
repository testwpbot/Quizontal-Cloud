{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}{% block content %}<style>.qv{max-width:580px;margin:8vh auto;text-align:center;padding:clamp(28px,6vw,58px);border:1px solid rgba(255,255,255,.1);border-radius:24px;background:linear-gradient(145deg,rgba(227,28,100,.16),rgba(24,28,38,.9));box-shadow:0 24px 70px rgba(0,0,0,.28)}.qv-icon{width:76px;height:76px;border-radius:50%;display:grid;place-items:center;margin:auto auto 22px;font-size:36px;background:{{ verified?'rgba(65,190,130,.18)':'rgba(227,28,100,.18)' }};color:{{ verified?'#62d69c':'#ff779f' }};animation:qvpop .55s ease-out}@keyframes qvpop{from{transform:scale(.35);opacity:0}to{transform:scale(1);opacity:1}}</style><section class="qv"><div class="qv-icon">{{ verified?'✓':'!' }}</div>{% if verified %}<h1>Email verified</h1><p>Your Quizontal Cloud account is ready. You can now start a hosting trial or order any service.</p><a class="premium-btn" href="{{ 'login'|link }}">Continue to client area</a>{% else %}<h1>Verification link unavailable</h1><p>{{ error }}</p><a class="premium-btn" href="{{ 'login'|link }}">Sign in and resend email</a>{% endif %}</section>{% endblock %}
