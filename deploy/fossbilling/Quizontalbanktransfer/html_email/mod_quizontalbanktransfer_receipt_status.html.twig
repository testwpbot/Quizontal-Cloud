{% block subject %}Payment slip not verified - {{ submission.serie_nr }}{% endblock %}
{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f8;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e5e7eb;">
<tr><td style="padding:20px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;color:#111827;">QUIZONTAL CLOUD</td></tr>
<tr><td style="padding:0 24px 24px 24px;font-family:Arial,Helvetica,sans-serif;">
<h1 style="margin:0 0 8px;font-size:18px;line-height:26px;color:#111827;font-weight:600;">Payment slip could not be verified</h1>
<p style="margin:0 0 16px;font-size:14px;line-height:22px;color:#374151;">Hello {{ customer.first_name }}, we reviewed your slip for invoice {{ submission.serie_nr }} but could not match it to a bank payment.</p>
<p style="margin:0;font-size:13px;line-height:20px;color:#374151;">Submission #{{ submission.id }} | Invoice {{ submission.serie_nr }} | Amount {{ submission.amount|money(submission.currency) }} | Ref {{ submission.reference }} | Status: Rejected</p>
{% if submission.admin_note %}<p style="margin:12px 0 0;padding:10px 12px;background:#f9fafb;border-left:3px solid #111827;font-size:13px;line-height:20px;color:#374151;"><strong>Note:</strong><br>{{ submission.admin_note }}</p>{% endif %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:20px 0 0;">
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="background:#111827;border-radius:4px;"><a href="{{ ('invoice/' ~ submission.invoice_hash)|link }}" style="display:inline-block;padding:11px 20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:600;color:#ffffff;text-decoration:none;">Upload new slip</a></td></tr></table>
</td></tr></table>
<p style="margin:16px 0 0;font-size:12px;line-height:18px;color:#6b7280;">If you already paid, reply to this email with bank receipt or open support ticket.</p>
</td></tr>
<tr><td style="padding:14px 24px;border-top:1px solid #f3f4f6;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;color:#9ca3af;">Quizontal Cloud</td></tr>
</table>
</td></tr>
</table>
{% endblock %}
