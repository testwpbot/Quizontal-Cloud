{% block subject %}{% if recipient_type == 'admin' %}New payment slip is uploaded{% else %}We received your payment receipt{% endif %}{% endblock %}
{% block content %}
<div style="margin:0;padding:28px;background:#f5f6f8;font-family:Arial,sans-serif;color:#20242b">
  <div style="max-width:620px;margin:0 auto;background:#ffffff;border:1px solid #e4e6ea;border-radius:14px;overflow:hidden">
    <div style="height:5px;background:#e31c64"></div>
    <div style="padding:28px">
      <div style="font-size:22px;font-weight:700;margin-bottom:8px">Quizontal Cloud</div>
      {% if recipient_type == 'admin' %}
        <h1 style="font-size:24px;margin:24px 0 8px">New payment slip is uploaded</h1>
        <p style="color:#6b7280;line-height:1.6;margin-top:0">A customer uploaded a new payment slip for wallet funding. Please verify the payment against the bank account before approving it.</p>
      {% else %}
        <h1 style="font-size:24px;margin:24px 0 8px">Receipt submitted successfully</h1>
        <p style="color:#6b7280;line-height:1.6;margin-top:0">Hello {{ customer.first_name }}, we received your bank transfer receipt. Your wallet will be credited after the payment is confirmed in our bank account.</p>
      {% endif %}
      <table style="width:100%;border-collapse:collapse;margin:24px 0;background:#fafafa;border-radius:10px">
        <tr><td style="padding:12px;border-bottom:1px solid #e7e8eb;color:#6b7280">Submission</td><td style="padding:12px;border-bottom:1px solid #e7e8eb;font-weight:700">#{{ submission.id }}</td></tr>
        <tr><td style="padding:12px;border-bottom:1px solid #e7e8eb;color:#6b7280">Invoice</td><td style="padding:12px;border-bottom:1px solid #e7e8eb;font-weight:700">{{ submission.serie_nr }}</td></tr>
        <tr><td style="padding:12px;border-bottom:1px solid #e7e8eb;color:#6b7280">Amount</td><td style="padding:12px;border-bottom:1px solid #e7e8eb;font-weight:700">{{ submission.currency }} {{ submission.amount }}</td></tr>
        <tr><td style="padding:12px;border-bottom:1px solid #e7e8eb;color:#6b7280">Reference</td><td style="padding:12px;border-bottom:1px solid #e7e8eb;font-weight:700">{{ submission.reference }}</td></tr>
        <tr><td style="padding:12px;color:#6b7280">Status</td><td style="padding:12px;font-weight:700;color:#e31c64">Pending review</td></tr>
      </table>
      {% if recipient_type == 'admin' %}
        <p><strong>Customer:</strong> {{ customer.first_name }} {{ customer.last_name }} ({{ customer.email }})</p>
        <p style="color:#6b7280;line-height:1.6">Sign in to the Quizontal Cloud administrator area and open <strong>Invoices → Bank Transfer Receipts</strong> to review submission #{{ submission.id }}.</p>
      {% else %}
        <a href="{{ wallet_url }}" style="display:inline-block;padding:12px 18px;background:#e31c64;color:#fff;text-decoration:none;border-radius:8px;font-weight:700">View wallet status</a>
      {% endif %}
      <p style="margin:26px 0 0;color:#8a8f98;font-size:13px;line-height:1.5">This is an automated notification from Quizontal Cloud. A receipt alone does not confirm payment.</p>
    </div>
  </div>
</div>
{% endblock %}
