{% block subject %}{% if recipient_type == 'admin' %}New payment slip uploaded - #{{ submission.id }}{% else %}We received your payment receipt - #{{ submission.id }}{% endif %}{% endblock %}
{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f8;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e5e7eb;">
<tr><td style="padding:20px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;color:#111827;">QUIZONTAL CLOUD</td></tr>
<tr><td style="padding:0 24px 24px 24px;font-family:Arial,Helvetica,sans-serif;">
{% if recipient_type == 'admin' %}
<h1 style="margin:0 0 8px;font-size:18px;line-height:26px;color:#111827;font-weight:600;">New payment slip uploaded</h1>
<p style="margin:0 0 16px;font-size:14px;line-height:22px;color:#374151;">A customer uploaded a payment slip for invoice {{ submission.serie_nr }}. Please verify against bank account before approval.</p>
<p style="margin:0;font-size:13px;line-height:20px;color:#374151;">Customer: {{ customer.first_name }} {{ customer.last_name }} ({{ customer.email }})<br>Submission: #{{ submission.id }} | Invoice: {{ submission.serie_nr }} | Amount: {{ submission.currency }} {{ submission.amount }} | Ref: {{ submission.reference }} | Status: Pending review</p>
<p style="margin:16px 0 0;font-size:13px;line-height:20px;color:#6b7280;">Login to admin area and open Invoices → Bank Transfer Receipts to review.</p>
{% else %}
<h1 style="margin:0 0 8px;font-size:18px;line-height:26px;color:#111827;font-weight:600;">Receipt submitted</h1>
<p style="margin:0 0 16px;font-size:14px;line-height:22px;color:#374151;">Hello {{ customer.first_name }}, we received your bank transfer receipt for invoice {{ submission.serie_nr }}.</p>
<p style="margin:0;font-size:13px;line-height:20px;color:#374151;">Submission #{{ submission.id }}<br>Invoice: {{ submission.serie_nr }}<br>Amount: {{ submission.currency }} {{ submission.amount }}<br>Reference: {{ submission.reference }}<br>Status: Pending review</p>
<p style="margin:12px 0 0;font-size:13px;line-height:20px;color:#374151;">{% if invoice_kind|default('deposit') == 'service' %}Your service will be activated after bank confirmation.{% else %}Your wallet will be credited after bank confirmation.{% endif %}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:20px 0 0;">
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="background:#111827;border-radius:4px;"><a href="{{ wallet_url }}" style="display:inline-block;padding:11px 20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:600;color:#ffffff;text-decoration:none;">{% if invoice_kind|default('deposit') == 'service' %}Track order{% else %}View wallet{% endif %}</a></td></tr></table>
</td></tr></table>
{% endif %}
<p style="margin:16px 0 0;font-size:11px;line-height:16px;color:#9ca3af;">This is an automated notification. A receipt alone does not confirm payment.</p>
</td></tr>
<tr><td style="padding:14px 24px;border-top:1px solid #f3f4f6;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;color:#9ca3af;">Quizontal Cloud · billing.quizontal.site</td></tr>
</table>
</td></tr>
</table>
{% endblock %}
