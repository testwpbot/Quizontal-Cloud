{% extends "layout_default.html.twig" %}
{% set active_menu = 'invoice' %}
{% set item = admin.quizontalbanktransfer_get({id: submission_id}) %}
{% block meta_title %}Review bank transfer #{{ item.id }}{% endblock %}
{% block content %}
<div class="row g-4">
 <div class="col-lg-7"><div class="card"><div class="card-header"><h2 class="card-title">Receipt #{{ item.id }}</h2></div><div class="card-body"><iframe title="Payment receipt" src="{{ ('quizontalbanktransfer/receipt/' ~ item.id)|alink }}" style="width:100%;height:650px;border:0"></iframe></div></div></div>
 <div class="col-lg-5"><div class="card"><div class="card-header"><h2 class="card-title">Transfer details</h2></div><div class="card-body"><dl class="row"><dt class="col-5">Customer</dt><dd class="col-7">{{ item.client_name }}<br>{{ item.client_email }}</dd><dt class="col-5">Invoice</dt><dd class="col-7">{{ item.serie_nr }}</dd><dt class="col-5">Purpose</dt><dd class="col-7">{% if item.invoice_kind == 'service' %}<span class="badge bg-azure">Order payment</span><div class="small text-muted mt-1">Pays this order invoice directly — nothing is added to the wallet.</div>{% else %}<span class="badge bg-purple">Wallet top-up</span>{% endif %}</dd><dt class="col-5">Amount</dt><dd class="col-7"><strong>{{ item.amount|money(item.currency) }}</strong></dd><dt class="col-5">Reference</dt><dd class="col-7">{{ item.reference }}</dd><dt class="col-5">Status</dt><dd class="col-7">{{ item.status }}</dd></dl></div></div>
 {% if item.status == 'pending' %}
 <div class="card mt-3"><div class="card-header"><h3 class="card-title">Approve</h3></div><form method="post" action="{{ 'api/admin/quizontalbanktransfer/approve'|link }}" class="api-form" data-api-redirect="{{ 'quizontalbanktransfer'|alink }}"><div class="card-body"><input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"><input type="hidden" name="id" value="{{ item.id }}">{% if item.invoice_kind == 'service' %}<div class="alert alert-info">Approving marks invoice <strong>{{ item.serie_nr }}</strong> as paid and <strong>activates the linked service automatically</strong>. Verify the transfer reached the bank account first.</div>{% endif %}<div class="mb-3"><label class="form-label">Verified bank transaction ID</label><input class="form-control" name="transaction_id" required></div><div><label class="form-label">Admin note</label><textarea class="form-control" name="note"></textarea></div></div><div class="card-footer"><button class="btn btn-success" type="submit">{% if item.invoice_kind == 'service' %}Approve — mark invoice paid &amp; activate service{% else %}Approve and credit wallet{% endif %}</button></div></form></div>
 <div class="card mt-3"><div class="card-header"><h3 class="card-title">Reject</h3></div><form method="post" action="{{ 'api/admin/quizontalbanktransfer/reject'|link }}" class="api-form" data-api-redirect="{{ 'quizontalbanktransfer'|alink }}"><div class="card-body"><input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"><input type="hidden" name="id" value="{{ item.id }}"><label class="form-label">Reason</label><textarea class="form-control" name="note" required></textarea></div><div class="card-footer"><button class="btn btn-danger" type="submit">Reject receipt</button></div></form></div>
 {% endif %}
 </div>
</div>
{% endblock %}
