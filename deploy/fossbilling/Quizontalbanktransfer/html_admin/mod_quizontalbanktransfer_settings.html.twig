{% extends "layout_default.html.twig" %}
{% set active_menu = 'system' %}
{% set params = admin.extension_config_get({ext: 'mod_quizontalbanktransfer'}) %}
{% block meta_title %}Quizontal Cloud Bank Transfer Settings{% endblock %}
{% block content %}
<div class="card"><div class="card-header"><h2 class="card-title">Quizontal Cloud Bank Transfer</h2></div>
<form method="post" action="{{ 'api/admin/extension/config_save'|link }}" class="api-form" data-api-msg="{{ 'Configuration updated'|trans }}"><input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"><input type="hidden" name="ext" value="mod_quizontalbanktransfer"><div class="card-body"><div class="row g-3">
<div class="col-md-6"><label class="form-label">Bank name</label><input class="form-control" name="bank_name" value="{{ params.bank_name }}" required></div>
<div class="col-md-6"><label class="form-label">Account name</label><input class="form-control" name="account_name" value="{{ params.account_name|default('Quizontal Cloud') }}" required></div>
<div class="col-md-6"><label class="form-label">Account number</label><input class="form-control" name="account_number" value="{{ params.account_number }}" required></div>
<div class="col-md-6"><label class="form-label">Branch</label><input class="form-control" name="branch" value="{{ params.branch }}"></div>
<div class="col-md-6"><label class="form-label">SWIFT code</label><input class="form-control" name="swift_code" value="{{ params.swift_code }}"></div>
<div class="col-md-6"><label class="form-label">Maximum receipt size (MB)</label><input class="form-control" type="number" min="1" max="20" name="max_file_mb" value="{{ params.max_file_mb|default(5) }}"></div>
<div class="col-12"><label class="form-label">Administrator notification email</label><input class="form-control" type="email" name="admin_notification_email" value="{{ params.admin_notification_email }}" required><small class="form-hint">Synchronized from <code>QUIZONTAL_ADMIN_EMAIL</code> in Laravel .env by the activation helper.</small></div>
<div class="col-12"><label class="form-label">Additional instructions</label><textarea class="form-control" name="instructions">{{ params.instructions }}</textarea></div>
<div class="col-12"><label class="form-check"><input type="hidden" name="wallet_only_checkout" value="0"><input class="form-check-input" type="checkbox" name="wallet_only_checkout" value="1" {% if params.wallet_only_checkout|default(false) %}checked{% endif %}><span class="form-check-label">Require full wallet balance before checkout</span><div class="form-hint">Legacy wallet-only mode. Keep this OFF so customers can place orders and pay the exact order invoice by bank transfer.</div></label></div>
</div></div><div class="card-footer"><button class="btn btn-primary" type="submit">Save settings</button></div></form></div>
{% endblock %}
