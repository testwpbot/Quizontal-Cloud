{% block subject %}{{ order.title }} is now active | Quizontal Cloud{% endblock %}
{% block content %}
<div style="margin:0;padding:28px;background:#f5f6f8;font-family:Arial,sans-serif;color:#20242b"><div style="max-width:640px;margin:0 auto;background:#fff;border:1px solid #e4e6ea;border-radius:14px;overflow:hidden"><div style="height:5px;background:#e31c64"></div><div style="padding:30px"><div style="font-size:22px;font-weight:700">Quizontal <span style="color:#e31c64">Cloud</span></div><h1 style="font-size:25px;margin:26px 0 8px">Your service is active</h1><p style="color:#6b7280;line-height:1.65">Hello {{ c.first_name }}, your <strong>{{ order.title }}</strong> is now active and ready to use.</p><table style="width:100%;border-collapse:collapse;margin:24px 0;background:#fafafa;border-radius:10px"><tr><td style="padding:12px;color:#6b7280">Service</td><td style="padding:12px;text-align:right;font-weight:700">{{ order.title }}</td></tr>{% if order.expires_at %}<tr><td style="padding:12px;color:#6b7280">Expires</td><td style="padding:12px;text-align:right;font-weight:700">{{ order.expires_at|format_date }}</td></tr>{% endif %}</table><a href="{{ 'order/service/manage'|link }}/{{ order.id }}" style="display:inline-block;padding:12px 20px;background:#e31c64;color:#fff;text-decoration:none;border-radius:8px;font-weight:700">Manage my service</a><p style="margin:28px 0 0;color:#8a8f98;font-size:13px">This is an automated service notification from Quizontal Cloud.</p></div></div></div>
{% endblock %}
