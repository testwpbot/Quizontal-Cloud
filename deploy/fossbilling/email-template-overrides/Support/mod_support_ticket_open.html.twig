{% block subject %}Ticket #{{ ticket.id }} received: {{ ticket.subject }}{% endblock %}
{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f8;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e5e7eb;">
<tr><td style="padding:20px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;color:#111827;">QUIZONTAL CLOUD</td></tr>
<tr><td style="padding:0 24px 24px 24px;font-family:Arial,Helvetica,sans-serif;">
<h1 style="margin:0 0 8px;font-size:18px;line-height:26px;color:#111827;font-weight:600;">Support ticket received</h1>
<p style="margin:0 0 16px;font-size:14px;line-height:22px;color:#374151;">Hello {{ c.first_name }}, your ticket has been created. We will reply soon.</p>
<p style="margin:0 0 4px;font-size:13px;line-height:20px;color:#111827;"><strong>#{{ ticket.id }} — {{ ticket.subject }}</strong></p>
<p style="margin:0;font-size:13px;line-height:20px;color:#6b7280;">Status: {{ ticket.status|title }}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:20px 0 0;">
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="background:#ffffff;border:1px solid #111827;border-radius:4px;"><a href="{{ 'support/ticket'|link }}/{{ ticket.id }}" style="display:inline-block;padding:10px 18px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:600;color:#111827;text-decoration:none;">View ticket</a></td></tr></table>
</td></tr></table>
<p style="margin:16px 0 0;font-size:12px;line-height:18px;color:#9ca3af;">Please reply from the client area for proper tracking, not by replying to this email.</p>
</td></tr>
<tr><td style="padding:14px 24px;border-top:1px solid #f3f4f6;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;color:#9ca3af;">Quizontal Cloud · Support notification.</td></tr>
</table>
</td></tr>
</table>
{% endblock %}
