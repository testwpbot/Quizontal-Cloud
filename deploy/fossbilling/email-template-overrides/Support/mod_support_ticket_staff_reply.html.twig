{% block subject %}New reply: {{ ticket.subject }}{% endblock %}
{% block content %}
<div style="margin:0;padding:28px;background:#f5f6f8;font-family:Arial,sans-serif;color:#20242b"><div style="max-width:640px;margin:auto;background:#fff;border:1px solid #e4e6ea;border-radius:14px;overflow:hidden"><div style="height:5px;background:#e31c64"></div><div style="padding:30px"><div style="font-size:22px;font-weight:700">Quizontal <span style="color:#e31c64">Cloud</span></div><h1 style="font-size:25px;margin:26px 0 8px">Your support ticket has a new reply</h1><p style="color:#6b7280;line-height:1.65">Hello {{ c.first_name }}, a team member replied to your support request.</p><div style="padding:18px;margin:24px 0;background:#fafafa;border:1px solid #eceef1;border-radius:10px"><strong>#{{ ticket.id }} · {{ ticket.subject }}</strong><div style="color:#6b7280;margin-top:7px">Status: {{ ticket.status|title }}</div></div><a href="{{ 'support/ticket'|link }}/{{ ticket.id }}" style="display:inline-block;padding:12px 20px;background:#e31c64;color:#fff;text-decoration:none;border-radius:8px;font-weight:700">Read and reply</a><p style="margin-top:28px;color:#8a8f98;font-size:13px">For security and proper tracking, respond from the Quizontal Cloud client area.</p></div></div></div>
{% endblock %}
