{% block subject %}Payment confirmed for {{ invoice.serie_nr }}{% endblock %}
{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f8;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e5e7eb;">
<tr><td style="padding:20px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;color:#111827;">QUIZONTAL CLOUD</td></tr>
<tr><td style="padding:0 24px 24px 24px;font-family:Arial,Helvetica,sans-serif;">
<h1 style="margin:0 0 12px;font-size:18px;line-height:26px;color:#111827;font-weight:600;">Payment confirmed</h1>
<p style="margin:0 0 16px;font-size:14px;line-height:22px;color:#374151;">Hello {{ c.first_name }}, thank you. Your payment for invoice {{ invoice.serie_nr }} has been received.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:12px 0;border:1px solid #e5e7eb;">
<tr><td style="padding:10px 12px;font-size:13px;color:#6b7280;">Invoice</td><td style="padding:10px 12px;font-size:13px;font-weight:600;text-align:right;">{{ invoice.serie_nr }}</td></tr>
<tr><td style="padding:10px 12px;font-size:13px;color:#6b7280;border-top:1px solid #f3f4f6;">Amount</td><td style="padding:10px 12px;font-size:13px;font-weight:700;text-align:right;border-top:1px solid #f3f4f6;">{{ invoice.total|money(invoice.currency) }}</td></tr>
<tr><td style="padding:10px 12px;font-size:13px;color:#6b7280;border-top:1px solid #f3f4f6;">Paid on</td><td style="padding:10px 12px;font-size:13px;text-align:right;border-top:1px solid #f3f4f6;">{{ invoice.paid_at|format_date }}</td></tr>
</table>
<p style="margin:12px 0 0;font-size:13px;line-height:20px;color:#374151;">If this invoice was for a service, activation is automatic. Servers are usually ready within 30 minutes. Wallet top-ups are available immediately.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:16px 0 0;">
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="background:#ffffff;border:1px solid #111827;border-radius:4px;"><a href="{{ 'invoice'|link }}/{{ invoice.hash }}" style="display:inline-block;padding:10px 18px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:600;color:#111827;text-decoration:none;">View receipt</a></td></tr></table>
</td></tr></table>
</td></tr>
<tr><td style="padding:14px 24px;border-top:1px solid #f3f4f6;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;color:#9ca3af;">Quizontal Cloud · Automated transaction notice.</td></tr>
</table>
</td></tr>
</table>
{% endblock %}
