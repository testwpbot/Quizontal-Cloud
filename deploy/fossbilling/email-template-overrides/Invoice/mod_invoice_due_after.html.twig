{% block subject %}Invoice {{ invoice.serie_nr }} is overdue{% endblock %}
{% block content %}
<div style="margin:0;padding:28px;background:#f5f6f8;font-family:Arial,sans-serif;color:#20242b"><div style="max-width:640px;margin:auto;background:#fff;border:1px solid #e4e6ea;border-radius:14px;overflow:hidden"><div style="height:5px;background:#e31c64"></div><div style="padding:30px"><div style="font-size:22px;font-weight:700">Quizontal <span style="color:#e31c64">Cloud</span></div><h1 style="font-size:25px;margin:26px 0 8px">Invoice overdue</h1><p style="color:#6b7280;line-height:1.65">Hello {{ c.first_name }}, invoice {{ invoice.serie_nr }} is now {{ days_passed }} days overdue. Please review it to avoid service interruption.</p><div style="padding:18px;margin:24px 0;background:#fafafa;border:1px solid #eceef1;border-radius:10px"><div style="font-size:22px;font-weight:700">{{ invoice.total|money(invoice.currency) }}</div><div style="color:#6b7280;margin-top:5px">Originally due {{ invoice.due_at|format_date }}</div></div><a href="{{ 'invoice'|link }}/{{ invoice.hash }}" style="display:inline-block;padding:12px 20px;background:#e31c64;color:#fff;text-decoration:none;border-radius:8px;font-weight:700">View invoice</a></div></div></div>
{% endblock %}
