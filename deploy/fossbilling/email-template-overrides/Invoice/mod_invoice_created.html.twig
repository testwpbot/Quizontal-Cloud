{% block subject %}Invoice {{ invoice.serie_nr }} is ready{% endblock %}
{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f8;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e5e7eb;">
<tr><td style="padding:20px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;color:#111827;">QUIZONTAL CLOUD</td></tr>
<tr><td style="padding:0 24px 24px 24px;font-family:Arial,Helvetica,sans-serif;">
<h1 style="margin:0 0 12px;font-size:18px;line-height:26px;color:#111827;font-weight:600;">Your invoice is ready</h1>
<p style="margin:0 0 16px;font-size:14px;line-height:22px;color:#374151;">Hello {{ c.first_name }}, a new invoice has been generated for your account.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0;border:1px solid #e5e7eb;border-collapse:collapse;">
<tr><td style="padding:10px 12px;font-size:13px;color:#6b7280;width:50%;border-bottom:1px solid #f3f4f6;">Invoice</td><td style="padding:10px 12px;font-size:13px;color:#111827;font-weight:600;text-align:right;border-bottom:1px solid #f3f4f6;">{{ invoice.serie_nr }}</td></tr>
<tr><td style="padding:10px 12px;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;">Amount due</td><td style="padding:10px 12px;font-size:14px;color:#111827;font-weight:700;text-align:right;border-bottom:1px solid #f3f4f6;">{{ invoice.total|money(invoice.currency) }}</td></tr>
<tr><td style="padding:10px 12px;font-size:13px;color:#6b7280;">Due date</td><td style="padding:10px 12px;font-size:13px;color:#111827;text-align:right;">{{ invoice.due_at|format_date }}</td></tr>
</table>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:12px 0 4px;">
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="background:#111827;border-radius:4px;"><a href="{{ 'invoice'|link }}/{{ invoice.hash }}" style="display:inline-block;padding:11px 20px;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;">View invoice</a></td></tr></table>
</td></tr></table>
<p style="margin:16px 0 0;font-size:12px;line-height:18px;color:#6b7280;">The official PDF is attached. You can pay via bank transfer from the invoice page. Wallet payments are instant.</p>
</td></tr>
<tr><td style="padding:14px 24px;border-top:1px solid #f3f4f6;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;color:#9ca3af;">Quizontal Cloud · This is a billing notification. Do not reply directly - use the client area for support.</td></tr>
</table>
</td></tr>
</table>
{% endblock %}
