{% block subject %}Invoice {{ invoice.serie_nr }} is ready | Quizontal Cloud{% endblock %}
{% block content %}
<div style="margin:0;padding:28px;background:#f5f6f8;font-family:Arial,sans-serif;color:#20242b"><div style="max-width:640px;margin:auto;background:#fff;border:1px solid #e4e6ea;border-radius:14px;overflow:hidden"><div style="height:5px;background:#e31c64"></div><div style="padding:30px"><div style="font-size:22px;font-weight:700">Quizontal <span style="color:#e31c64">Cloud</span></div><h1 style="font-size:25px;margin:26px 0 8px">Your invoice is ready</h1><p style="color:#6b7280;line-height:1.65">Hello {{ c.first_name }}, a new invoice has been generated for your account.</p><div style="margin:24px 0;padding:18px;background:#fafafa;border:1px solid #eceef1;border-radius:10px"><table style="width:100%;border-collapse:collapse"><tr><td style="padding:8px;color:#6b7280">Invoice</td><td style="padding:8px;text-align:right;font-weight:700">{{ invoice.serie_nr }}</td></tr><tr><td style="padding:8px;color:#6b7280">Amount due</td><td style="padding:8px;text-align:right;font-size:20px;font-weight:700">{{ invoice.total|money(invoice.currency) }}</td></tr><tr><td style="padding:8px;color:#6b7280">Due date</td><td style="padding:8px;text-align:right;font-weight:700">{{ invoice.due_at|format_date }}</td></tr></table></div><a href="{{ 'invoice'|link }}/{{ invoice.hash }}" style="display:inline-block;padding:12px 20px;background:#e31c64;color:#fff;text-decoration:none;border-radius:8px;font-weight:700">View invoice</a><span style="display:inline-block;width:8px"></span><a href="{{ 'invoice/pdf'|link }}/{{ invoice.hash }}" style="display:inline-block;padding:11px 18px;background:#fff;color:#20242b;text-decoration:none;border:1px solid #d9dce1;border-radius:8px;font-weight:700">Download official PDF</a><p style="margin:28px 0 0;color:#8a8f98;font-size:13px;line-height:1.6">This email uses the invoice generated by the FossBilling billing system. Sign in directly to your account if you have questions.</p></div></div></div>
{% endblock %}
