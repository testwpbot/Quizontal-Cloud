{% block subject %}Welcome to Quizontal Cloud{% endblock %}
{% block content %}
<div style="margin:0;padding:28px;background:#f5f6f8;font-family:Arial,sans-serif;color:#20242b"><div style="max-width:640px;margin:auto;background:#fff;border:1px solid #e4e6ea;border-radius:14px;overflow:hidden"><div style="height:5px;background:#e31c64"></div><div style="padding:30px"><div style="font-size:22px;font-weight:700">Quizontal <span style="color:#e31c64">Cloud</span></div><h1 style="font-size:25px;margin:26px 0 8px">Welcome to Quizontal Cloud</h1><p style="color:#6b7280;line-height:1.65">Hello {{ c.first_name }}, your account is ready. You can now fund your wallet, order cloud services, review invoices, and contact support from one secure dashboard.</p><a href="{{ 'login'|link }}" style="display:inline-block;margin-top:16px;padding:12px 20px;background:#e31c64;color:#fff;text-decoration:none;border-radius:8px;font-weight:700">Sign in to your account</a><p style="margin-top:28px;color:#8a8f98;font-size:13px">If you did not create this account, please contact Quizontal Cloud support.</p></div></div></div>
{% endblock %}
