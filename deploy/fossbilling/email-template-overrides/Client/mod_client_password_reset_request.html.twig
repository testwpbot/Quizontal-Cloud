{% block subject %}Reset your password{% endblock %}
{% block content %}
<div style="margin:0;padding:28px;background:#f5f6f8;font-family:Arial,sans-serif;color:#20242b"><div style="max-width:640px;margin:auto;background:#fff;border:1px solid #e4e6ea;border-radius:14px;overflow:hidden"><div style="height:5px;background:#e31c64"></div><div style="padding:30px"><div style="font-size:22px;font-weight:700">Quizontal <span style="color:#e31c64">Cloud</span></div><h1 style="font-size:25px;margin:26px 0 8px">Reset your password</h1><p style="color:#6b7280;line-height:1.65">Hello {{ c.first_name }}, we received a request to reset your password. This secure link expires in two hours.</p><a href="{{ 'client/reset-password-confirm'|link }}/{{ hash }}" style="display:inline-block;margin-top:16px;padding:12px 20px;background:#e31c64;color:#fff;text-decoration:none;border-radius:8px;font-weight:700">Choose a new password</a><p style="margin-top:28px;color:#8a8f98;font-size:13px;line-height:1.6">If you did not request this, no action is needed. Your existing password remains unchanged.</p></div></div></div>
{% endblock %}
