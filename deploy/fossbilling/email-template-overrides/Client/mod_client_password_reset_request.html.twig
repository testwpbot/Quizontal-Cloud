{% block subject %}Reset your password{% endblock %}
{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f8;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e5e7eb;">
<tr><td style="padding:20px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;color:#111827;letter-spacing:0.3px;">QUIZONTAL CLOUD</td></tr>
<tr><td style="padding:0 24px 24px 24px;font-family:Arial,Helvetica,sans-serif;">
<h1 style="margin:0 0 12px;font-size:20px;line-height:28px;color:#111827;font-weight:600;">Reset your password</h1>
<p style="margin:0 0 16px;font-size:14px;line-height:22px;color:#374151;">Hello {{ c.first_name }}, we received a request to reset your password. This link expires in 15 minutes.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:20px 0 8px;">
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="background:#111827;border-radius:4px;"><a href="{{ 'client/reset-password-confirm'|link }}/{{ hash }}" style="display:inline-block;padding:12px 22px;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;">Choose a new password</a></td></tr></table>
</td></tr></table>
<p style="margin:20px 0 0;font-size:13px;line-height:20px;color:#6b7280;">If you did not request this, you can ignore this email. Your current password will not change.</p>
<p style="margin:16px 0 0;font-size:12px;line-height:18px;color:#9ca3af;">If the button does not work, copy and paste this link:<br><a href="{{ 'client/reset-password-confirm'|link }}/{{ hash }}" style="color:#374151;word-break:break-all;">{{ 'client/reset-password-confirm'|link }}/{{ hash }}</a></p>
</td></tr>
<tr><td style="padding:14px 24px;border-top:1px solid #f3f4f6;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;color:#9ca3af;">Quizontal Cloud · quizontal.site · billing.quizontal.site · This is an automated message, please do not reply directly.</td></tr>
</table>
</td></tr>
</table>
{% endblock %}
