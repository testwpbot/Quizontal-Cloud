<div class="card"><div class="card-header"><div><h3 class="card-title">InterServer validation</h3><p class="card-subtitle">Order #{{ order.id }} · validation-only provisioning</p></div></div><div class="card-body">
<table class="table table-bordered"><tbody><tr><th>Status</th><td>{{ service.status }}</td></tr><tr><th>Hostname</th><td>{{ service.hostname }}</td></tr><tr><th>Platform</th><td>{{ service.platform }} / {{ service.slices }} units</td></tr><tr><th>Location</th><td>{{ service.location_name }}</td></tr><tr><th>OS</th><td>{{ service.os_distro }} / {{ service.os_version }}</td></tr><tr><th>Expected cost</th><td>USD {{ service.expected_cost_usd }}</td></tr><tr><th>Validated provider cost</th><td>USD {{ service.provider_cost_usd|default('—') }}</td></tr><tr><th>Provider VPS ID</th><td>{{ service.provider_vps_id|default('Not created') }}</td></tr></tbody></table>
{% if service.last_error %}<div class="alert alert-danger">{{ service.last_error }}</div>{% endif %}
<div class="alert alert-warning">Retry performs another PUT validation request only. It cannot purchase a VPS.</div>
<a class="btn btn-primary api-link" href="{{ 'api/admin/serviceinterserver/retry_validation'|link({order_id:order.id,CSRFToken:CSRFToken}) }}" data-api-reload="1">Retry validation</a>
</div></div>
