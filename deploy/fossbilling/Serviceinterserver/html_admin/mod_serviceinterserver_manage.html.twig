<div class="card"><div class="card-header"><div><h3 class="card-title">Cloud provisioning</h3><p class="card-subtitle">Order #{{ order.id }}</p></div><span class="badge bg-secondary">{{ service.status }}</span></div><div class="card-body">
<table class="table table-bordered"><tbody><tr><th>Hostname</th><td>{{ service.hostname }}</td></tr><tr><th>Platform</th><td>{{ service.platform }} / {{ service.slices }} units</td></tr><tr><th>Location</th><td>{{ service.location_name }}</td></tr><tr><th>Operating system</th><td>{{ service.os_distro }} / {{ service.os_version }}</td></tr><tr><th>Expected cost</th><td>USD {{ service.expected_cost_usd }}</td></tr><tr><th>Validated cost</th><td>USD {{ service.provider_cost_usd|default('—') }}</td></tr><tr><th>Cloud service ID</th><td>{{ service.cloud_service_id|default('Not created') }}</td></tr><tr><th>Primary IP</th><td>{{ service.primary_ip|default('—') }}</td></tr></tbody></table>
{% if service.last_error %}<div class="alert alert-danger">{{ service.last_error }}</div>{% endif %}
<div class="d-flex flex-wrap gap-2"><a class="btn btn-primary api-link" href="{{ 'api/admin/serviceinterserver/retry_validation'|link({order_id:order.id,CSRFToken:CSRFToken}) }}" data-api-reload="1">{% if service.status in ['submitting','manual_review'] %}Reconcile existing cloud server{% else %}Retry validation / provisioning{% endif %}</a>{% if order.status in ['pending_setup','failed_setup'] %}<a class="btn btn-secondary api-link" href="{{ 'api/admin/serviceinterserver/activate_paid_order'|link({order_id:order.id,CSRFToken:CSRFToken}) }}" data-api-confirm="Process this paid cloud order now?" data-api-reload="1">Process paid order</a>{% endif %}</div>
</div></div>
