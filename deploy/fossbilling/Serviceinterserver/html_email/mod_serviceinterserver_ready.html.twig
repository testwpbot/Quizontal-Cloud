{% block subject %}Your server {{ order.title }} is ready{% endblock %}
{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f8;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e5e7eb;">
<tr><td style="padding:20px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;color:#111827;">QUIZONTAL CLOUD</td></tr>
<tr><td style="padding:0 24px 24px 24px;font-family:Arial,Helvetica,sans-serif;">
<h1 style="margin:0 0 8px;font-size:18px;line-height:26px;color:#111827;font-weight:600;">Your server is live</h1>
<p style="margin:0 0 16px;font-size:14px;line-height:22px;color:#374151;">Hello {{ c.first_name }}, {{ order.title }} has finished provisioning and is ready.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:12px 0;border:1px solid #e5e7eb;">
{% if service.hostname %}<tr><td style="padding:8px 12px;font-size:13px;color:#6b7280;">Hostname</td><td style="padding:8px 12px;font-size:13px;text-align:right;">{{ service.hostname }}</td></tr>{% endif %}
{% if service.primary_ip %}<tr><td style="padding:8px 12px;font-size:13px;color:#6b7280;border-top:1px solid #f3f4f6;">IP</td><td style="padding:8px 12px;font-size:13px;text-align:right;border-top:1px solid #f3f4f6;">{{ service.primary_ip }}</td></tr>{% endif %}
{% if service.location_name %}<tr><td style="padding:8px 12px;font-size:13px;color:#6b7280;border-top:1px solid #f3f4f6;">Location</td><td style="padding:8px 12px;font-size:13px;text-align:right;border-top:1px solid #f3f4f6;">{{ service.location_name }}</td></tr>{% endif %}
</table>
<p style="margin:0;font-size:13px;line-height:20px;color:#374151;">Open dashboard to view one-time password and manage server.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:16px 0 0;">
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="background:#111827;border-radius:4px;"><a href="{{ 'order/service/manage'|link }}/{{ order.id }}" style="display:inline-block;padding:11px 20px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:600;color:#ffffff;text-decoration:none;">Open dashboard</a></td></tr></table>
</td></tr></table>
</td></tr>
<tr><td style="padding:14px 24px;border-top:1px solid #f3f4f6;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;color:#9ca3af;">Quizontal Cloud · Service notification</td></tr>
</table>
</td></tr>
</table>
{% endblock %}
