<style>
.qc-service{--qc:#e31c64;--qc-soft:#fff1f6;--qc-text:#20242b;--qc-muted:#6b7280;position:relative}.qc-service .qc-status{background:var(--qc-soft);color:#b51550;border:1px solid rgba(227,28,100,.25)}.qc-service .qc-card{border:1px solid #e1e4e8;border-radius:12px;padding:16px;background:#fff;height:100%}.qc-service .qc-icon{width:42px;height:42px;border-radius:10px;background:var(--qc-soft);display:grid;place-items:center}.qc-service .qc-value{color:var(--qc-text);font-weight:700}.qc-service .qc-muted{color:var(--qc-muted)}.qc-service .qc-progress{height:8px;background:#eceff2;border-radius:99px;overflow:hidden}.qc-service .qc-progress span{display:block;height:100%;background:var(--qc);border-radius:99px}.qc-service .btn-primary{background:var(--qc);border-color:var(--qc)}.qc-service.qc-loading>.card-body>*{opacity:.16}.qc-shimmer{display:none;position:absolute;inset:72px 16px 16px;z-index:3;background:linear-gradient(90deg,#f2f3f5 25%,#fff 50%,#f2f3f5 75%);background-size:200% 100%;animation:qc-shimmer 1.2s infinite;border-radius:12px}.qc-loading .qc-shimmer{display:block}@keyframes qc-shimmer{to{background-position:-200% 0}}
</style>
<div class="card mb-4 qc-service" id="qc-service-panel"><div class="card-header"><div><h2 class="card-title">{{ order.title }}</h2><p class="card-subtitle">Quizontal Cloud VPS</p></div><span class="badge qc-status fs-6">{{ service.status|replace({'_':' '})|title }}</span></div><div class="qc-shimmer"></div><div class="card-body">
{% if service.status == 'validated' and not service.cloud_service_id %}<div class="alert mb-4" style="background:#fff1f6;border:1px solid rgba(227,28,100,.25);color:#84103d"><strong>Test completed.</strong> Configuration and pricing were validated. No server was purchased in test mode.</div>{% endif %}
{% if service.cloud_service_id %}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4"><div><div class="qc-muted small">Power status</div><strong class="qc-value fs-5">{{ service.power_status|default('Synchronizing')|title }}</strong></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-secondary qc-action api-link" href="{{ 'api/client/serviceinterserver/sync'|link({order_id:order.id,CSRFToken:CSRFToken}) }}" data-api-reload="1">Refresh</a><a class="btn btn-outline-secondary qc-action api-link" href="{{ 'api/client/serviceinterserver/start'|link({order_id:order.id,CSRFToken:CSRFToken}) }}" data-api-reload="1">Start</a><a class="btn btn-outline-secondary qc-action api-link" href="{{ 'api/client/serviceinterserver/restart'|link({order_id:order.id,CSRFToken:CSRFToken}) }}" data-api-reload="1">Restart</a><a class="btn btn-outline-danger qc-action api-link" href="{{ 'api/client/serviceinterserver/stop'|link({order_id:order.id,CSRFToken:CSRFToken}) }}" data-api-confirm="Stop this server?" data-api-reload="1">Stop</a></div></div>
{% endif %}
<div class="row g-3 mb-3">
<div class="col-md-6"><div class="qc-card"><div class="qc-muted small mb-1">Hostname</div><div class="qc-value">{{ service.hostname }}</div></div></div>
<div class="col-md-6"><div class="qc-card"><div class="qc-muted small mb-1">Primary IP address</div><div class="qc-value">{{ service.primary_ip|default('Available after provisioning') }}</div></div></div>
<div class="col-md-6"><div class="qc-card"><div class="qc-muted small mb-1">Location</div><div class="d-flex align-items-center gap-2"><img src="{{ 'us-flag.svg'|mod_asset_url('serviceinterserver') }}" width="30" alt="US flag"><span class="qc-value">{{ service.location_name }}</span></div></div></div>
<div class="col-md-6"><div class="qc-card"><div class="qc-muted small mb-1">Operating system</div><div class="d-flex align-items-center gap-2"><img src="{{ ((service.os_distro == 'windows' ? 'windows' : service.os_distro) ~ '.svg')|mod_asset_url('serviceinterserver') }}" width="30" height="30" alt=""><span class="qc-value">{{ service.os_distro|title }} {{ service.os_version }}</span></div></div></div>
</div>
<h3 class="mt-4 mb-3">Allocated resources</h3><div class="row g-3 mb-3">
<div class="col-6 col-lg-3"><div class="qc-card"><div class="qc-muted small">CPU</div><div class="qc-value fs-4">{{ service.cpu_cores }}</div><div class="qc-muted small">vCPU</div></div></div>
<div class="col-6 col-lg-3"><div class="qc-card"><div class="qc-muted small">Memory</div><div class="qc-value fs-4">{{ service.ram_gb }}</div><div class="qc-muted small">GB RAM</div></div></div>
<div class="col-6 col-lg-3"><div class="qc-card"><div class="qc-muted small">Storage</div><div class="qc-value fs-4">{{ service.storage_gb }}</div><div class="qc-muted small">GB {{ service.storage_type }}</div></div></div>
<div class="col-6 col-lg-3"><div class="qc-card"><div class="qc-muted small">Bandwidth</div><div class="qc-value fs-4">{{ service.bandwidth_total_gb >= 1000 ? (service.bandwidth_total_gb/1000) : service.bandwidth_total_gb }}</div><div class="qc-muted small">{{ service.bandwidth_total_gb >= 1000 ? 'TB' : 'GB' }} / month</div></div></div>
</div>
{% if service.cloud_service_id %}<div class="row g-3 mt-1"><div class="col-md-6"><div class="qc-card"><div class="d-flex justify-content-between mb-2"><span class="qc-muted">Bandwidth used</span><strong>{{ service.bandwidth_used_gb|default(0) }} GB</strong></div><div class="qc-progress"><span style="width:{{ service.bandwidth_percent }}%"></span></div></div></div><div class="col-md-6"><div class="qc-card"><div class="qc-muted small mb-2">Administrator password</div>{% if service.password_available %}<a class="btn btn-primary api-link" href="{{ 'api/client/serviceinterserver/reveal_password'|link({order_id:order.id,CSRFToken:CSRFToken}) }}" data-api-jsonp="onQcPassword">Reveal once</a><div class="small qc-muted mt-2">For security, this password is permanently removed after one reveal.</div>{% else %}<span class="qc-muted">Password already viewed. Contact support if you need an administrator password reset.</span>{% endif %}</div></div></div>{% endif %}
{% if service.last_error %}<div class="alert alert-danger mt-3 mb-0">{{ service.last_error }}</div>{% endif %}
</div></div>
<script>
function onQcPassword(password){var box=document.createElement('div');box.className='alert mt-3';box.style.cssText='background:#fff1f6;border:1px solid #e31c64;color:#20242b';box.innerHTML='<strong>One-time administrator password</strong><div class="d-flex gap-2 mt-2"><input class="form-control" readonly value="'+String(password).replace(/"/g,'&quot;')+'"><button class="btn btn-primary" type="button">Copy</button></div>';box.querySelector('button').onclick=function(){navigator.clipboard.writeText(password);this.textContent='Copied';};document.querySelector('#qc-service-panel .card-body').prepend(box);}
document.querySelectorAll('.qc-action').forEach(function(el){el.addEventListener('click',function(){var panel=document.getElementById('qc-service-panel');panel.classList.add('qc-loading');setTimeout(function(){panel.classList.remove('qc-loading');},20000);});});
</script>
