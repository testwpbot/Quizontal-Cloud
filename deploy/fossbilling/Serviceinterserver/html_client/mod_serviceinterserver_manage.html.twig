<div class="card mb-4"><div class="card-header"><div><h2 class="card-title">{{ order.title }}</h2><p class="card-subtitle">Quizontal Cloud VPS provisioning</p></div></div><div class="card-body">
{% set styles = {'pending_validation':'secondary','validating':'info','validated':'warning text-dark','validation_failed':'danger','price_review':'danger','provisioned':'success'} %}
<div class="d-flex align-items-center justify-content-between mb-4"><div><div class="text-muted small">Provisioning status</div><span class="badge bg-{{ styles[service.status]|default('secondary') }} fs-6">{{ service.status|replace({'_':' '})|title }}</span></div>{% if service.status == 'validated' and not service.provider_vps_id %}<div class="alert alert-warning mb-0 py-2">Configuration validated. No VPS has been purchased while validation-only mode is enabled.</div>{% endif %}</div>
<div class="row g-3">
<div class="col-md-6"><div class="border rounded p-3 h-100"><div class="text-muted small mb-1">Hostname</div><strong>{{ service.hostname }}</strong></div></div>
<div class="col-md-6"><div class="border rounded p-3 h-100"><div class="text-muted small mb-1">Location</div><div class="d-flex align-items-center gap-2"><img src="{{ 'us-flag.svg'|mod_asset_url('serviceinterserver') }}" width="30" alt="US flag"><strong>{{ service.location_name }}</strong></div></div></div>
<div class="col-md-6"><div class="border rounded p-3 h-100"><div class="text-muted small mb-1">Operating system</div><div class="d-flex align-items-center gap-2"><img src="{{ ((service.os_distro == 'windows' ? 'windows' : service.os_distro) ~ '.svg')|mod_asset_url('serviceinterserver') }}" width="30" height="30" alt=""><strong>{{ service.os_distro|title }} / {{ service.os_version }}</strong></div></div></div>
<div class="col-md-6"><div class="border rounded p-3 h-100"><div class="text-muted small mb-1">Resources</div><strong>{{ service.slices }} plan unit{{ service.slices == 1 ? '' : 's' }} · {{ service.platform|upper }}</strong></div></div>
</div>
{% if service.last_error %}<div class="alert alert-danger mt-3 mb-0">{{ service.last_error }}</div>{% endif %}
</div></div>
