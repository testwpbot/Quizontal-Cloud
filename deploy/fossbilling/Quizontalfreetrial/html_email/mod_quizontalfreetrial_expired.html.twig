{% block subject %}Your free trial has ended — {{ trial.domain }} is suspended{% endblock %}
{% block content %}
<div style="margin:0;padding:40px 24px;background:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1c1f26;-webkit-font-smoothing:antialiased">
  <div style="max-width:520px;margin:0 auto">

    <div style="font-size:15px;font-weight:700;letter-spacing:-0.2px;color:#1c1f26">Quizontal&nbsp;Cloud</div>

    <div style="font-size:23px;font-weight:700;line-height:1.35;letter-spacing:-0.4px;margin:34px 0 14px">Your trial has finished</div>

    <div style="font-size:15px;line-height:1.7;color:#5b6270;margin:0 0 30px">
      Hello {{ c.first_name }}, the free trial for {{ trial.domain }} has ended and the hosting account is now suspended.
      Your website is temporarily offline, but nothing has been deleted.
    </div>

    <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:14.5px;margin:0 0 30px">
      <tr>
        <td style="padding:9px 0;color:#8a909c;width:150px">Domain</td>
        <td style="padding:9px 0;color:#1c1f26;font-weight:600">{{ trial.domain }}</td>
      </tr>
      <tr>
        <td style="padding:9px 0;color:#8a909c">Status</td>
        <td style="padding:9px 0;color:#1c1f26;font-weight:600">Suspended</td>
      </tr>
      <tr>
        <td style="padding:9px 0;color:#8a909c">Data kept until</td>
        <td style="padding:9px 0;color:#1c1f26;font-weight:600">{{ trial.suspended_at|date_modify('+' ~ grace_days|default(7) ~ ' days')|date('j M Y') }}</td>
      </tr>
    </table>

    <a href="{{ upgrade_url }}" style="display:inline-block;padding:13px 26px;background:#1c1f26;color:#ffffff;text-decoration:none;border-radius:8px;font-size:14.5px;font-weight:600">Upgrade and restore my site</a>

    <div style="height:1px;background:#e9eaee;margin:34px 0 22px"></div>

    <div style="font-size:12.5px;line-height:1.7;color:#9aa0ab">
      Choose any paid plan and the same account comes straight back online — files, databases and email exactly as you left them.
      After {{ grace_days|default(7) }} days the account and its data are permanently removed.
    </div>

  </div>
</div>
{% endblock %}
