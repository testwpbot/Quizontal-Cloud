{% block subject %}Your trial hosting account for {{ trial.domain }} has been removed{% endblock %}
{% block content %}
<div style="margin:0;padding:40px 24px;background:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1c1f26;-webkit-font-smoothing:antialiased">
  <div style="max-width:520px;margin:0 auto">

    <div style="font-size:15px;font-weight:700;letter-spacing:-0.2px;color:#1c1f26">Quizontal&nbsp;Cloud</div>

    <div style="font-size:23px;font-weight:700;line-height:1.35;letter-spacing:-0.4px;margin:34px 0 18px">Your trial account has been closed</div>

    <div style="font-size:15px;line-height:1.7;color:#1c1f26;margin:0 0 16px">Hi {{ c.first_name }},</div>

    <div style="font-size:15px;line-height:1.7;color:#5b6270;margin:0 0 22px">
      The grace period after your free trial for {{ trial.domain }} has passed,
      so the hosting account and its data have now been removed from our servers.
    </div>

    <div style="font-size:15px;line-height:1.7;color:#5b6270;margin:0 0 30px">
      Your Quizontal Cloud customer account is still open. You can order a paid plan at any time and set the domain up again in a couple of minutes.
    </div>

    <a href="{{ upgrade_url }}" style="display:inline-block;padding:13px 26px;background:#1c1f26;color:#ffffff;text-decoration:none;border-radius:8px;font-size:14.5px;font-weight:600">Browse hosting plans</a>

    <div style="height:1px;background:#e9eaee;margin:34px 0 22px"></div>

    <div style="font-size:12.5px;line-height:1.7;color:#9aa0ab">
      Thank you for trying Quizontal Cloud. If something did not work the way you expected, reply to this email and tell us — we read every message.
    </div>

  </div>
</div>
{% endblock %}
