{% block subject %}Your free trial for {{ trial.domain }} ends on {{ trial.expires_at|date('j M') }}{% endblock %}
{% block content %}
<div style="margin:0;padding:40px 24px;background:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1c1f26;-webkit-font-smoothing:antialiased">
  <div style="max-width:520px;margin:0 auto">

    <div style="font-size:15px;font-weight:700;letter-spacing:-0.2px;color:#1c1f26">Quizontal&nbsp;Cloud</div>

    <div style="font-size:23px;font-weight:700;line-height:1.35;letter-spacing:-0.4px;margin:34px 0 18px">Your trial ends on {{ trial.expires_at|date('j M Y') }}</div>

    <div style="font-size:15px;line-height:1.7;color:#1c1f26;margin:0 0 16px">Hi {{ c.first_name }},</div>

    <div style="font-size:15px;line-height:1.7;color:#5b6270;margin:0 0 30px">
      Your free hosting trial for {{ trial.domain }} finishes in
      {{ trial.days_left > 1 ? trial.days_left ~ ' days' : 'less than a day' }}.
      Upgrade before then and your site keeps running without a second of downtime.
    </div>

    <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:14.5px;margin:0 0 30px">
      <tr>
        <td style="padding:9px 0;color:#8a909c;width:150px">Domain</td>
        <td style="padding:9px 0;color:#1c1f26;font-weight:600">{{ trial.domain }}</td>
      </tr>
      <tr>
        <td style="padding:9px 0;color:#8a909c">Trial ends</td>
        <td style="padding:9px 0;color:#1c1f26;font-weight:600">{{ trial.expires_at|date('j M Y') }}</td>
      </tr>
      <tr>
        <td style="padding:9px 0;color:#8a909c">If you do nothing</td>
        <td style="padding:9px 0;color:#1c1f26;font-weight:600">The account is suspended</td>
      </tr>
    </table>

    <a href="{{ upgrade_url }}" style="display:inline-block;padding:13px 26px;background:#1c1f26;color:#ffffff;text-decoration:none;border-radius:8px;font-size:14.5px;font-weight:600">Upgrade to a paid plan</a>
    <a href="{{ service_url }}" style="display:inline-block;padding:13px 20px;color:#5b6270;text-decoration:none;font-size:14.5px;font-weight:600">View my service</a>

    <div style="height:1px;background:#e9eaee;margin:34px 0 22px"></div>

    <div style="font-size:12.5px;line-height:1.7;color:#9aa0ab">
      Your files and databases stay in place for {{ grace_days|default(7) }} days after the trial ends, so you have time to decide.
      After that the account is removed permanently.
    </div>

  </div>
</div>
{% endblock %}
