{% block subject %}Your Quizontal Cloud verification code: {{ verification_code }}{% endblock %}
{% block content %}
<div style="margin:0;padding:28px;background:#f5f6f8;font-family:Arial,sans-serif;color:#20242b">
  <div style="max-width:620px;margin:0 auto;background:#ffffff;border:1px solid #e4e6ea;border-radius:14px;overflow:hidden">
    <div style="height:5px;background:#e31c64"></div>
    <div style="padding:28px">
      <div style="font-size:22px;font-weight:700;margin-bottom:8px">Quizontal Cloud</div>
      <h1 style="font-size:24px;margin:24px 0 8px">Here is your verification code</h1>
      <p style="color:#6b7280;line-height:1.6;margin-top:0">Enter this code on the free trial page to confirm your email address and continue setting up your {{ trial_days|default(7) }}-day trial.</p>

      <div style="margin:26px 0;text-align:center">
        <div style="display:inline-block;padding:18px 26px;background:#fdf1f6;border:1px solid #f6c6d9;border-radius:12px">
          <div style="font-family:Consolas,Menlo,monospace;font-size:30px;font-weight:700;letter-spacing:6px;color:#e31c64;white-space:nowrap">{{ verification_code }}</div>
        </div>
      </div>

      <p style="color:#6b7280;line-height:1.6">
        Type it <strong>exactly</strong> as shown — capitals, small letters, numbers and symbols all matter.
        The code expires in <strong>{{ expires_minutes|default(15) }} minutes</strong> and can only be used once.
      </p>
      <p style="margin:26px 0 0;color:#8a8f98;font-size:13px;line-height:1.5">
        If you did not request a Quizontal Cloud free trial, you can safely ignore this email — nothing has been created and no account exists for this address.
        Never share this code with anyone, including people claiming to be Quizontal Cloud staff.
      </p>
    </div>
  </div>
</div>
{% endblock %}
