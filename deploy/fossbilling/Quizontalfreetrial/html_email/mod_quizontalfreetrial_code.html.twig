{% block subject %}Your Quizontal Cloud verification code is {{ verification_code }}{% endblock %}
{% block content %}
<div style="margin:0;padding:40px 24px;background:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1c1f26;-webkit-font-smoothing:antialiased">
  <div style="max-width:520px;margin:0 auto">

    <div style="font-size:15px;font-weight:700;letter-spacing:-0.2px;color:#1c1f26">Quizontal&nbsp;Cloud</div>

    <div style="font-size:23px;font-weight:700;line-height:1.35;letter-spacing:-0.4px;margin:34px 0 18px">Here is your verification code</div>

    <div style="font-size:15px;line-height:1.7;color:#1c1f26;margin:0 0 16px">{% if first_name %}Hi {{ first_name }},{% else %}Hello there,{% endif %}</div>

    <div style="font-size:15px;line-height:1.7;color:#5b6270;margin:0">
      Enter this code on the free trial page to confirm your email address and continue setting up your {{ trial_days|default(7) }}-day trial.
    </div>

    <div style="font-family:'SF Mono',Consolas,Menlo,monospace;font-size:31px;font-weight:700;letter-spacing:5px;color:#1c1f26;margin:34px 0 6px;word-break:break-all">{{ verification_code }}</div>

    <div style="font-size:13px;line-height:1.7;color:#8a909c;margin:0 0 34px">
      Type it exactly as shown — capitals, small letters, numbers and symbols all matter.
      It expires in {{ expires_minutes|default(15) }} minutes and can only be used once.
    </div>

    <div style="height:1px;background:#e9eaee;margin:0 0 22px"></div>

    <div style="font-size:12.5px;line-height:1.7;color:#9aa0ab">
      If you did not request a Quizontal Cloud free trial you can ignore this email — nothing has been created and no account exists for this address.
      We will never ask you for this code by phone, chat or WhatsApp.
    </div>

  </div>
</div>
{% endblock %}
