{% block subject %}Your free trial for {{ trial.domain }} is live{% endblock %}
{% block content %}
<div style="margin:0;padding:40px 24px;background:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1c1f26;-webkit-font-smoothing:antialiased">
  <div style="max-width:520px;margin:0 auto">

    <div style="font-size:15px;font-weight:700;letter-spacing:-0.2px;color:#1c1f26">Quizontal&nbsp;Cloud</div>

    <div style="font-size:23px;font-weight:700;line-height:1.35;letter-spacing:-0.4px;margin:34px 0 18px">Your free trial is ready</div>

    <div style="font-size:15px;line-height:1.7;color:#1c1f26;margin:0 0 16px">Hi {{ c.first_name }},</div>

    <div style="font-size:15px;line-height:1.7;color:#5b6270;margin:0 0 30px">
      Your starter hosting account has been created and is running right now. No payment details were taken.
    </div>

    <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-size:14.5px;margin:0 0 30px">
      <tr>
        <td style="padding:9px 0;color:#8a909c;width:130px">Domain</td>
        <td style="padding:9px 0;color:#1c1f26;font-weight:600">{{ trial.domain }}</td>
      </tr>
      <tr>
        <td style="padding:9px 0;color:#8a909c">Trial started</td>
        <td style="padding:9px 0;color:#1c1f26;font-weight:600">{{ trial.starts_at|date('j M Y') }}</td>
      </tr>
      <tr>
        <td style="padding:9px 0;color:#8a909c">Trial ends</td>
        <td style="padding:9px 0;color:#1c1f26;font-weight:600">{{ trial.expires_at|date('j M Y') }}</td>
      </tr>
      <tr>
        <td style="padding:9px 0;color:#8a909c">Cost</td>
        <td style="padding:9px 0;color:#1c1f26;font-weight:600">Free</td>
      </tr>
    </table>

    <a href="{{ service_url }}" style="display:inline-block;padding:13px 26px;background:#1c1f26;color:#ffffff;text-decoration:none;border-radius:8px;font-size:14.5px;font-weight:600">Open my hosting account</a>

    <div style="font-size:16.5px;font-weight:700;letter-spacing:-0.2px;margin:38px 0 12px">Next: point your domain to us</div>

    <div style="font-size:15px;line-height:1.7;color:#5b6270;margin:0 0 34px">
      Your service page has your control panel login, nameservers and server IP address.
      Update the nameservers at your registrar and {{ trial.domain }} starts serving from Quizontal Cloud, usually within a few hours.
    </div>

    <div style="height:1px;background:#e9eaee;margin:0 0 22px"></div>

    <div style="font-size:12.5px;line-height:1.7;color:#9aa0ab">
      We will remind you before the trial ends. If you decide to keep your site, upgrade from your dashboard and nothing is interrupted.
    </div>

  </div>
</div>
{% endblock %}
