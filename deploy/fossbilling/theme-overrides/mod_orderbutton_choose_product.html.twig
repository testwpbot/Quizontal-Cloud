{% import 'qc_storefront.html.twig' as qc_storefront %}
{% set storefront_url = qc_storefront.url()|trim('/') %}
{% set products = guest.product_get_list %}
{% set categories = guest.product_category_get_list.list %}
{% set register_tlds = guest.serviceDomain_tlds({"allow_register": 1})|default([]) %}
{% set domain_category = categories|filter(c => c.type == 'domain' and c.products is not empty)|first %}
{% set domain_product = domain_category ? domain_category.products|first : null %}
{# Covers ?product=ID deep links as well as pretty /order/slug routes (controller passes `product`).
   Never auto-open on the checkout step (/order?checkout=1): the customer already chose —
   the picker must not photobomb the payment view. #}
{% set picker_open = not ((product is defined and product) or request.product or request.checkout) %}
{# Legacy/short links like /order?register_sld=x&register_tld=.com&auto=1 carry a domain
   intent but no product id — forward them straight into the domain product so the
   order form can prefill and auto-proceed instead of showing a bare picker. #}
{% set has_domain_intent = request.register_sld|default('') != '' or request.transfer_sld|default('') != '' %}
{% if domain_product and has_domain_intent and picker_open %}
    {% if request.register_sld|default('') != '' %}
        {% set forward_query = {'product': domain_product.id, 'register_sld': request.register_sld, 'register_tld': request.register_tld|default(''), 'auto': request.auto|default('')} %}
    {% else %}
        {% set forward_query = {'product': domain_product.id, 'transfer_sld': request.transfer_sld, 'transfer_tld': request.transfer_tld|default(''), 'transfer_code': request.transfer_code|default('')} %}
    {% endif %}
<script>
    window.location.replace({{ 'order'|link(forward_query)|json_encode|raw }});
</script>
{% endif %}
{# Bare /order with nothing selected: shoppers landing here are lost — the catalogue
   browser means nothing to them. Funnel them to the friendly product pages instead;
   deep links (/order?product=…, /order/slug), domain intents and the checkout step
   all skip this guard above/below, so the buying flow is never interrupted. #}
{% if picker_open and not has_domain_intent and guest.extension_is_on({"mod": "custompages"}) %}
<script>
    window.location.replace({{ 'custompages/vps'|link|json_encode|raw }});
</script>
{% endif %}
<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button {% if not picker_open %}collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#products" aria-expanded="{{ picker_open ? 'true' : 'false' }}" aria-controls="products">
            <svg class="svg-icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M16.7 4.5L19.5 7.3L16.7 10.1L13.9 7.3L16.7 4.5M9 5V9H5V5H9M19 15V19H15V15H19M16.7 1.7L11 7.3L16.7 13H13V21H21V13H16.7L22.3 7.3L16.7 1.7M11 3H3V11H11V3M9 15V19H5V15H9M11 13H3V21H11V13Z" /></svg>
            <span>{{ 'Browse products & services'|trans }}</span>&nbsp;<span class="badge bg-secondary">{{ products.list|length }}</span>
        </button>
    </h2>
    <div id="products" class="accordion-collapse collapse {% if picker_open %}show{% endif %}" data-bs-parent="#orderManager">
        <div class="accordion-body">

            {% if domain_product %}
            <div class="qc-order-hero mb-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-5">
                        <div class="d-flex align-items-start gap-3">
                            <span class="qc-order-hero-icon">
                                <svg fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2m-5.15 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56M14.34 14H9.66c-.1-.66-.16-1.32-.16-2s.06-1.35.16-2h4.68c.09.65.16 1.32.16 2s-.07 1.34-.16 2M12 19.96c-.83-1.2-1.5-2.53-1.91-3.96h3.82c-.41 1.43-1.08 2.76-1.91 3.96M8 8H5.08c.95-1.66 2.49-2.94 4.32-3.56C8.8 5.55 8.35 6.75 8 8m-2.92 8H8c.35 1.25.8 2.45 1.4 3.56-1.83-.63-3.37-1.9-4.32-3.56M4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38a8.26 8.26 0 0 0-.14 2c0 .68.06 1.34.14 2M12 4.03c.83 1.2 1.5 2.57 1.91 3.97h-3.82C10.5 6.6 11.17 5.23 12 4.03M18.92 8h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.9 4.33 3.56M12 2C6.47 2 2 6.5 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2Z"/></svg>
                            </span>
                            <div>
                                <h5 class="mb-1">{{ 'Find your perfect domain'|trans }}</h5>
                                <small class="qc-order-hero-sub">{{ 'Type a name — we check live availability and prices across every extension.'|trans }}</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <form class="d-flex flex-wrap gap-2" id="qcDomainSearch" autocomplete="off">
                            <input id="qcDomainInput" type="text" class="form-control flex-grow-1" style="min-width:180px" spellcheck="false"
                                   placeholder="{{ 'myshop.com'|trans }}" aria-label="{{ 'Domain name'|trans }}">
                            {% if storefront_url == '' and register_tlds is not empty %}
                            <select id="qcDomainTld" class="form-select flex-grow-0" style="width:auto" aria-label="{{ 'Extension'|trans }}">
                                {% for tld in register_tlds %}<option value="{{ tld.tld }}">{{ tld.tld }}</option>{% endfor %}
                            </select>
                            {% endif %}
                            <button id="qcDomainGo" type="submit" class="btn btn-primary px-4">{{ 'Search'|trans }}</button>
                        </form>
                    </div>
                </div>
            </div>
            {% endif %}

            <div id="qcStep1">
                <p class="text-muted small mb-2">{{ 'Pick a category to see its plans:'|trans }}</p>
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    {% for category in categories %}
                    {% if category.products is not empty %}
                    <div class="col">
                        <button type="button" class="card w-100 h-100 text-start shadow-none qc-cat-card"
                                data-qc-cat-id="{{ category.id }}" data-qc-cat-title="{{ category.title|e('html_attr') }}">
                            <div class="card-body d-flex flex-column">
                                <span class="qc-cat-icon">
                                    <svg fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7 15H9V17H7V15M7 7H9V9H7V7M20 13H4C2.9 13 2 12.1 2 11V5C2 3.9 2.9 3 4 3H20C21.1 3 22 3.9 22 5V11C22 12.1 21.1 13 20 13M4 11H20V5H4V11M20 21H4C2.9 21 2 20.1 2 19V13C2 11.9 2.9 11 4 11H20C21.1 11 22 11.9 22 13V19C22 20.1 21.1 21 20 21M4 19H20V13H4V19Z"/></svg>
                                </span>
                                <div class="d-flex justify-content-between align-items-start mb-1 gap-2">
                                    <h5 class="card-title mb-0">{{ category.title }}</h5>
                                    <span class="badge border">{{ category.products|length }}</span>
                                </div>
                                {% if category.description %}
                                {% set clean_description = category.description|striptags|trim %}
                                <p class="card-text text-muted small mb-3">{{ clean_description|slice(0, 110) }}{% if clean_description|length > 110 %}…{% endif %}</p>
                                {% endif %}
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    {% if category.price_starting_from > 0 %}
                                    <span class="small qc-from">{{ 'From'|trans }} <strong>{{ category.price_starting_from|money_convert }}</strong></span>
                                    {% else %}<span></span>{% endif %}
                                    <span class="small fw-semibold qc-view">{{ 'View plans'|trans }} <span aria-hidden="true">→</span></span>
                                </div>
                            </div>
                        </button>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>

            <div id="qcStep2" hidden>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <button type="button" class="premium-btn premium-btn-sm" id="qcBack">All categories</button>
                    <h5 class="mb-0 me-auto" id="qcStep2Title"></h5>
                    <div class="d-flex align-items-center gap-2 flex-grow-1 flex-sm-grow-0">
                        <div class="qc-order-search">
                            <svg fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9.5 3a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13M2 9.5a7.5 7.5 0 1 1 13.3 4.74L21 20l-1.4 1.4-5.7-5.7A7.5 7.5 0 0 1 2 9.5Z"/></svg>
                            <input id="qcProductFilter" type="search" class="form-control form-control-sm" autocomplete="off" spellcheck="false"
                                   placeholder="{{ 'Filter plans…'|trans }}">
                        </div>
                        <small class="text-muted text-nowrap" id="qcFilterCount"></small>
                    </div>
                </div>
                {% for category in categories %}
                {% if category.products is not empty %}
                <section class="qc-cat" data-qc-cat="{{ category.id }}" hidden>
                    <div class="qc-order-list">
                        {% for product in category.products|sort((a, b) => a.priority <=> b.priority) %}
                        <a class="qc-product qc-order-product"
                           data-qc-text="{{ (product.title ~ ' ' ~ product.description ~ ' ' ~ category.title)|lower|e('html_attr') }}"
                           href="{{ 'order'|link({ 'product': product.id, 'show_custom_form_values': request.show_custom_form_values }) }}">
                            <span class="text-truncate">
                                <span class="qc-plan-name d-block text-truncate">{{ product.title }}</span>
                                {% if product.description %}<small class="text-muted d-block text-truncate">{{ product.description|striptags }}</small>{% endif %}
                            </span>
                            <span class="text-nowrap text-end">
                                {% if product.price_starting_from > 0 %}<strong class="qc-plan-price">{{ product.price_starting_from|money_convert }}</strong><small class="text-muted d-block">{{ 'starting from'|trans }}</small>{% endif %}
                            </span>
                        </a>
                        {% endfor %}
                    </div>
                </section>
                {% endif %}
                {% endfor %}
                <div id="qcEmpty" class="text-center text-muted py-4" hidden>
                    <strong class="d-block mb-1">{{ 'Nothing matches that filter.'|trans }}</strong>
                    <small>{{ 'Try a different word, or go back to the categories.'|trans }}</small>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    /* Quizontal Cloud — dark premium order catalog. */
    .qc-cat-card {
        background: var(--iq-surface, #0b0b0e);
        border: 1px solid var(--iq-line, rgba(255,255,255,.06));
        color: var(--iq-body, #9aa3b2);
        border-radius: .75rem;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }
    .qc-cat-card:hover { transform: translateY(-3px); border-color: rgba(227, 28, 100, .45); box-shadow: 0 .5rem 1.5rem rgba(0, 0, 0, .6); }
    .qc-cat-card:focus-visible { outline: none; border-color: #f1719f; box-shadow: 0 0 0 3px var(--iq-primary-light, rgba(227, 28, 100, .16)); }
    .qc-cat-icon {
        width: 44px; height: 44px; border-radius: 50%;
        display: grid; place-items: center;
        background: var(--iq-primary-light, rgba(227, 28, 100, .16));
        color: #f06b9d;
        margin-bottom: 12px;
    }
    .qc-cat-icon svg { width: 20px; height: 20px; }
    .qc-cat-card .card-title { color: var(--iq-heading, #f5f6f8); }
    .qc-cat-card .badge { background: rgba(255,255,255,.06); color: #9aa3b2; font-weight: 600; }
    .qc-cat-card .qc-from { color: #7d8494; }
    .qc-cat-card .qc-from strong { color: var(--iq-heading, #f5f6f8); }
    .qc-cat-card .qc-view { color: #f06b9d; font-weight: 600; }

    /* domain hero */
    .qc-order-hero {
        background: var(--iq-surface, #0b0b0e);
        border: 1px solid var(--iq-line, rgba(255,255,255,.06));
        border-radius: .75rem;
        padding: 18px 20px;
    }
    .qc-order-hero h5 { color: var(--iq-heading, #f5f6f8); }
    .qc-order-hero .qc-order-hero-sub { color: #7d8494; }
    .qc-order-hero-icon {
        width: 44px; height: 44px; border-radius: 50%; flex: none;
        display: grid; place-items: center;
        background: var(--iq-primary-light, rgba(227, 28, 100, .16));
        color: #f06b9d;
    }
    .qc-order-hero-icon svg { width: 22px; height: 22px; }

    /* step 2 search + product rows */
    .qc-order-search {
        display: flex; align-items: center; gap: 8px;
        background: rgba(255,255,255,.04);
        border: 1px solid var(--iq-line, rgba(255,255,255,.06));
        border-radius: .5rem;
        padding: 0 10px;
        min-width: 200px;
        transition: border-color .18s ease;
    }
    .qc-order-search:focus-within { border-color: #f1719f; }
    .qc-order-search svg { width: 15px; height: 15px; color: #7e8594; flex: none; }
    .qc-order-search .form-control { border: 0; background: transparent; box-shadow: none; color: #e6e8ec; padding: 8px 0; font-size: .85rem; }
    .qc-order-search .form-control::placeholder { color: #5f6673; }
    .qc-order-list { display: grid; gap: 8px; }
    .qc-order-product {
        display: flex; align-items: center; justify-content: space-between; gap: 14px;
        padding: 14px 16px;
        background: #121216;
        border: 1px solid transparent;
        border-radius: .6rem;
        color: var(--iq-body, #9aa3b2);
        text-decoration: none;
        transition: border-color .15s ease, background .15s ease, transform .15s ease;
    }
    .qc-order-product:hover { border-color: rgba(227, 28, 100, .35); background: #17171c; transform: translateY(-1px); color: var(--iq-body, #9aa3b2); }
    .qc-order-product .qc-plan-name { color: var(--iq-heading, #f5f6f8); font-weight: 600; }
    .qc-order-product .qc-plan-price { color: var(--iq-heading, #f5f6f8); font-weight: 700; white-space: nowrap; }
    .qc-order-product > span:first-child { flex: 1 1 auto; min-width: 0; overflow: hidden; }
    @media (max-width: 575.98px) {
        .qc-order-search { min-width: 0; flex: 1 1 auto; }
        .qc-order-product { flex-wrap: wrap; }
        .qc-order-product > span:first-child { flex-basis: 100%; }
        .qc-order-product > span.text-nowrap { text-align: left !important; }
    }
</style>
<script>
(function () {
    var step1 = document.getElementById('qcStep1');
    var step2 = document.getElementById('qcStep2');
    if (!step1 || !step2) return;
    var sections = Array.prototype.slice.call(step2.querySelectorAll('.qc-cat'));
    var cards = document.querySelectorAll('.qc-cat-card');
    var back = document.getElementById('qcBack');
    var title = document.getElementById('qcStep2Title');
    var filter = document.getElementById('qcProductFilter');
    var count = document.getElementById('qcFilterCount');
    var empty = document.getElementById('qcEmpty');

    function applyFilter() {
        var term = (filter.value || '').trim().toLowerCase();
        var visible = 0, total = 0;
        sections.forEach(function (section) {
            if (section.hidden) return;
            section.querySelectorAll('.qc-product').forEach(function (row) {
                total++;
                var match = term === '' || row.getAttribute('data-qc-text').indexOf(term) !== -1;
                row.classList.toggle('d-none', !match);
                if (match) visible++;
            });
        });
        if (count) count.textContent = visible + ' / ' + total;
        if (empty) empty.hidden = !(visible === 0 && total > 0 && term !== '');
    }

    cards.forEach(function (card) {
        card.addEventListener('click', function () {
            var id = card.getAttribute('data-qc-cat-id');
            sections.forEach(function (section) { section.hidden = section.getAttribute('data-qc-cat') !== id; });
            title.textContent = card.getAttribute('data-qc-cat-title');
            step1.hidden = true;
            step2.hidden = false;
            filter.value = '';
            applyFilter();
        });
    });
    back.addEventListener('click', function () {
        step2.hidden = true;
        sections.forEach(function (section) { section.hidden = true; });
        step1.hidden = false;
    });
    filter.addEventListener('input', applyFilter);

    {% if domain_product %}
    var storefront = {{ storefront_url|json_encode|raw }};
    var domainForm = document.getElementById('qcDomainSearch');
    var domainInput = document.getElementById('qcDomainInput');
    {% if storefront_url == '' %}
    var domainTld = document.getElementById('qcDomainTld');
    var quickUrl = {{ 'order'|link({'product': domain_product.id, 'register_sld': '__SLD__', 'register_tld': '__TLD__', 'auto': '1'})|json_encode|raw }};
    {% endif %}

    domainForm.addEventListener('submit', function (event) {
        event.preventDefault();
        var raw = (domainInput.value || '').trim().toLowerCase()
            .replace(/^https?:\/\//, '').replace(/^www\./, '').split('/')[0].replace(/\.+$/, '');
        if (raw === '') { domainInput.focus(); return; }
        if (storefront) {
            // Full search lives on the storefront — it auto-applies ?q= and shows live availability + prices.
            window.location.href = storefront + '/domains?q=' + encodeURIComponent(raw);
            return;
        }
        {% if storefront_url == '' %}
        // Fallback without a storefront link: prefill the built-in domain order form.
        var options = domainTld ? Array.prototype.map.call(domainTld.options, function (o) { return o.value; }) : [];
        var sld = raw, tld = domainTld ? domainTld.value : '';
        if (raw.indexOf('.') !== -1) {
            var first = raw.slice(0, raw.indexOf('.'));
            var suffix = raw.slice(raw.indexOf('.'));
            if (options.indexOf(suffix) !== -1) { sld = first; tld = suffix; }
            else {
                var lastSuffix = raw.slice(raw.lastIndexOf('.'));
                if (options.indexOf(lastSuffix) !== -1) { sld = raw.slice(0, raw.lastIndexOf('.')); tld = lastSuffix; }
            }
        }
        sld = sld.replace(/[^a-z0-9-]/g, '');
        if (sld === '') { domainInput.focus(); return; }
        window.location.href = quickUrl.replace('__SLD__', encodeURIComponent(sld)).replace('__TLD__', encodeURIComponent(tld));
        {% endif %}
    });
    {% endif %}
})();
</script>
