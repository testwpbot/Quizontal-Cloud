{% set products = guest.product_get_list %}
{% set categories = guest.product_category_get_list.list %}
{% set register_tlds = guest.serviceDomain_tlds({"allow_register": 1})|default([]) %}
{% set domain_category = categories|filter(c => c.type == 'domain' and c.products is not empty)|first %}
{% set domain_product = domain_category ? domain_category.products|first : null %}
<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#products" aria-expanded="false" aria-controls="products">
            <svg class="svg-icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M16.7 4.5L19.5 7.3L16.7 10.1L13.9 7.3L16.7 4.5M9 5V9H5V5H9M19 15V19H15V15H19M16.7 1.7L11 7.3L16.7 13H13V21H21V13H16.7L22.3 7.3L16.7 1.7M11 3H3V11H11V3M9 15V19H5V15H9M11 13H3V21H11V13Z" /></svg>
            <span>{{ 'Browse products & services'|trans }}</span>&nbsp;<span class="badge bg-secondary">{{ products.list|length }}</span>
        </button>
    </h2>
    <div id="products" class="accordion-collapse collapse" data-bs-parent="#orderManager">
        <div class="accordion-body">
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-7">
                    <input id="qcProductFilter" type="search" class="form-control" autocomplete="off" spellcheck="false"
                           placeholder="{{ 'Filter products — try “KVM”, “Windows”, “domain”…'|trans }}">
                </div>
                <div class="col-md-5 text-md-end"><small class="text-muted" id="qcFilterCount"></small></div>
            </div>

            <ul class="nav nav-pills gap-2 mb-3" id="qcCategoryTabs">
                <li class="nav-item"><button type="button" class="nav-link active py-1 px-3" data-qc-tab="all">{{ 'All'|trans }}</button></li>
                {% for category in categories %}
                {% if category.products is not empty %}
                <li class="nav-item"><button type="button" class="nav-link py-1 px-3" data-qc-tab="{{ category.id }}">{{ category.title }}&nbsp;<span class="badge text-bg-light border">{{ category.products|length }}</span></button></li>
                {% endif %}
                {% endfor %}
            </ul>

            {% if domain_product %}
            <div class="card border bg-light mb-4 qc-cat" data-qc-cat="{{ domain_category.id }}">
                <div class="card-body">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-5">
                            <h5 class="mb-1">{{ domain_category.title }}</h5>
                            <small class="text-muted">{{ 'Type a name — we jump straight into the order form with it filled in.'|trans }}</small>
                        </div>
                        <div class="col-md-7">
                            <div class="input-group">
                                <input id="qcDomainInput" type="text" class="form-control" autocomplete="off" spellcheck="false"
                                       placeholder="{{ 'myshop.com'|trans }}" aria-label="{{ 'Domain name'|trans }}">
                                {% if register_tlds is not empty %}
                                <select id="qcDomainTld" class="form-select flex-grow-0" style="width:auto" aria-label="{{ 'Extension'|trans }}">
                                    {% for tld in register_tlds %}<option value="{{ tld.tld }}">{{ tld.tld }}</option>{% endfor %}
                                </select>
                                {% endif %}
                                <button id="qcDomainGo" type="button" class="btn btn-dark">{{ 'Find'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}

            <div id="qcProductGroups">
                {% for category in categories %}
                {% if category.products is not empty %}
                <section class="mb-4 qc-cat" data-qc-cat="{{ category.id }}">
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <h5 class="mb-0">{{ category.title }}</h5>
                        {% if category.price_starting_from > 0 %}<small class="text-muted">{{ 'From'|trans }} {{ category.price_starting_from|money_convert }}</small>{% endif %}
                    </div>
                    {% if category.description %}<div class="text-muted small mb-2">{{ category.description|markdown }}</div>{% endif %}
                    <div class="list-group">
                        {% for product in category.products|sort((a, b) => a.priority <=> b.priority) %}
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3 qc-product"
                           data-qc-text="{{ (product.title ~ ' ' ~ product.description ~ ' ' ~ category.title)|lower }}"
                           href="{{ 'order'|link({ 'product': product.id, 'show_custom_form_values': request.show_custom_form_values }) }}">
                            <span class="text-truncate">
                                <span class="fw-semibold d-block text-truncate">{{ product.title }}</span>
                                {% if product.description %}<small class="text-muted d-block text-truncate">{{ product.description|striptags }}</small>{% endif %}
                            </span>
                            <span class="text-nowrap text-end">
                                {% if product.price_starting_from > 0 %}<small class="text-muted d-block">{{ 'From'|trans }}</small><strong>{{ product.price_starting_from|money_convert }}</strong>{% endif %}
                                <svg class="svg-icon text-muted ms-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z" /></svg>
                            </span>
                        </a>
                        {% endfor %}
                    </div>
                </section>
                {% endif %}
                {% endfor %}
                <div id="qcEmpty" class="text-center text-muted border rounded py-4" hidden>
                    <strong class="d-block mb-1">{{ 'Nothing matches that filter.'|trans }}</strong>
                    <small>{{ 'Try a different word, or browse the tabs above.'|trans }}</small>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
(function () {
    var input = document.getElementById('qcProductFilter');
    var tabs = document.querySelectorAll('#qcCategoryTabs [data-qc-tab]');
    var sections = Array.prototype.slice.call(document.querySelectorAll('.qc-cat'));
    var count = document.getElementById('qcFilterCount');
    var empty = document.getElementById('qcEmpty');
    var activeTab = 'all';

    function applyFilters() {
        var term = (input.value || '').trim().toLowerCase();
        var visible = 0;
        sections.forEach(function (section) {
            var catVisible = activeTab === 'all' || section.getAttribute('data-qc-cat') === activeTab;
            var rows = section.querySelectorAll('.qc-product');
            var sectionVisible = catVisible;
            if (rows.length && catVisible) {
                var any = false;
                rows.forEach(function (row) {
                    var match = term === '' || row.getAttribute('data-qc-text').indexOf(term) !== -1;
                    row.classList.toggle('d-none', !match);
                    if (match) { any = true; visible++; }
                });
                sectionVisible = any;
            }
            section.classList.toggle('d-none', !sectionVisible);
        });
        if (empty) empty.hidden = visible !== 0 || term === '';
        if (count) count.textContent = visible + ' / {{ products.list|length }} {{ 'products'|trans }}';
    }

    if (input) input.addEventListener('input', applyFilters);
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            tabs.forEach(function (t) { t.classList.remove('active'); });
            tab.classList.add('active');
            activeTab = tab.getAttribute('data-qc-tab');
            applyFilters();
        });
    });
    applyFilters();
    {% if domain_product %}
    var quickUrl = {{ 'order'|link({'product': domain_product.id, 'register_sld': '__SLD__', 'register_tld': '__TLD__'})|json_encode|raw }};
    var domainInput = document.getElementById('qcDomainInput');
    var domainTld = document.getElementById('qcDomainTld');
    function quickDomain() {
        var raw = (domainInput.value || '').trim().toLowerCase().replace(/^https?:\/\//, '').replace(/^www\./, '').split('/')[0].replace(/\.+$/, '');
        if (raw === '') { domainInput.focus(); return; }
        var options = domainTld ? Array.prototype.map.call(domainTld.options, function (o) { return o.value; }) : [];
        var sld = raw, tld = domainTld ? domainTld.value : '';
        if (raw.indexOf('.') !== -1) {
            var first = raw.slice(0, raw.indexOf('.'));
            var suffix = raw.slice(raw.indexOf('.'));
            if (options.indexOf(suffix) !== -1) { sld = first; tld = suffix; }
            else {
                var lastSuffix = raw.slice(raw.lastIndexOf('.'));
                if (options.indexOf(lastSuffix) !== -1) { sld = raw.slice(0, raw.lastIndexOf('.')); tld = lastSuffix; }
            }
        }
        sld = sld.replace(/[^a-z0-9-]/g, '');
        if (sld === '') { domainInput.focus(); return; }
        window.top.location.href = quickUrl.replace('__SLD__', encodeURIComponent(sld)).replace('__TLD__', encodeURIComponent(tld));
    }
    document.getElementById('qcDomainGo').addEventListener('click', quickDomain);
    domainInput.addEventListener('keydown', function (event) { if (event.key === 'Enter') { event.preventDefault(); quickDomain(); } });
    {% endif %}
})();
</script>
