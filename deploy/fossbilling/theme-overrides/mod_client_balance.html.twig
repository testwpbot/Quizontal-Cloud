{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'Wallet'|trans }}{% endblock %}

{% set profile = client.profile_get %}

{% block body_class %}client-balance qc-has-banner{% endblock %}
{% block breadcrumbs %}{% endblock %}

{% set transactions = client.client_balance_get_list({"per_page": 10, "page": request.page}) %}
{% set submissions = client.quizontalbanktransfer_get_list({"per_page": 100}) %}
{% set qc_pending = 0 %}
{% for s in submissions.list %}{% if s.status in ['pending', 'processing'] %}{% set qc_pending = qc_pending + 1 %}{% endif %}{% endfor %}

{% block banner %}
    <div class="iq-banner">
        <div class="iq-banner-art" aria-hidden="true"></div>
        <div class="container-fluid iq-container">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <h1>{{ 'Wallet'|trans }}</h1>
                    <p>{{ 'Here you can manage and track your account balance.'|trans }}</p>
                    <span class="banner-date">
                        <svg fill="currentColor"><use href="#i-wallet"/></svg>
                        {{ profile.balance|money(profile.currency) }}
                    </span>
                </div>
                <div class="qc-wallet-topup">
                    <form method="post" class="form-inline api-form d-flex gap-2" action="{{ 'api/client/quizontalbanktransfer/create_funds_invoice'|link }}" data-api-jsonp="onAfterInvoiceCreated">
                        <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                        <div class="qc-topup-input">
                            <span>{{ profile.currency }}</span>
                            <input class="form-control" type="text" name="amount" placeholder="0" required="required">
                        </div>
                        <button class="premium-btn" type="submit">{{ 'Add funds'|trans }}</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
{% if client %}
    {% if request.receipt_submitted %}<div class="alert alert-success"><strong>Receipt submitted.</strong> Your transfer is pending administrator verification. This page will show the latest status.</div>{% endif %}

    {# ================= stat cards ================= #}
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress" style="--val:100">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-wallet"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Wallet balance'|trans }}</p>
                            <h4>{{ profile.balance|money(profile.currency) }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress circle-progress-info" style="--val:100">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-activity"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Transactions'|trans }}</p>
                            <h4>{{ transactions.list|length }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress circle-progress-warning" style="--val:100">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-document"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Pending transfers'|trans }}</p>
                            <h4>{{ qc_pending }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress circle-progress-success" style="--val:100">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-download"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Submissions'|trans }}</p>
                            <h4>{{ submissions.list|length }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ================= balance history ================= #}
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="header-title">
                <h4 class="card-title">{{ 'Balance History'|trans }}</h4>
                <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'Recent additions and deductions on your wallet.'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-layout-flat">
                    <thead>
                        <tr>
                            <th>{{ 'Description'|trans }}</th>
                            <th>{{ 'Date'|trans }}</th>
                            <th class="text-end">{{ 'Amount'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for i, tx in transactions.list %}
                        <tr>
                            <td>
                                <div class="service-cell">
                                    <span class="service-ico {{ tx.amount > 0 ? 'bg-soft-success' : 'bg-soft-primary' }}"><svg fill="currentColor"><use href="{{ tx.amount > 0 ? '#i-download' : '#i-buy' }}"/></svg></span>
                                    <div class="service-name">{{ tx.description }}</div>
                                </div>
                            </td>
                            <td class="text-size-12">{{ tx.created_at|format_date(pattern="MMM d, yyyy") }}</td>
                            <td class="text-end fw-medium" style="color:{{ tx.amount > 0 ? 'var(--iq-success)' : 'var(--iq-heading)' }}">{{ tx.amount|money(tx.currency) }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3"><div class="text-center py-4 text-muted">{{ 'The list is empty'|trans }}</div></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ include('partial_pagination.html.twig', {'list': transactions}) }}
        </div>
    </div>

    {# ================= bank submissions ================= #}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="header-title">
                <h4 class="card-title">{{ 'Bank transfer submissions'|trans }}</h4>
                <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'Track every receipt submitted for wallet funding.'|trans }}</p>
            </div>
        </div>
        <div class="card-body">
            {% set status_classes = {'pending': 'bg-soft-warning', 'processing': 'bg-soft-info', 'approved': 'bg-soft-success', 'rejected': 'bg-soft-danger'} %}
            {% set status_labels = {'pending': 'Pending review', 'processing': 'Processing', 'approved': 'Approved', 'rejected': 'Rejected'} %}
            <div class="table-responsive">
                <table class="table table-layout-flat align-middle">
                    <thead><tr><th>Invoice</th><th>Date</th><th>Amount</th><th>Reference</th><th>Status</th><th>Admin note</th><th></th></tr></thead>
                    <tbody>
                    {% for item in submissions.list %}
                        <tr>
                            <td>
                                {% if item.invoice_hash %}<a href="{{ ('invoice/' ~ item.invoice_hash)|link }}" class="text-decoration-none" style="color:var(--iq-heading)">{{ item.serie_nr }}</a>{% else %}<span class="service-name">{{ item.serie_nr }}</span>{% endif %}
                            </td>
                            <td class="text-size-12">{{ item.created_at|format_date(pattern="MMM d, yyyy") }}</td>
                            <td class="fw-medium" style="color:var(--iq-heading)">{{ item.amount|money(item.currency) }}</td>
                            <td class="text-size-12">{{ item.reference }}</td>
                            <td>
                                <span class="iq-badge {{ status_classes[item.status]|default('') }}"{% if item.status not in ['pending','processing','approved','rejected'] %} style="background:#1e1e24;color:#9aa3b2"{% endif %}><span class="iq-badge-dot"></span>{{ status_labels[item.status]|default(item.status|capitalize) }}</span>
                            </td>
                            <td class="text-size-12">{% if item.admin_note %}{{ item.admin_note }}{% else %}<span class="text-muted">—</span>{% endif %}</td>
                            <td><a class="premium-btn premium-btn-sm" target="_blank" href="{{ ('quizontalbanktransfer/receipt/' ~ item.id)|link }}">{{ 'Receipt'|trans }}</a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="text-center text-muted py-4">No bank transfer receipts submitted yet.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <style>
        .qc-wallet-topup form { flex-wrap: wrap; }
        .qc-topup-input {
            display: flex; align-items: center; gap: 12px;
            background: rgba(0,0,0,.35);
            border: 2px solid rgba(255,255,255,.92);
            border-radius: 14px;
            padding: 0 24px;
            height: 54px;
            min-width: 240px;
            transition: box-shadow .18s ease, background .18s ease;
        }
        .qc-topup-input:focus-within {
            border-color: #fff;
            background: rgba(0,0,0,.45);
            box-shadow: 0 0 0 3px rgba(227,28,100,.22);
        }
        .qc-topup-input span {
            color: rgba(255,255,255,.7); font-weight: 700; font-size: .78rem;
            text-transform: uppercase; letter-spacing: .06em;
            background: rgba(255,255,255,.1);
            padding: 3px 8px; border-radius: 6px;
        }
        .qc-topup-input input {
            flex: 1; width: 120px; border: 0; background: transparent; box-shadow: none;
            color: #fff; font-weight: 700; font-size: 1.15rem; padding: 0;
            -moz-appearance: textfield;
        }
        .qc-topup-input input::-webkit-outer-spin-button,
        .qc-topup-input input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        .qc-topup-input input::placeholder { color: rgba(255,255,255,.35); font-weight: 500; }
        .qc-topup-input input:focus { box-shadow: none; }
        @media (max-width: 575.98px) {
            .qc-wallet-topup { width: 100%; }
            .qc-wallet-topup form { flex-wrap: wrap; }
            .qc-topup-input { flex: 1 1 100%; min-width: 0; }
            .qc-wallet-topup .premium-btn { flex: 1 1 100%; }
        }
    </style>
{% else %}
    <div class="qcd-empty"><p>{{ 'Please sign in to view your wallet.'|trans }}</p></div>
{% endif %}
{% endblock %}

{% block js %}
<script>
function onAfterInvoiceCreated(hash) {
    var link = '{{ "invoice"|link }}/' + hash;
    bb.redirect(link);
}
</script>
{% endblock %}
