{% import "macro_functions.html.twig" as mf %}
<div class="qc-slide-card">
    <div class="qc-slide-head">
        <span class="qc-slide-ico">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,6A2,2 0 0,0 10,8A2,2 0 0,0 12,10A2,2 0 0,0 14,8A2,2 0 0,0 12,6M12,13C14.67,13 20,14.33 20,17V20H4V17C4,14.33 9.33,13 12,13M12,14.9C9.03,14.9 5.9,16.36 5.9,17V18.1H18.1V17C18.1,16.36 14.97,14.9 12,14.9Z"/></svg>
        </span>
        <div>
            <h2>{{ 'Login or Register'|trans }}</h2>
            <p>{{ 'Sign in to place your order and track it from your dashboard.'|trans }}</p>
        </div>
    </div>

    <div role="tablist">
        <ul class="nav qc-order-tabs mb-4">
            <li class="nav-item"><a class="nav-link active" id="in-tab" data-bs-toggle="tab" data-bs-target="#sign-in" role="tab" aria-controls="sign-in" aria-selected="true">{{ 'Sign in'|trans }}</a></li>
            <li class="nav-item"><a class="nav-link" id="up-tab" data-bs-toggle="tab" data-bs-target="#sign-up" role="tab" aria-controls="sign-up" aria-selected="false">{{ 'Create account'|trans }}</a></li>
        </ul>

        <div class="tab-content" id="nav-tabContent">
            <div class="tab-pane show active" id="sign-in" role="tabpanel" aria-labelledby="in-tab" tabindex="0">
                <form method="post" class="api-form" action="{{ 'api/guest/client/login'|link }}" data-api-jsonp="onLogin">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="email" name="email" id="email" required="required"
                                   value="{{ request.email }}" placeholder="{{ 'Email Address'|trans }}"
                                   data-validation-required-message="{{ 'You must fill in your email.'|trans }}">
                            <label for="email">{{ 'Email Address'|trans }}</label>
                        </div>
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="password" name="password" id="password" required="required"
                                   value="{{ request.password }}" placeholder="{{ 'Password'|trans }}"
                                   data-validation-required-message="{{ 'You must fill in your password.'|trans }}">
                            <label for="password">{{ 'Password'|trans }}</label>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="premium-btn premium-btn-sm" type="submit">{{ 'Login'|trans }}</button>
                    </div>
                </form>
            </div>

            <div class="tab-pane" id="sign-up" role="tabpanel" aria-labelledby="up-tab" tabindex="0">
                <form class="api-form" action="{{ 'api/guest/client/create'|link }}" method="post" data-api-jsonp="onAccountCreate">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    {% set r = guest.client_required %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="email" name="email" id="reg-email" required="required"
                                   value="{{ request.email }}" placeholder="{{ 'Email Address'|trans }}">
                            <label for="reg-email">{{ 'Email Address'|trans }}</label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="text" name="first_name" id="first-name" required="required"
                                   value="{{ request.first_name }}" placeholder="{{ 'First Name'|trans }}">
                            <label for="first-name">{{ 'First Name'|trans }}</label>
                        </div>
                    </div>

                    {% if 'last_name' in r %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="text" name="last_name" id="last_name" required="required"
                                   value="{{ request.last_name }}" placeholder="{{ 'Last Name'|trans }}">
                            <label for="last_name">{{ 'Last Name'|trans }}</label>
                        </div>
                    </div>
                    {% endif %}

                    {% if 'company' in r %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="text" name="company" id="company" required="required"
                                   value="{{ request.company }}" placeholder="{{ 'Company'|trans }}">
                            <label for="company">{{ 'Company'|trans }}</label>
                        </div>
                    </div>
                    {% endif %}

                    {% if 'birthday' in r %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="date" name="birthday" id="birthday" placeholder="{{ 'Birthday'|trans }}">
                            <label for="birthday">{{ 'Birthday'|trans }}</label>
                        </div>
                    </div>
                    {% endif %}

                    {% if 'gender' in r %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <select class="form-select" name="gender" id="gender">
                                <option value="male">{{ 'Male'|trans }}</option>
                                <option value="female">{{ 'Female'|trans }}</option>
                                <option value="nonbinary">{{ 'Non-binary'|trans }}</option>
                                <option value="other">{{ 'Other'|trans }}</option>
                            </select>
                            <label for="gender">{{ 'You are'|trans }}</label>
                        </div>
                    </div>
                    {% endif %}

                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="password" name="password" id="reg-password" required="required" placeholder="{{ 'Password'|trans }}">
                            <label for="reg-password">{{ 'Password'|trans }}</label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="password" name="password_confirm" id="password-confirm" required="required" placeholder="{{ 'Confirm password'|trans }}">
                            <label for="password-confirm">{{ 'Confirm password'|trans }}</label>
                        </div>
                    </div>

                    {% if 'address_1' in r %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="text" name="address_1" id="address_1" value="{{ request.address_1 }}" placeholder="{{ 'Address'|trans }}">
                            <label for="address_1">{{ 'Address'|trans }}</label>
                        </div>
                    </div>
                    {% endif %}

                    {% if 'address_2' in r %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="text" name="address_2" id="address_2" value="{{ request.address_2 }}" placeholder="{{ 'Address 2'|trans }}">
                            <label for="address_2">{{ 'Address 2'|trans }}</label>
                        </div>
                    </div>
                    {% endif %}

                    {% if 'city' in r %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="text" name="city" id="city" value="{{ request.city }}" placeholder="{{ 'City'|trans }}">
                            <label for="city">{{ 'City'|trans }}</label>
                        </div>
                    </div>
                    {% endif %}

                    {% if 'country' in r %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <select class="form-select" name="country" id="country" required="required">
                                <option value="">{{ '-- Select country --'|trans }}</option>
                                {% for val,label in guest.system_countries %}
                                    <option value="{{ val }}" label="{{ label|e }}"{% if request.country|default('') == val %} selected{% endif %}>{{ label|e }}</option>
                                {% endfor %}
                            </select>
                            <label for="country">{{ 'Country'|trans }}</label>
                        </div>
                    </div>
                    {% endif %}

                    {% if 'state' in r %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="text" name="state" id="state" value="{{ request.state }}" placeholder="{{ 'State'|trans }}">
                            <label for="state">{{ 'State'|trans }}</label>
                        </div>
                    </div>
                    {% endif %}

                    {% if 'postcode' in r %}
                    <div class="row">
                        <div class="form-floating col-md-7 mb-3">
                            <input class="form-control" type="text" name="postcode" id="postcode" value="{{ request.postcode }}" placeholder="{{ 'Zip/Postal Code'|trans }}">
                            <label for="postcode">{{ 'Zip/Postal Code'|trans }}</label>
                        </div>
                    </div>
                    {% endif %}

                    {% if 'phone' in r %}
                    <div class="row">
                        <div class="col-md-7 mb-3">
                            <label for="phone_cc" class="form-label">{{ 'Phone Code'|trans }}</label>
                            <input class="form-control" type="text" name="phone_cc" id="phone_cc" placeholder="{{ 'Phone Code'|trans }}">
                            <label for="phone" class="form-label mt-2">{{ 'Phone Number'|trans }}</label>
                            <input class="form-control" type="text" name="phone" id="phone" placeholder="{{ 'Phone Number'|trans }}">
                        </div>
                    </div>
                    {% endif %}

                    {% set custom_fields = guest.client_custom_fields %}
                    {% for field_name, field in custom_fields %}
                        {% if field.active %}
                            <div class="row">
                                <div class="form-floating col-md-7 mb-3">
                                    <input class="form-control" type="text" name="{{ field_name }}" id="{{ field_name }}"
                                           value="{{ request.(field_name) }}"{% if field.required %} required="required"{% endif %}
                                           placeholder="{{ field_name | capitalize }}">
                                    <label for="{{ field_name }}">{% if field.title is not empty %}{{ field.title }}{% else %} {{ field_name | capitalize }} {% endif %}</label>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}

                    {{ mf.recaptcha }}

                    {% if settings.signup_tos == 'explicit' %}
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" required>
                            <label class="form-check-label" for="flexCheckDefault">
                                <span>I agree to the <a href="{{ '/tos'|link }}" target="_blank">{{ 'terms of service'|trans }}</a> and <a href="{{ '/privacy-policy'|link }}" target="_blank">{{ 'privacy policy'|trans }}</a>.</span>
                            </label>
                        </div>
                    {% endif %}

                    <div class="d-flex gap-2 align-items-center">
                        <button class="premium-btn premium-btn-sm" type="submit">{{ 'Register'|trans }}</button>
                        <button class="btn btn-sm btn-link" type="button" id="in-tab-2" data-bs-toggle="tab" data-bs-target="#sign-in">{{ 'Already a user?'|trans }}</button>
                    </div>

                    {% if settings.signup_tos == 'implicit' %}
                        <div class="mt-3 small text-muted">
                            <span>By creating an account, you agree to our <a href="{{ '/tos'|link }}" target="_blank">{{ 'terms of service'|trans }}</a> and <a href="{{ '/privacy-policy'|link }}" target="_blank">{{ 'privacy policy'|trans }}</a>.</span>
                        </div>
                    {% endif %}
                </form>
            </div>
        </div>
    </div>
</div>
<style>
    .qc-order-tabs { gap: 6px; padding: 5px; background: rgba(255,255,255,.03); border: 1px solid var(--iq-line, rgba(255,255,255,.06)); border-radius: 14px; display: inline-flex; flex-wrap: wrap; }
    .qc-order-tabs .nav-link { border: 1px solid transparent; border-radius: 10px; padding: 8px 18px; font-size: .85rem; font-weight: 600; color: #8b93a3; }
    .qc-order-tabs .nav-link:hover { color: #fff; background: rgba(255,255,255,.05); }
    .qc-order-tabs .nav-link.active { background: linear-gradient(135deg, var(--iq-primary, #e31c64), var(--iq-primary-dark, #a51149)); color: #fff; box-shadow: 0 6px 16px rgba(227,28,100,.32); }
    .qc-slide-card .form-floating > .form-control, .qc-slide-card .form-floating > .form-select { background: rgba(255,255,255,.03); border-color: var(--iq-line, rgba(255,255,255,.08)); color: #e6e8ec; }
    .qc-slide-card .form-floating > label { color: #7d8494; }
</style>
