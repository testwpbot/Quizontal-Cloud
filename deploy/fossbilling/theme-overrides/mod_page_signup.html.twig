{% extends "layout_public.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% set company = guest.system_company %}

{% block meta_title %}{{ 'Register'|trans }}{% endblock %}

{% block body_class %}page-signup qc-auth-page{% endblock %}

{% block body %}
<div class="qc-auth">
    <div class="qc-auth-glow g1"></div><div class="qc-auth-glow g2"></div>
    <div class="qc-auth-card qc-auth-card-wide">
        <a href="{{ '/'|link }}" class="qc-auth-logo">
            <img src="https://res.cloudinary.com/dt1sdefd6/image/upload/v1786643376/ChatGPT_Image_Aug_13_2026_11_17_40_PM-remove-bg-io_y5zxiu.png" alt="{{ company.name }}">
        </a>
        <h1>{{ 'Create a new account'|trans }}</h1>
        <p class="qc-auth-sub">{{ 'Join Quizontal Cloud to manage domains, hosting and servers.'|trans }}</p>

        <form class="api-form auth" action="{{ 'api/guest/client/create'|link }}" method="post" data-api-redirect="{{ '/'|link }}">
            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
            {% set r = guest.client_required %}

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="first-name">{{ 'First Name'|trans }}</label>
                    <div class="qc-ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
                        <input class="form-control" id="first-name" type="text" name="first_name" value="{{ request.first_name }}" placeholder="{{ 'Enter your first name'|trans }}" required="required"/>
                    </div>
                </div>
                {% if 'last_name' in r %}
                <div class="col-md-6">
                    <label class="form-label" for="last_name">{{ 'Last Name'|trans }}</label>
                    <div class="qc-ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
                        <input class="form-control" id="last_name" type="text" name="last_name" value="{{ request.last_name }}" placeholder="{{ 'Enter your last name'|trans }}" required="required"/>
                    </div>
                </div>
                {% endif %}
                <div class="col-12">
                    <label class="form-label" for="reg-email">{{ 'Email Address'|trans }}</label>
                    <div class="qc-ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                        <input class="form-control" id="reg-email" type="email" name="email" value="{{ request.email }}" placeholder="{{ 'you@example.com'|trans }}" required="required"/>
                    </div>
                </div>
                {% if 'company' in r %}
                <div class="col-12">
                    <label class="form-label" for="company">{{ 'Company'|trans }}</label>
                    <div class="qc-ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16"/><path d="M15 9h3a2 2 0 0 1 2 2v10"/><path d="M2 21h20"/><path d="M8 8h2M8 12h2M8 16h2M12 8h.01M12 12h.01M12 16h.01"/></svg>
                        <input class="form-control" id="company" type="text" name="company" value="{{ request.company }}" placeholder="{{ 'Your company name'|trans }}" required="required"/>
                    </div>
                </div>
                {% endif %}
                {% if 'birthday' in r %}
                <div class="col-12">
                    <label class="form-label" for="birthday">{{ 'Birthday'|trans }}</label>
                    <div class="qc-ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                        <input class="form-control" id="birthday" type="date" name="birthday" value=""/>
                    </div>
                </div>
                {% endif %}
                {% if 'gender' in r %}
                <div class="col-12">
                    <label class="form-label" for="gender">{{ 'Gender'|trans }}</label>
                    <select class="form-select" id="gender" name="gender">
                        <option value="male">{{ 'Male'|trans }}</option>
                        <option value="female">{{ 'Female'|trans }}</option>
                        <option value="nonbinary">{{ 'Non-binary'|trans }}</option>
                        <option value="other">{{ 'Other'|trans }}</option>
                    </select>
                </div>
                {% endif %}
                {% if 'address_1' in r %}
                <div class="col-12">
                    <label class="form-label" for="address_1">{{ 'Address'|trans }}</label>
                    <input class="form-control" id="address_1" type="text" name="address_1" value="{{ request.address_1 }}" placeholder="{{ 'Street address'|trans }}"/>
                </div>
                {% endif %}
                {% if 'address_2' in r %}
                <div class="col-12">
                    <label class="form-label" for="address_2">{{ 'Address 2'|trans }}</label>
                    <input class="form-control" id="address_2" type="text" name="address_2" value="{{ request.address_2 }}" placeholder="{{ 'Apartment, suite, etc.'|trans }}"/>
                </div>
                {% endif %}
                {% if 'city' in r %}
                <div class="col-md-6">
                    <label class="form-label" for="city">{{ 'City'|trans }}</label>
                    <input class="form-control" id="city" type="text" name="city" value="{{ request.city }}" placeholder="{{ 'Your city'|trans }}"/>
                </div>
                {% endif %}
                {% if 'country' in r %}
                <div class="col-md-6">
                    <label class="form-label" for="country">{{ 'Country'|trans }}</label>
                    <select class="form-select" id="country" name="country" required="required">
                        <option value="">{{ '-- Select country --'|trans }}</option>
                        {% for val,label in guest.system_countries %}
                            <option value="{{ val }}" label="{{ label|e }}">{{ label|e }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                {% if 'state' in r %}
                <div class="col-md-6">
                    <label class="form-label" for="state">{{ 'State'|trans }}</label>
                    <input class="form-control" id="state" type="text" name="state" value="{{ request.state }}" placeholder="{{ 'Your state / region'|trans }}"/>
                </div>
                {% endif %}
                {% if 'postcode' in r %}
                <div class="col-md-6">
                    <label class="form-label" for="postcode">{{ 'Zip/Postal Code'|trans }}</label>
                    <input class="form-control" id="postcode" type="text" name="postcode" value="{{ request.postcode }}" placeholder="{{ 'e.g. 20000'|trans }}"/>
                </div>
                {% endif %}
                {% if 'phone' in r %}
                <div class="col-12">
                    <label class="form-label" for="phone">{{ 'Phone Number'|trans }}</label>
                    <div class="qc-ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
                        <div class="input-group">
                            <input class="form-control" style="width:25%" type="text" name="phone_cc" value="" placeholder="{{ '+94'|trans }}"/>
                            <input class="form-control" style="width:75%" id="phone" type="text" name="phone" value="{{ request.phone }}" placeholder="{{ '71 234 5678'|trans }}"/>
                        </div>
                    </div>
                </div>
                {% endif %}

                {% set custom_fields = guest.client_custom_fields %}
                {% for field_name, field in custom_fields %}
                    {% if field.active %}
                        <div class="col-12">
                            <label class="form-label" for="{{ field_name }}">{{ field.title is not empty ? field.title : field_name | capitalize }}</label>
                            <input class="form-control" id="{{ field_name }}" type="text" name="{{ field_name }}" value="{{ request.(field_name) }}" {% if field.required %}required="required"{% endif %}/>
                        </div>
                    {% endif %}
                {% endfor %}

                <div class="col-md-6">
                    <label class="form-label" for="reg-password">{{ 'Password'|trans }}</label>
                    <div class="qc-ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.2"/></svg>
                        <input class="form-control" id="reg-password" type="password" name="password" value="" placeholder="{{ 'Create a password'|trans }}" required="required"/>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="password-confirm">{{ 'Password confirm'|trans }}</label>
                    <div class="qc-ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.2"/></svg>
                        <input class="form-control" id="password-confirm" type="password" name="password_confirm" value="" placeholder="{{ 'Repeat your password'|trans }}" required="required"/>
                    </div>
                </div>
            </div>

            {{ mf.recaptcha }}

            {% if settings.signup_tos == 'explicit' %}
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" required>
                    <label class="form-check-label" for="flexCheckDefault">
                        <span>I agree to the <a href="{{ '/tos'|link }}" target="_blank">{{ 'terms of service'|trans }}</a> and <a href="{{ '/privacy-policy'|link }}" target="_blank">{{ 'privacy policy'|trans }}.</span>
                    </label>
                </div>
            {% endif %}

            <button class="qc-auth-btn mt-4" type="submit">{{ 'Register'|trans }}</button>

            {% if settings.signup_tos == 'implicit' %}
                <div class="mt-3">
                    <span class="text-muted mb-1">By creating an account, you agree to our <a href="{{ '/tos'|link }}" target="_blank">{{ 'terms of service'|trans }}</a> and <a href="{{ '/privacy-policy'|link }}" target="_blank">{{ 'privacy policy'|trans }}</a>.</span>
                </div>
            {% endif %}
        </form>

        <div class="qc-auth-links">
            <a href="{{ 'login'|link }}">{{ 'Already a user?'|trans }}</a>
            {% if settings.show_password_reset_link %}
                <a href="{{ 'password-reset'|link }}">{{ 'Forgot password?'|trans }}</a>
            {% endif %}
        </div>
    </div>
</div>
<style>
    .qc-auth-page { margin: 0; }
    .qc-auth {
        position: relative; min-height: 100vh;
        display: flex; align-items: center; justify-content: center;
        padding: 2rem 1rem;
        background: #050508; color: #9aa3b2; overflow: hidden;
    }
    .qc-auth-glow { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
    .qc-auth-glow.g1 { width: 520px; height: 520px; background: rgba(227, 28, 100, .28); right: -180px; top: -120px; }
    .qc-auth-glow.g2 { width: 420px; height: 420px; background: rgba(168, 85, 247, .22); left: -180px; bottom: -140px; }
    .qc-auth-card {
        position: relative; z-index: 2;
        width: min(480px, 100%);
        background: #0b0b0e;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 40px 34px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
        max-height: calc(100vh - 4rem); overflow-y: auto;
    }
    .qc-auth-logo { display: block; text-align: center; margin-bottom: 24px; }
    .qc-auth-logo img { height: 54px; width: auto; object-fit: contain; }
    .qc-auth h1 { color: #f5f6f8; font-size: 1.4rem; font-weight: 700; text-align: center; margin: 0 0 8px; }
    .qc-auth-sub { color: #7d8494; font-size: .85rem; text-align: center; margin: 0 0 26px; line-height: 1.55; }
    .qc-auth .form-label { color: #9aa3b2; font-size: .8rem; font-weight: 600; }
    .qc-auth .form-control, .qc-auth .form-select {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e6e8ec; border-radius: 10px; padding: 11px 14px;
    }
    .qc-auth .form-control:focus, .qc-auth .form-select:focus {
        background: rgba(255, 255, 255, 0.06);
        border-color: #f1719f; color: #fff;
        box-shadow: 0 0 0 3px rgba(227, 28, 100, 0.18);
    }
    .qc-auth .form-select option { background: #101014; color: #e6e8ec; }
    .qc-auth .form-control::placeholder { color: #5f6673; }
    .qc-ico { position: relative; }
    .qc-ico > svg {
        position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; color: #7d8494; pointer-events: none; z-index: 2;
        transition: color .2s ease;
    }
    .qc-ico > .form-control { padding-left: 42px; }
    .qc-ico > .input-group .form-control { padding-left: 14px; }
    .qc-ico:focus-within > svg { color: #f1719f; }
    .qc-auth .form-check-label { color: #9aa3b2; }
    .qc-auth .form-check-label a, .qc-auth .text-muted a { color: #f5f6f8; }
    .qc-auth .form-check-label a:hover, .qc-auth .text-muted a:hover { color: #ff7bac; }
    .qc-auth .form-check-input { background-color: #1c1c22; border-color: #2a2a32; }
    .qc-auth .form-check-input:checked { background-color: #e31c64; border-color: #e31c64; }
    .qc-auth-btn {
        width: 100%; height: 50px;
        border: 0; border-radius: 12px; cursor: pointer;
        background: linear-gradient(135deg, #e31c64, #a51149);
        color: #fff; font-weight: 700; font-size: .95rem;
        box-shadow: 0 12px 30px rgba(227, 28, 100, .32);
        transition: transform .15s ease, box-shadow .2s ease, filter .2s ease;
    }
    .qc-auth-btn:hover { filter: brightness(1.06); transform: translateY(-1px); box-shadow: 0 16px 38px rgba(227, 28, 100, .4); }
    .qc-auth-links {
        display: flex; justify-content: space-between; gap: 12px;
        margin-top: 20px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.06);
    }
    .qc-auth-links a { color: #f5f6f8; font-size: .82rem; font-weight: 600; text-decoration: none; }
    .qc-auth-links a:hover { color: #ff7bac; }
</style>
{% endblock %}
