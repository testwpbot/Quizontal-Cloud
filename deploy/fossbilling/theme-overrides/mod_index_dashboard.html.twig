{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{# Quizontal Cloud — modern client dashboard (app-shell design).
   All data comes from FOSSBilling's own client/guest APIs, so grouping,
   counts and amounts always reflect the real account state. #}

{% block meta_title %}{{ 'Dashboard'|trans }}{% endblock %}
{% block body_class %}dashboard qcd-dashboard-page{% endblock %}
{% block breadcrumbs %}{% endblock %}

{% import "macro_functions.html.twig" as mf %}
{% import "qc_storefront.html.twig" as qc_store %}

{% block head %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
{% endblock %}

{% block content %}
{% if client %}
    {# ---------- data gathering ---------- #}
    {% set qc_orders = client.order_get_list({ "per_page": 100, "hide_addons": 1 }).list %}
    {% set qc_domains = [] %}{% set qc_hosting = [] %}{% set qc_vps = [] %}
    {% for order in qc_orders %}
        {% if order.status == 'active' %}
            {% if order.service_type == 'domain' %}
                {% set qc_domains = qc_domains|merge([order]) %}
            {% elseif order.service_type == 'hosting' %}
                {% set qc_hosting = qc_hosting|merge([order]) %}
            {% else %}
                {% set qc_vps = qc_vps|merge([order]) %}
            {% endif %}
        {% endif %}
    {% endfor %}

    {% set qc_unpaid = client.invoice_get_list({ "status": "unpaid", "per_page": 100 }).list %}
    {% set qc_due = 0 %}
    {% for inv in qc_unpaid %}{% set qc_due = qc_due + inv.total %}{% endfor %}

    {% set qc_paid = client.invoice_get_list({ "status": "paid", "per_page": 100 }).list %}
    {% set qc_spent_total = 0 %}
    {% for inv in qc_paid %}{% set qc_spent_total = qc_spent_total + inv.total %}{% endfor %}

    {# 6 monthly buckets (oldest -> newest). Pure date arithmetic — no
       date_modify dependency, works on FOSSBilling's stock Twig setup. #}
    {% set qc_nowY = "now"|date("Y") + 0 %}
    {% set qc_nowM = "now"|date("n") + 0 %}
    {% set qc_names = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
    {% set qc_months = [] %}
    {% for d in 5..0 %}
        {% set m = qc_nowM - d %}
        {% if m < 1 %}{% set m = m + 12 %}{% endif %}
        {% set qc_months = qc_months|merge([{ label: qc_names[m - 1], sum: 0 }]) %}
    {% endfor %}
    {% for inv in qc_paid %}
        {% set invY = inv.created_at|date("Y") + 0 %}
        {% set invM = inv.created_at|date("n") + 0 %}
        {% set diff = (qc_nowY - invY) * 12 + (qc_nowM - invM) %}
        {% if diff >= 0 and diff <= 5 %}
            {% set bi = 5 - diff %}
            {% set qc_months = qc_months|merge({ (bi): qc_months[bi]|merge({ sum: qc_months[bi].sum + inv.total }) }) %}
        {% endif %}
    {% endfor %}
    {% set qc_max = 1 %}
    {% for m in qc_months %}{% if m.sum > qc_max %}{% set qc_max = m.sum %}{% endif %}{% endfor %}
    {% set qc_points = "" %}
    {% for i, m in qc_months %}
        {% set x = (i * 240 / 5)|round + 20 %}
        {% set y = (80 - (m.sum / qc_max) * 66)|round(1) %}
        {% set qc_points = qc_points ~ x ~ "," ~ y ~ " " %}
    {% endfor %}
    {% set qc_this = qc_months[5].sum %}{% set qc_prev = qc_months[4].sum %}
    {% set qc_delta = qc_prev > 0 ? ((qc_this - qc_prev) / qc_prev * 100)|round(1) : null %}

    {# recent activity lanes: latest orders + latest payments (no client-side
       activity API exists in FOSSBilling 0.7.1, so we compose our own feed) #}
    {% set qc_feed_orders = qc_orders|slice(0, 2) %}
    {% set qc_feed_paid = qc_paid|slice(0, 2) %}
    {% set qc_news = guest.extension_is_on({ "mod": "news" }) ? guest.news_get_list({ "per_page": 2 }).list : [] %}
    {% set qc_onhold = client.support_ticket_get_list({ "status": 'on_hold', "per_page": 5 }).list %}
    {% set qc_currency = profile.currency %}

    <div class="qcd">
        {# ---------- welcome ---------- #}
        <div class="qcd-hero">
            <div>
                <h2 class="qcd-hero-title">{{ 'Welcome back'|trans }}, {{ profile.first_name }}! <span class="qcd-wave">👋</span></h2>
                <p class="qcd-hero-sub">{{ "Here's what's happening with your account today."|trans }}</p>
            </div>
            <div class="qcd-hero-art" aria-hidden="true"><span class="qcd-blob b1"></span><span class="qcd-blob b2"></span><span class="qcd-blob b3"></span></div>
        </div>

        {% if settings.showcase_enabled %}
            <div class="alert alert-info" role="alert">
                <p class="mb-1">{{ settings.showcase_text|markdown }}</p>
                {% if (settings.showcase_button_url) and (settings.showcase_button_title) %}
                    <a class="btn btn-primary btn-sm" href="{{ settings.showcase_button_url }}">{{ settings.showcase_button_title }}</a>
                {% endif %}
            </div>
        {% endif %}

        {% for ticket in qc_onhold %}
            <div class="alert alert-info d-flex justify-content-between align-items-center" role="alert">
                <span>{{ 'Ticket'|trans }} <strong>#{{ ticket.id }}</strong> {{ 'was replied to'|trans }} {{ ticket.updated_at|timeago }} {{ 'ago'|trans }}.</span>
                <a href="{{ 'support/ticket'|link }}/{{ ticket.id }}" class="alert-link">{{ 'Reply'|trans }}</a>
            </div>
        {% endfor %}

        {# ---------- stat cards ---------- #}
        <div class="qcd-stats">
            <div class="qcd-stat">
                <div class="qcd-stat-ic ic-vps"><svg viewBox="0 0 24 24"><path d="M4,1H20A1,1 0 0,1 21,2V6A1,1 0 0,1 20,7H4A1,1 0 0,1 3,6V2A1,1 0 0,1 4,1M4,9H20A1,1 0 0,1 21,10V14A1,1 0 0,1 20,15H4A1,1 0 0,1 3,14V10A1,1 0 0,1 4,9M4,17H20A1,1 0 0,1 21,18V22A1,1 0 0,1 20,23H4A1,1 0 0,1 3,22V18A1,1 0 0,1 4,17M9,5H10V3H9V5M9,13H10V11H9V13M9,21H10V19H9V21M5,3V5H7V3H5M5,11V13H7V11H5M5,19V21H7V19H5Z" /></svg></div>
                <div><span class="qcd-stat-label">{{ 'VPS / Servers'|trans }}</span><strong class="qcd-stat-num">{{ qc_vps|length }}</strong><span class="qcd-stat-note n-pink">{{ 'Active services'|trans }}</span></div>
                <i class="qcd-stat-bar b-pink"></i>
            </div>
            <div class="qcd-stat">
                <div class="qcd-stat-ic ic-host"><svg viewBox="0 0 24 24"><path d="M17,3H7A2,2 0 0,0 5,5V9H19V5A2,2 0 0,0 17,3M7,7A1,1 0 0,1 6,6A1,1 0 0,1 7,5A1,1 0 0,1 8,6A1,1 0 0,1 7,7M19,11H5V15H19M7,14A1,1 0 0,1 6,13A1,1 0 0,1 7,12A1,1 0 0,1 8,13A1,1 0 0,1 7,14M19,17H5V21H19M7,20A1,1 0 0,1 6,19A1,1 0 0,1 7,18A1,1 0 0,1 8,19A1,1 0 0,1 7,20Z" /></svg></div>
                <div><span class="qcd-stat-label">{{ 'Web Hosting'|trans }}</span><strong class="qcd-stat-num">{{ qc_hosting|length }}</strong><span class="qcd-stat-note n-blue">{{ 'Active services'|trans }}</span></div>
                <i class="qcd-stat-bar b-blue"></i>
            </div>
            <div class="qcd-stat">
                <div class="qcd-stat-ic ic-dom"><svg viewBox="0 0 24 24"><path d="M16.36,14C16.44,13.34 16.5,12.68 16.5,12C16.5,11.32 16.44,10.66 16.36,10H19.74C19.9,10.64 20,11.31 20,12C20,12.69 19.9,13.36 19.74,14M14.59,19.56C15.19,18.45 15.65,17.25 15.97,16H18.92C17.96,17.65 16.43,18.93 14.59,19.56M14.34,14H9.66C9.56,13.34 9.5,12.68 9.5,12C9.5,11.32 9.56,10.65 9.66,10H14.34C14.43,10.65 14.5,11.32 14.5,12C14.5,12.68 14.43,13.34 14.34,14M12,19.96C11.17,18.76 10.5,17.43 10.09,16H13.91C13.5,17.43 12.83,18.76 12,19.96M8,8H5.08C6.03,6.34 7.57,5.06 9.4,4.44C8.8,5.55 8.35,6.75 8,8M5.08,16H8C8.35,17.25 8.8,18.45 9.4,19.56C7.57,18.93 6.03,17.65 5.08,16M4.26,14C4.1,13.36 4,12.69 4,12C4,11.31 4.1,10.64 4.26,10H7.64C7.56,10.66 7.5,11.32 7.5,12C7.5,12.68 7.56,13.34 7.64,14M12,4.03C12.83,5.23 13.5,6.57 13.91,8H10.09C10.5,6.57 11.17,5.23 12,4.03M18.92,8H15.97C15.65,6.75 15.19,5.55 14.59,4.44C16.43,5.07 17.96,6.34 18.92,8M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" /></svg></div>
                <div><span class="qcd-stat-label">{{ 'Domains'|trans }}</span><strong class="qcd-stat-num">{{ qc_domains|length }}</strong><span class="qcd-stat-note n-green">{{ 'Active domains'|trans }}</span></div>
                <i class="qcd-stat-bar b-green"></i>
            </div>
            <div class="qcd-stat">
                <div class="qcd-stat-ic ic-due"><svg viewBox="0 0 24 24"><path d="M15.5,15.5C16.33,15.5 17,14.83 17,14C17,13.17 16.33,12.5 15.5,12.5C14.67,12.5 14,13.17 14,14C14,14.83 14.67,15.5 15.5,15.5M7,3H17C18.11,3 19,3.9 19,5V7C20.11,7 21,7.9 21,9V19C21,20.11 20.11,21 19,21H7C4.79,21 3,19.21 3,17V7C3,4.79 4.79,3 7,3M17,7V5H7C5.9,5 5,5.9 5,7V7.54C5.59,7.2 6.27,7 7,7H17M5,17C5,18.11 5.9,19 7,19H19V9H7C5.9,9 5,9.9 5,11V17Z" /></svg></div>
                <div><span class="qcd-stat-label">{{ 'Outstanding'|trans }}</span><strong class="qcd-stat-num">{{ qc_due|money(qc_currency) }}</strong><span class="qcd-stat-note n-amber">{{ 'Due amount'|trans }}</span></div>
                <i class="qcd-stat-bar b-amber"></i>
            </div>
        </div>

        {# ---------- main grid ---------- #}
        <div class="qcd-grid">
            <section class="qcd-card qcd-services">
                <div class="qcd-card-head"><h3>{{ 'Your Services'|trans }}</h3><a class="qcd-link-btn" href="{{ 'order/service'|link }}">{{ 'View All'|trans }}</a></div>
                {% if qc_orders %}
                    <div class="qcd-svc-list" id="qcdServiceList">
                    {% for order in qc_orders|slice(0, 4) %}
                        <a class="qcd-svc" href="{{ 'order/service/manage'|link }}/{{ order.id }}" data-name="{{ order.title|lower }}">
                            <span class="qcd-svc-ic {{ order.service_type == 'domain' ? 't-dom' : (order.service_type == 'hosting' ? 't-host' : 't-vps') }}">
                                {% if order.service_type == 'domain' %}<svg viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6.5A5.5,5.5 0 0,0 6.5,12A5.5,5.5 0 0,0 12,17.5A5.5,5.5 0 0,0 17.5,12A5.5,5.5 0 0,0 12,6.5Z" /></svg>
                                {% elseif order.service_type == 'hosting' %}<svg viewBox="0 0 24 24"><path d="M17,3H7A2,2 0 0,0 5,5V9H19V5A2,2 0 0,0 17,3M19,11H5V15H19M5,17H19V21H5V17M7,5A1,1 0 0,0 6,6A1,1 0 0,0 7,7A1,1 0 0,0 8,6A1,1 0 0,0 7,5M7,12A1,1 0 0,0 6,13A1,1 0 0,0 7,14A1,1 0 0,0 8,13A1,1 0 0,0 7,12M7,18A1,1 0 0,0 6,19A1,1 0 0,0 7,20A1,1 0 0,0 8,19A1,1 0 0,0 7,18Z" /></svg>
                                {% else %}<svg viewBox="0 0 24 24"><path d="M4,1H20A1,1 0 0,1 21,2V6A1,1 0 0,1 20,7H4A1,1 0 0,1 3,6V2A1,1 0 0,1 4,1M4,9H20A1,1 0 0,1 21,10V14A1,1 0 0,1 20,15H4A1,1 0 0,1 3,14V10A1,1 0 0,1 4,9M4,17H20A1,1 0 0,1 21,18V22A1,1 0 0,1 20,23H4A1,1 0 0,1 3,22V18A1,1 0 0,1 4,17M9,5H10V3H9V5M9,13H10V11H9V13M9,21H10V19H9V21M5,3V5H7V3H5M5,11V13H7V11H5M5,19V21H7V19H5Z" /></svg>{% endif %}
                            </span>
                            <span class="qcd-svc-body">
                                <strong>{{ order.title|truncate(38) }}</strong>
                                <small>{{ order.service_type == 'domain' ? 'Domain'|trans : (order.service_type == 'hosting' ? 'Web Hosting'|trans : 'VPS / Server'|trans) }}{% if order.expires_at %} · {{ 'renews'|trans }} {{ order.expires_at|format_date(pattern="d MMM yyyy") }}{% endif %}</small>
                            </span>
                            <span class="qcd-chip ch-{{ order.status == 'active' ? 'ok' : (order.status == 'pending_setup' ? 'warn' : (order.status in ['suspended','failed_setup','failed_renew'] ? 'bad' : 'mute')) }}">{{ mf.status_name(order.status) }}</span>
                        </a>
                    {% endfor %}
                    </div>
                {% else %}
                    <div class="qcd-empty"><p>{{ 'No services yet — your next product is one order away.'|trans }}</p><a class="btn btn-primary btn-sm" href="{{ '/order'|link }}">{{ 'Browse products'|trans }}</a></div>
                {% endif %}
            </section>

            <section class="qcd-card qcd-overview">
                <div class="qcd-card-head"><h3>{{ 'Account Overview'|trans }}</h3><span class="qcd-link-btn is-static">{{ 'Last 6 months'|trans }}</span></div>
                <div class="qcd-total">
                    <small>{{ 'Total spending (paid invoices)'|trans }}</small>
                    <div class="qcd-total-row"><strong>{{ qc_spent_total|money(qc_currency) }}</strong>
                    {% if qc_delta is not null %}<span class="qcd-delta {{ qc_delta >= 0 ? 'up' : 'down' }}">{{ qc_delta >= 0 ? '↑' : '↓' }} {{ qc_delta|abs }}%</span>{% endif %}</div>
                </div>
                <svg class="qcd-chart" viewBox="0 0 280 96" preserveAspectRatio="none" aria-label="{{ 'Spending over the last 6 months'|trans }}">
                    <defs>
                        <linearGradient id="qcdFill" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#e31c64" stop-opacity="0.22"/>
                            <stop offset="100%" stop-color="#e31c64" stop-opacity="0"/>
                        </linearGradient>
                    </defs>
                    <polygon class="qcd-area" points="{{ qc_points }} 260,88 20,88" fill="url(#qcdFill)"/>
                    <polyline class="qcd-line" points="{{ qc_points|trim }}" fill="none" stroke="#e31c64" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                    {% for i, m in qc_months %}
                        {% set x = (i * 240 / 5)|round + 20 %}{% set y = (80 - (m.sum / qc_max) * 66)|round(1) %}
                        <circle cx="{{ x }}" cy="{{ y }}" r="3" fill="#e31c64" stroke="#fff" stroke-width="1.4"/>
                    {% endfor %}
                </svg>
                <div class="qcd-chart-x">{% for i, m in qc_months %}<span>{{ m.label }}</span>{% endfor %}</div>
            </section>

            <aside class="qcd-side">
                <section class="qcd-card qcd-activity">
                    <div class="qcd-card-head"><h3>{{ 'Recent Activity'|trans }}</h3></div>
                    {% if qc_feed_orders or qc_feed_paid %}
                        <ul class="qcd-act-list">
                        {% for order in qc_feed_orders %}
                            <li><span class="qcd-act-dot"></span><div><strong><a href="{{ ('order/service/manage'|link) ~ '/' ~ order.id }}">{{ order.title|truncate(44) }}</a></strong><small>{{ mf.status_name(order.status) }} · {{ order.updated_at|timeago }} {{ 'ago'|trans }}</small></div></li>
                        {% endfor %}
                        {% for inv in qc_feed_paid %}
                            <li><span class="qcd-act-dot d-green"></span><div><strong><a href="{{ 'invoice'|link }}">{{ 'Payment received'|trans }} — {{ inv.total|money(inv.currency) }}</a></strong><small>{{ 'Invoice paid'|trans }} · {{ inv.created_at|timeago }} {{ 'ago'|trans }}</small></div></li>
                        {% endfor %}
                        </ul>
                    {% else %}
                        <div class="qcd-empty"><p>{{ 'Nothing here yet — orders and payments will show up here.'|trans }}</p></div>
                    {% endif %}
                </section>

                <section class="qcd-card qcd-actions">
                    <div class="qcd-card-head"><h3>{{ 'Quick Actions'|trans }}</h3></div>
                    <div class="qcd-act-grid">
                        <a class="qcd-qa" href="{{ qc_store.url() }}/vps"><span class="qa-ic" style="--qac:#e31c64">＋</span>{{ 'Order VPS'|trans }}</a>
                        <a class="qcd-qa" href="{{ qc_store.url() }}/hosting"><span class="qa-ic" style="--qac:#3b82f6">⚡</span>{{ 'Order Hosting'|trans }}</a>
                        <a class="qcd-qa" href="{{ qc_store.url() }}/domains"><span class="qa-ic" style="--qac:#7c3aed">◎</span>{{ 'Register Domain'|trans }}</a>
                        <a class="qcd-qa" href="{{ '/client/balance'|link }}"><span class="qa-ic" style="--qac:#f59e0b">💳</span>{{ 'Top up Wallet'|trans }}</a>
                        <a class="qcd-qa" href="{{ 'support'|link({ 'ticket': 1 }) }}"><span class="qa-ic" style="--qac:#10b981">🎧</span>{{ 'Open Ticket'|trans }}</a>
                    </div>
                </section>

                {% if qc_news %}
                    <section class="qcd-card qcd-news">
                        <div class="qcd-card-head"><h3>📣 {{ 'Announcements'|trans }}</h3></div>
                        {% for post in qc_news %}
                            <a class="qcd-news-item" href="{{ '/news'|link }}/{{ post.slug }}">
                                <strong>{{ post.title }}</strong>
                                <small>{{ post.created_at|timeago }} {{ 'ago'|trans }}</small>
                            </a>
                        {% endfor %}
                    </section>
                {% endif %}
            </aside>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Topbar search -> live-filters the services list on this page.
        var input = document.querySelector('.qcd-topsearch input');
        var list = document.getElementById('qcdServiceList');
        if (input && list) {
            input.addEventListener('input', function () {
                var q = input.value.trim().toLowerCase();
                list.querySelectorAll('.qcd-svc').forEach(function (row) {
                    row.style.display = !q || row.dataset.name.indexOf(q) !== -1 ? '' : 'none';
                });
            });
            var form = input.closest('form');
            if (form) form.addEventListener('submit', function (e) { e.preventDefault(); });
        }
        // Active state for the rail links (matches current path).
        var path = window.location.pathname.replace(/\/$/, '') || '/';
        document.querySelectorAll('.qcd-rail .nav-link').forEach(function (a) {
            try {
                var href = new URL(a.href).pathname.replace(/\/$/, '') || '/';
                if (href === path) a.classList.add('qcd-active');
            } catch (e) {}
        });
    });
    </script>
{% else %}
    <div class="qcd-empty"><p>{{ 'Please sign in to view your dashboard.'|trans }}</p></div>
{% endif %}
{% endblock %}
