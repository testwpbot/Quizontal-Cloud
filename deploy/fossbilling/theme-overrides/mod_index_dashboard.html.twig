{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% block meta_title %}Dashboard{% endblock %}
{% block body_class %}dashboard qc-dashboard{% endblock %}
{% block breadcrumbs %}{% endblock %}
{% import "macro_functions.html.twig" as mf %}
{% block content %}
<style>
.qc-dashboard-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin:4px 0 24px}.qc-dashboard-head h1{font-size:30px;margin:0;color:var(--qc-text)}.qc-dashboard-head p{margin:6px 0 0;color:var(--qc-muted)}.qc-quick-actions{display:flex;gap:9px}.qc-notice{display:flex;align-items:center;gap:12px;padding:13px 15px;margin-bottom:9px;border:1px solid var(--qc-border);border-radius:11px;background:var(--qc-card);color:var(--qc-text);text-decoration:none}.qc-notice:hover{border-color:rgba(227,28,100,.55);color:var(--qc-text)}.qc-notice-icon{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;background:var(--qc-pink-soft);color:#ff6fa4}.qc-notice-icon svg{width:18px;fill:currentColor}.qc-notice-arrow{margin-left:auto;color:var(--qc-muted)}.qc-stat{height:100%;padding:20px;border:1px solid var(--qc-border);border-radius:14px;background:var(--qc-card);box-shadow:0 12px 30px rgba(0,0,0,.12)}.qc-stat-top{display:flex;align-items:center;justify-content:space-between}.qc-stat-icon{width:42px;height:42px;border-radius:11px;display:grid;place-items:center;background:var(--qc-pink-soft);color:#ff6fa4}.qc-stat-icon svg{width:21px;fill:currentColor}.qc-stat-label{color:var(--qc-muted);font-size:13px}.qc-stat-value{font-size:27px;font-weight:750;margin:12px 0 4px}.qc-stat-detail{display:flex;gap:12px;color:var(--qc-muted);font-size:12px}.qc-stat-wallet{background:linear-gradient(145deg,#27101b,var(--qc-card) 72%);border-color:rgba(227,28,100,.35)}.qc-section-card{border:1px solid var(--qc-border);border-radius:14px;background:var(--qc-card);overflow:hidden;height:100%}.qc-section-title{display:flex;align-items:center;justify-content:space-between;padding:17px 19px;border-bottom:1px solid var(--qc-border)}.qc-section-title h2{font-size:16px;margin:0}.qc-list-item{display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid var(--qc-border);color:var(--qc-text);text-decoration:none}.qc-list-item:last-child{border-bottom:0}.qc-list-item:hover{background:rgba(255,255,255,.02);color:var(--qc-text)}.qc-empty{padding:34px 20px;text-align:center;color:var(--qc-muted)}.qc-empty-icon{width:48px;height:48px;margin:0 auto 12px;border-radius:12px;display:grid;place-items:center;background:var(--qc-pink-soft);color:#ff6fa4}.qc-pill{padding:4px 9px;border-radius:99px;font-size:11px;font-weight:700}.qc-pill-open{background:#173627;color:#8ce7af}.qc-pill-hold{background:#3b311a;color:#efd27d}.qc-pill-closed{background:#292d35;color:#aeb4bf}@media(max-width:767px){.qc-dashboard-head{align-items:flex-start;flex-direction:column}.qc-dashboard-head h1{font-size:25px}.qc-quick-actions{width:100%}.qc-quick-actions .btn{flex:1}.qc-stat-value{font-size:23px}}
</style>
{% if client %}
{% set invoices = client.invoice_get_list() %}{% set paid_invoices = client.invoice_get_list({status:'paid'}) %}{% set unpaid_invoices = client.invoice_get_list({status:'unpaid'}) %}
{% set orders = client.order_get_list({hide_addons:1}) %}{% set active_orders = client.order_get_list({hide_addons:1,status:'active'}) %}{% set expiring_orders = client.order_get_list({expiring:1}) %}
{% set all_tickets = client.support_ticket_get_list() %}{% set open_tickets = client.support_ticket_get_list({status:'open'}) %}{% set hold_tickets = client.support_ticket_get_list({status:'on_hold'}) %}
{% set recent_orders = client.order_get_list({per_page:5,hide_addons:1}) %}{% set recent_tickets = client.support_ticket_get_list({per_page:5}) %}
<div class="qc-dashboard-head"><div><h1>{% if now|date('H') < 12 %}Good morning{% elseif now|date('H') < 18 %}Good afternoon{% else %}Good evening{% endif %}, {{ profile.first_name }}</h1><p>Here’s what’s happening with your cloud account.</p></div><div class="qc-quick-actions"><a class="btn btn-dark" href="{{ 'support'|link({ticket:1}) }}">Open ticket</a><a class="btn btn-primary" href="{{ 'order'|link }}">New order</a></div></div>
{% for ticket in hold_tickets.list %}<a class="qc-notice" href="{{ 'support/ticket'|link }}/{{ ticket.id }}"><span class="qc-notice-icon"><svg viewBox="0 0 24 24"><path d="M2 3h20v15H6l-4 4V3Zm5 5v2h10V8H7Zm0 4v2h7v-2H7Z"/></svg></span><span><strong>Ticket #{{ ticket.id }}</strong> received a reply {{ ticket.updated_at|timeago }} ago.</span><span class="qc-notice-arrow">View reply →</span></a>{% endfor %}
<div class="row g-3 mt-2 mb-4">
<div class="col-12 col-md-6 col-xl-3"><div class="qc-stat qc-stat-wallet"><div class="qc-stat-top"><span class="qc-stat-label">Wallet balance</span><span class="qc-stat-icon"><svg viewBox="0 0 24 24"><path d="M3 5h16v3h2v11H5a2 2 0 0 1-2-2V5Zm2 5v7h14v-7H5Zm10 2h3v3h-3v-3Z"/></svg></span></div><div class="qc-stat-value">{{ profile.balance|money(profile.currency) }}</div><a href="{{ 'client/balance'|link }}" class="small">Add funds →</a></div></div>
<div class="col-12 col-md-6 col-xl-3"><div class="qc-stat"><div class="qc-stat-top"><span class="qc-stat-label">Invoices</span><span class="qc-stat-icon"><svg viewBox="0 0 24 24"><path d="M4 2h16v20H4V2Zm4 5v2h8V7H8Zm0 4v2h8v-2H8Zm0 4v2h5v-2H8Z"/></svg></span></div><div class="qc-stat-value">{{ invoices.total }}</div><div class="qc-stat-detail"><span>{{ paid_invoices.total }} paid</span><span>{{ unpaid_invoices.total }} unpaid</span></div></div></div>
<div class="col-12 col-md-6 col-xl-3"><div class="qc-stat"><div class="qc-stat-top"><span class="qc-stat-label">Cloud services</span><span class="qc-stat-icon"><svg viewBox="0 0 24 24"><path d="M4 3h16a2 2 0 0 1 2 2v4H2V5a2 2 0 0 1 2-2Zm-2 8h20v4H2v-4Zm0 6h20v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-2Z"/></svg></span></div><div class="qc-stat-value">{{ active_orders.total }}</div><div class="qc-stat-detail"><span>{{ orders.total }} total</span><span>{{ expiring_orders.total }} expiring</span></div></div></div>
<div class="col-12 col-md-6 col-xl-3"><div class="qc-stat"><div class="qc-stat-top"><span class="qc-stat-label">Support tickets</span><span class="qc-stat-icon"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8 16l-2 4 4-2a10 10 0 1 0 6-18Zm-1 15H9v-2h2v2Zm2-5c-.8.5-1 1-1 1.5h-2c0-1.8.7-2.5 1.8-3.2.8-.5 1.2-1 1.2-1.6 0-.9-.7-1.5-1.7-1.5S9.6 7.7 9 8.5L7.5 7.3A4.7 4.7 0 0 1 11.4 5c2.2 0 3.8 1.4 3.8 3.5 0 1.6-.8 2.5-2.2 3.5Z"/></svg></span></div><div class="qc-stat-value">{{ all_tickets.total }}</div><div class="qc-stat-detail"><span>{{ open_tickets.total }} open</span><span>{{ hold_tickets.total }} on hold</span></div></div></div>
</div>
<div class="row g-3"><div class="col-12 col-lg-6"><div class="qc-section-card"><div class="qc-section-title"><h2>Recent orders</h2><a href="{{ 'order/service'|link }}" class="small">View all</a></div>{% for order in recent_orders.list %}<a class="qc-list-item" href="{{ 'order/service/manage'|link }}/{{ order.id }}"><div><strong>#{{ order.id }} · {{ order.title|truncate(38) }}</strong><div class="small text-muted">Updated {{ order.updated_at|timeago }} ago</div></div><span class="ms-auto qc-pill {% if order.status=='active' %}qc-pill-open{% elseif order.status=='pending_setup' %}qc-pill-hold{% else %}qc-pill-closed{% endif %}">{{ mf.status_name(order.status) }}</span></a>{% else %}<div class="qc-empty"><div class="qc-empty-icon">☁</div><strong>No recent orders</strong><div class="small mt-1">Your new cloud services will appear here.</div></div>{% endfor %}</div></div>
<div class="col-12 col-lg-6"><div class="qc-section-card"><div class="qc-section-title"><h2>Recent support tickets</h2><a href="{{ 'support'|link }}" class="small">View all</a></div>{% for ticket in recent_tickets.list %}<a class="qc-list-item" href="{{ 'support/ticket'|link }}/{{ ticket.id }}"><div><strong>#{{ ticket.id }} · {{ ticket.subject|truncate(38) }}</strong><div class="small text-muted">Updated {{ ticket.updated_at|timeago }} ago</div></div><span class="ms-auto qc-pill {% if ticket.status=='open' %}qc-pill-open{% elseif ticket.status=='on_hold' %}qc-pill-hold{% else %}qc-pill-closed{% endif %}">{{ mf.status_name(ticket.status) }}</span></a>{% else %}<div class="qc-empty"><div class="qc-empty-icon">?</div><strong>No support tickets</strong><div class="small mt-1">Need help? Open a ticket anytime.</div></div>{% endfor %}</div></div></div>
{% else %}<div class="qc-empty"><h2>Welcome to Quizontal Cloud</h2><p>Sign in to access your cloud dashboard.</p><a class="btn btn-primary" href="{{ 'login'|link }}">Sign in</a></div>{% endif %}
{% endblock %}
