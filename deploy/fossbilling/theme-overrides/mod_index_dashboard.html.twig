{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{# Quizontal Cloud — dark app-shell client dashboard.
   Every number, chart, table and feed is built from FOSSBilling's own
   client/guest APIs: orders, invoices, support tickets and news. Nothing
   is mocked, so the page always reflects the real account state. #}

{% block meta_title %}{{ 'Dashboard'|trans }}{% endblock %}
{% block body_class %}dashboard qc-has-banner{% endblock %}
{% block breadcrumbs %}{% endblock %}

{% import "macro_functions.html.twig" as mf %}
{% import "qc_storefront.html.twig" as qc_store %}

{% block banner %}
    {% if client %}
        <div class="iq-banner">
            <div class="iq-banner-art" aria-hidden="true"></div>
            <div class="container-fluid iq-container">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h1>{{ 'Hello'|trans }}, {{ profile.first_name }}</h1>
                        <p>{{ 'Welcome back to your hosting control panel. Everything you need is one click away.'|trans }}</p>
                        <span class="banner-date">
                            <svg fill="currentColor"><use href="#i-calendar"/></svg>
                            {{ "now"|format_date(pattern="EEEE, MMMM d, yyyy") }}
                        </span>
                    </div>
                    {% if guest.extension_is_on({ "mod": "news" }) %}
                        <div>
                            <a href="{{ '/news'|link }}" class="btn btn-soft-light d-inline-flex gap-2 align-items-center">
                                <svg width="16" height="16" fill="currentColor"><use href="#i-bell"/></svg>
                                {{ 'Announcements'|trans }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block content %}
{% if client %}
    {# ================= data gathering (all real, all from client APIs) ================= #}
    {% set qc_orders = client.order_get_list({ "per_page": 100, "hide_addons": 1 }).list %}
    {% set qc_domains = [] %}
    {% set qc_services = [] %}
    {% set qc_next = null %}
    {% for order in qc_orders %}
        {% if order.status == 'active' %}
            {% if order.service_type == 'domain' %}
                {% set qc_domains = qc_domains|merge([order]) %}
            {% else %}
                {% set qc_services = qc_services|merge([order]) %}
            {% endif %}
            {% if order.expires_at %}
                {% if qc_next is null or order.expires_at < qc_next %}
                    {% set qc_next = order.expires_at %}
                {% endif %}
            {% endif %}
        {% endif %}
    {% endfor %}

    {% set qc_unpaid = client.invoice_get_list({ "status": "unpaid", "per_page": 100 }).list %}
    {% set qc_paid = client.invoice_get_list({ "status": "paid", "per_page": 100 }).list %}
    {% set qc_due = 0 %}
    {% for inv in qc_unpaid %}{% set qc_due = qc_due + inv.total %}{% endfor %}
    {% set qc_paid_total = 0 %}
    {% for inv in qc_paid %}{% set qc_paid_total = qc_paid_total + inv.total %}{% endfor %}

    {% set qc_tickets = client.support_ticket_get_list({ "per_page": 50 }).list %}
    {% set qc_open_tickets = 0 %}
    {% for t in qc_tickets %}
        {% if t.status in ['open', 'on_hold'] %}
            {% set qc_open_tickets = qc_open_tickets + 1 %}
        {% endif %}
    {% endfor %}

    {# 12 monthly buckets (oldest -> newest). Pure date arithmetic — no
       date_modify dependency, works on FOSSBilling's stock Twig setup. #}
    {% set qc_nowY = "now"|date("Y") + 0 %}
    {% set qc_nowM = "now"|date("n") + 0 %}
    {% set qc_names = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
    {% set qc_months = [] %}
    {% for d in 11..0 %}
        {% set mm = qc_nowM - d %}
        {% if mm < 1 %}{% set mm = mm + 12 %}{% endif %}
        {% set qc_months = qc_months|merge([{ label: qc_names[mm - 1], sum: 0, pays: 0, acts: 0 }]) %}
    {% endfor %}
    {% for inv in qc_paid %}
        {% set invY = inv.created_at|date("Y") + 0 %}
        {% set invM = inv.created_at|date("n") + 0 %}
        {% set diff = (qc_nowY - invY) * 12 + (qc_nowM - invM) %}
        {% if diff >= 0 and diff <= 11 %}
            {% set bi = 11 - diff %}
            {% set qc_months = qc_months|merge({ (bi): qc_months[bi]|merge({ sum: qc_months[bi].sum + inv.total, pays: qc_months[bi].pays + 1 }) }) %}
        {% endif %}
    {% endfor %}
    {% for order in qc_orders %}
        {% set ordY = order.updated_at|date("Y") + 0 %}
        {% set ordM = order.updated_at|date("n") + 0 %}
        {% set diff = (qc_nowY - ordY) * 12 + (qc_nowM - ordM) %}
        {% if diff >= 0 and diff <= 11 %}
            {% set bi = 11 - diff %}
            {% set qc_months = qc_months|merge({ (bi): qc_months[bi]|merge({ acts: qc_months[bi].acts + 1 }) }) %}
        {% endif %}
    {% endfor %}

    {% set qc_lbl = [] %}{% set qc_sum = [] %}{% set qc_pay = [] %}{% set qc_act = [] %}
    {% set qc_max_mix = 1 %}
    {% set qc_year_orders = 0 %}{% set qc_year_pays = 0 %}
    {% for m in qc_months %}
        {% set qc_lbl = qc_lbl|merge([m.label]) %}
        {% set qc_sum = qc_sum|merge([m.sum]) %}
        {% set qc_pay = qc_pay|merge([m.pays]) %}
        {% set qc_act = qc_act|merge([m.acts]) %}
        {% if (m.acts + m.pays) > qc_max_mix %}{% set qc_max_mix = m.acts + m.pays %}{% endif %}
        {% set qc_year_pays = qc_year_pays + m.pays %}
    {% endfor %}
    {% set qc_year_orders = 0 %}
    {% for m in qc_months %}{% set qc_year_orders = qc_year_orders + m.acts %}{% endfor %}

    {# health ring values (all real ratios) #}
    {% set qc_total_orders = qc_orders|length > 0 ? qc_orders|length : 1 %}
    {% set qc_total_tickets = qc_tickets|length > 0 ? qc_tickets|length : 1 %}
    {% set qc_money_seen = (qc_paid_total + qc_due) > 0 ? (qc_paid_total + qc_due) : 1 %}
    {% set qc_ring_svc = ((qc_services|length / qc_total_orders) * 100)|round %}
    {% set qc_ring_dom = ((qc_domains|length / qc_total_orders) * 100)|round %}
    {% set qc_ring_due = ((qc_due / qc_money_seen) * 100)|round %}
    {% set qc_ring_tkt = ((qc_open_tickets / qc_total_tickets) * 100)|round %}

    {# billing overview radial: share of invoices already settled #}
    {% set qc_inv_seen = (qc_paid|length + qc_unpaid|length) %}
    {% set qc_bill_pct = qc_inv_seen > 0 ? (((qc_paid|length) / qc_inv_seen) * 100)|round : 100 %}

    {# recent activity lanes: latest orders + payments + one ticket #}
    {% set qc_feed_orders = qc_orders|slice(0, 2) %}
    {% set qc_feed_paid = qc_paid|slice(0, 2) %}
    {% set qc_feed_ticket = qc_tickets|slice(0, 1) %}
    {% set qc_currency = profile.currency %}

    {% set qc_onhold = client.support_ticket_get_list({ "status": 'on_hold', "per_page": 5 }).list %}

    {# ================= stat slider ================= #}
    <div class="row">
        <div class="col-md-12">
            <ul class="p-0 m-0 mb-2 list-inline d-flex gap-3 overflow-auto slider-list">
                <li class="card card-slide">
                    <div class="card-body">
                        <div class="progress-widget">
                            <div class="circle-progress" style="--val:{{ qc_ring_svc }}">
                                <span class="circle-inner"><svg fill="currentColor"><use href="#i-folder"/></svg></span>
                            </div>
                            <div class="progress-detail">
                                <p class="mb-2">{{ 'Active Services'|trans }}</p>
                                <h4>{{ qc_services|length }}</h4>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="card card-slide">
                    <div class="card-body">
                        <div class="progress-widget">
                            <div class="circle-progress circle-progress-info" style="--val:{{ qc_ring_dom }}">
                                <span class="circle-inner"><svg fill="currentColor"><use href="#i-globe"/></svg></span>
                            </div>
                            <div class="progress-detail">
                                <p class="mb-2">{{ 'Active Domains'|trans }}</p>
                                <h4>{{ qc_domains|length }}</h4>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="card card-slide">
                    <div class="card-body">
                        <div class="progress-widget">
                            <div class="circle-progress circle-progress-warning" style="--val:{{ qc_ring_due }}">
                                <span class="circle-inner"><svg fill="currentColor"><use href="#i-wallet"/></svg></span>
                            </div>
                            <div class="progress-detail">
                                <p class="mb-2">{{ 'Amount Due'|trans }}</p>
                                <h4>{{ qc_due|money(qc_currency) }}</h4>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="card card-slide">
                    <div class="card-body">
                        <div class="progress-widget">
                            <div class="circle-progress circle-progress-success" style="--val:{{ qc_ring_tkt }}">
                                <span class="circle-inner"><svg fill="currentColor"><use href="#i-chat"/></svg></span>
                            </div>
                            <div class="progress-detail">
                                <p class="mb-2">{{ 'Open Tickets'|trans }}</p>
                                <h4>{{ qc_open_tickets }}</h4>
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    {% if settings.showcase_enabled %}
        <div class="alert alert-info" role="alert">
            <p class="mb-1">{{ settings.showcase_text|markdown }}</p>
            {% if (settings.showcase_button_url) and (settings.showcase_button_title) %}
                <a class="btn btn-primary btn-sm" href="{{ settings.showcase_button_url }}">{{ settings.showcase_button_title }}</a>
            {% endif %}
        </div>
    {% endif %}

    {% for ticket in qc_onhold %}
        <div class="alert alert-info d-flex justify-content-between align-items-center" role="alert">
            <span>{{ 'Ticket'|trans }} <strong>#{{ ticket.id }}</strong> {{ 'was replied to'|trans }} {{ ticket.updated_at|timeago }} {{ 'ago'|trans }}.</span>
            <a href="{{ 'support/ticket'|link }}/{{ ticket.id }}" class="alert-link">{{ 'Reply'|trans }}</a>
        </div>
    {% endfor %}

    {# ================= spending chart + billing overview ================= #}
    <div class="row g-3 mb-3">
        <div class="col-xxl-8">
            <div class="card h-100">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="header-title">
                        <h4 class="card-title">{{ 'Your Spending'|trans }}</h4>
                        <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'Paid invoices, month by month'|trans }}</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="chart-tabs" id="qcSpendTabs">
                            <button type="button" data-range="12" class="active">{{ 'Yearly'|trans }}</button>
                            <button type="button" data-range="6">{{ '6 Months'|trans }}</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="qc-spend-chart"></div>
                </div>
            </div>
        </div>
        <div class="col-xxl-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="header-title">
                        <h4 class="card-title">{{ 'Billing Overview'|trans }}</h4>
                        <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'How much of your billing is settled'|trans }}</p>
                    </div>
                </div>
                <div class="card-body">
                    <div id="qc-billing-chart"></div>
                    <div class="mt-2">
                        <div class="earning-legend mb-2">
                            <span class="d-inline-flex align-items-center gap-2"><span class="dot" style="background:var(--iq-primary)"></span><span class="label">{{ 'Paid'|trans }}</span></span>
                            <span class="value">{{ qc_paid_total|money(qc_currency) }}</span>
                        </div>
                        <div class="earning-legend mb-3">
                            <span class="d-inline-flex align-items-center gap-2"><span class="dot" style="background:var(--iq-warning)"></span><span class="label">{{ 'Outstanding'|trans }}</span></span>
                            <span class="value">{{ qc_due|money(qc_currency) }}</span>
                        </div>
                        <div class="iq-progress mb-2"><div class="progress-bar" style="width:{{ qc_bill_pct }}%"></div></div>
                        <p class="text-size-12 mb-0" style="color:#98a1b3">{{ 'Wallet balance'|trans }}: <strong class="text-primary">{{ profile.balance|money(qc_currency) }}</strong> {{ 'ready for renewals'|trans }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ================= activity bars + services table ================= #}
    <div class="row g-3 mb-3">
        <div class="col-xxl-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="header-title">
                        <h4 class="card-title">{{ 'Activity Overview'|trans }}</h4>
                        <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'Service events and payments, last 12 months'|trans }}</p>
                    </div>
                </div>
                <div class="card-body">
                    <div id="qc-activity-chart"></div>
                </div>
            </div>
        </div>
        <div class="col-xxl-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="header-title">
                        <h4 class="card-title">{{ 'Your Services'|trans }}</h4>
                        <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'Products on your account'|trans }}</p>
                    </div>
                    <a href="{{ 'order/service'|link }}" class="link-primary text-size-12 text-decoration-none fw-medium">{{ 'View All'|trans }}</a>
                </div>
                <div class="card-body">
                    {% if qc_orders %}
                        <div class="table-responsive">
                            <table class="table table-layout-flat" id="qcServiceTable">
                                <thead>
                                    <tr>
                                        <th>{{ 'Service'|trans }}</th>
                                        <th>{{ 'Type'|trans }}</th>
                                        <th>{{ 'Price'|trans }}</th>
                                        <th>{{ 'Next Renewal'|trans }}</th>
                                        <th>{{ 'Status'|trans }}</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for order in qc_orders|slice(0, 5) %}
                                    <tr data-name="{{ order.title|lower }}">
                                        <td>
                                            <div class="service-cell">
                                                <span class="service-ico {{ order.service_type == 'domain' ? 'bg-soft-info' : (order.service_type == 'hosting' ? 'bg-soft-primary' : 'bg-soft-warning') }}">
                                                    {% if order.service_type == 'domain' %}<svg fill="currentColor"><use href="#i-globe"/></svg>
                                                    {% elseif order.service_type == 'hosting' %}<svg fill="currentColor"><use href="#i-folder"/></svg>
                                                    {% else %}<svg fill="currentColor"><use href="#i-activity"/></svg>{% endif %}
                                                </span>
                                                <div>
                                                    <div class="service-name">{{ order.title|truncate(30) }}</div>
                                                    <div class="service-sub">#{{ order.id }}</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-size-12">{{ order.service_type == 'domain' ? 'Domain'|trans : (order.service_type == 'hosting' ? 'Web Hosting'|trans : 'Service'|trans) }}</td>
                                        <td class="fw-medium" style="color:var(--iq-heading)">{{ order.total|money(order.currency) }}{% if order.period %} · {{ order.period|period_title }}{% endif %}</td>
                                        <td class="text-size-12">{% if order.expires_at %}{{ order.expires_at|format_date(pattern="MMM d, yyyy") }}{% else %}—{% endif %}</td>
                                        <td>
                                            {% if order.status == 'active' %}
                                                <span class="iq-badge bg-soft-success"><span class="iq-badge-dot"></span>{{ mf.status_name(order.status) }}</span>
                                            {% elseif order.status == 'pending_setup' %}
                                                <span class="iq-badge bg-soft-warning"><span class="iq-badge-dot"></span>{{ mf.status_name(order.status) }}</span>
                                            {% elseif order.status in ['suspended', 'failed_setup', 'failed_renew'] %}
                                                <span class="iq-badge bg-soft-danger"><span class="iq-badge-dot"></span>{{ mf.status_name(order.status) }}</span>
                                            {% else %}
                                                <span class="iq-badge" style="background:#1e1e24;color:#9aa3b2"><span class="iq-badge-dot"></span>{{ mf.status_name(order.status) }}</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a class="iq-menu-bt" style="width:28px;height:28px" href="{{ '/order/service/manage'|link }}/{{ order.id }}" title="{{ 'Manage'|trans }}" aria-label="{{ 'Manage'|trans }}">
                                                <svg width="14" height="14" fill="currentColor"><use href="#i-chevron"/></svg>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="qcd-empty">
                            <p>{{ 'No services yet — your next product is one order away.'|trans }}</p>
                            <a class="btn btn-primary btn-sm" href="{{ '/order'|link }}">{{ 'Browse products'|trans }}</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# ================= wallet + mini bars + recent activity ================= #}
    <div class="row g-3">
        <div class="col-xxl-4 col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="header-title">
                        <h4 class="card-title">{{ 'Wallet'|trans }}</h4>
                        <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'Prepaid credit on your account'|trans }}</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="credit-card-3d mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-4 position-relative">
                            <span class="card-brand">QUIZONTAL</span>
                            <span class="card-chip"></span>
                        </div>
                        <div class="card-number mb-1 position-relative text-size-12" style="color:rgba(255,255,255,.65);letter-spacing:.14em;text-transform:uppercase">{{ 'Current Balance'|trans }}</div>
                        <div class="mb-4 position-relative" style="font-size:1.5rem;font-weight:700">{{ profile.balance|money(qc_currency) }}</div>
                        <div class="d-flex justify-content-between align-items-end position-relative">
                            <div>
                                <div class="text-size-12" style="color:rgba(255,255,255,.65);letter-spacing:.1em;text-transform:uppercase">{{ 'Holder'|trans }}</div>
                                <div style="font-weight:600">{{ profile.first_name }} {{ profile.last_name }}</div>
                            </div>
                            <div>
                                <div class="text-size-12" style="color:rgba(255,255,255,.65);letter-spacing:.1em;text-transform:uppercase">{{ 'Currency'|trans }}</div>
                                <div style="font-weight:600">{{ profile.currency }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-size-12" style="color:#98a1b3">
                            {% if qc_next %}{{ 'Next renewal'|trans }} <strong style="color:var(--iq-heading)">{{ qc_next|format_date(pattern="MMM d") }}</strong>{% else %}{{ 'No renewals scheduled'|trans }}{% endif %}
                        </span>
                        {% if profile.balance > 0 %}
                            <span class="iq-badge bg-soft-success"><span class="iq-badge-dot"></span>{{ 'Funded'|trans }}</span>
                        {% else %}
                            <span class="iq-badge" style="background:#1e1e24;color:#9aa3b2"><span class="iq-badge-dot"></span>{{ 'Empty'|trans }}</span>
                        {% endif %}
                    </div>
                    <a class="btn btn-outline-primary w-100" href="{{ '/client/balance'|link }}">{{ 'Add Funds'|trans }}</a>
                </div>
            </div>
        </div>
        <div class="col-xxl-4 col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="header-title">
                        <h4 class="card-title">{{ 'Account Pulse'|trans }}</h4>
                        <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'Activity and payments, last 12 months'|trans }}</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-end gap-3 mb-3">
                        <div>
                            <div class="stat-value">{{ qc_year_orders + qc_year_pays }}</div>
                            <div class="stat-label">{{ 'Events in the last 12 months'|trans }}</div>
                        </div>
                    </div>
                    <div class="mini-bars mb-3">
                        {% for i, m in qc_months %}
                            {% set mix = m.acts + m.pays %}
                            <div class="mini-bar{% if i % 2 == 1 %} alt{% endif %}" style="height:{{ ((mix / qc_max_mix) * 100)|round }}%" title="{{ m.label }}: {{ mix }}"></div>
                        {% endfor %}
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="d-inline-flex align-items-center gap-2 text-size-12"><span class="dot" style="width:9px;height:9px;border-radius:3px;background:var(--iq-primary);display:inline-block"></span>{{ 'Service events'|trans }}</span>
                        <span class="d-inline-flex align-items-center gap-2 text-size-12"><span class="dot" style="width:9px;height:9px;border-radius:3px;background:var(--iq-secondary);display:inline-block"></span>{{ 'Payments'|trans }}</span>
                        <span class="text-size-12 fw-medium" style="color:var(--iq-heading)">{{ qc_year_pays }}</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="header-title">
                        <h4 class="card-title">{{ 'Recent Activity'|trans }}</h4>
                        <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'Latest operations on your account'|trans }}</p>
                    </div>
                    <a href="{{ '/invoice'|link }}" class="link-primary text-size-12 text-decoration-none fw-medium">{{ 'Invoices'|trans }}</a>
                </div>
                <div class="card-body">
                    {% if qc_feed_orders or qc_feed_paid or qc_feed_ticket %}
                        <ul class="d-activity-widget">
                            {% for order in qc_feed_orders %}
                                <li>
                                    <span class="activity-ico bg-soft-primary"><svg fill="currentColor"><use href="#i-activity"/></svg></span>
                                    <div class="activity-text">
                                        <a href="{{ '/order/service/manage'|link }}/{{ order.id }}" class="text-decoration-none"><strong>{{ order.title|truncate(34) }}</strong></a>
                                        — {{ mf.status_name(order.status) }}
                                        <div class="activity-time">{{ order.updated_at|timeago }} {{ 'ago'|trans }}</div>
                                    </div>
                                </li>
                            {% endfor %}
                            {% for inv in qc_feed_paid %}
                                <li>
                                    <span class="activity-ico bg-soft-success"><svg fill="currentColor"><use href="#i-wallet"/></svg></span>
                                    <div class="activity-text">
                                        <a href="{{ '/invoice'|link }}" class="text-decoration-none"><strong>{{ 'Payment received'|trans }}</strong></a>
                                        — {{ inv.total|money(inv.currency) }}
                                        <div class="activity-time">{{ inv.created_at|timeago }} {{ 'ago'|trans }}</div>
                                    </div>
                                </li>
                            {% endfor %}
                            {% for ticket in qc_feed_ticket %}
                                <li>
                                    <span class="activity-ico bg-soft-warning"><svg fill="currentColor"><use href="#i-chat"/></svg></span>
                                    <div class="activity-text">
                                        <a href="{{ 'support/ticket'|link }}/{{ ticket.id }}" class="text-decoration-none"><strong>{{ 'Ticket'|trans }} #{{ ticket.id }}</strong></a>
                                        — {{ mf.status_name(ticket.status) }}
                                        <div class="activity-time">{{ ticket.updated_at|timeago }} {{ 'ago'|trans }}</div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <div class="qcd-empty"><p>{{ 'Nothing here yet — orders and payments will show up here.'|trans }}</p></div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# ================= charts + live search ================= #}
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.54.1/dist/apexcharts.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Topbar search -> live-filters the services table on this page.
        var input = document.querySelector('.search-box input');
        var table = document.getElementById('qcServiceTable');
        if (input && table) {
            input.addEventListener('input', function () {
                var q = input.value.trim().toLowerCase();
                table.querySelectorAll('tbody tr').forEach(function (row) {
                    row.style.display = !q || (row.dataset.name || '').indexOf(q) !== -1 ? '' : 'none';
                });
            });
        }

        if (typeof ApexCharts === 'undefined') return; // CDN offline -> leave cards clean

        var PINK = '#E31C64', CYAN = '#22d3ee';
        var axisStyle = { colors: '#9aa0ac', fontSize: '12px', fontWeight: 500 };
        var lbl = {{ qc_lbl|json_encode|raw }};
        var sum = {{ qc_sum|json_encode|raw }};
        var pays = {{ qc_pay|json_encode|raw }};
        var acts = {{ qc_act|json_encode|raw }};

        var spendOptions = {
            series: [{ name: {{ 'Spent'|trans|json_encode|raw }}, data: sum }],
            chart: { height: 340, type: 'area', toolbar: { show: false }, fontFamily: 'Inter, sans-serif' },
            colors: [PINK],
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 4 },
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1, opacityFrom: 0.35, opacityTo: 0.02, stops: [0, 95, 100],
                    colorStops: [
                        { offset: 0, color: PINK, opacity: 0.35 },
                        { offset: 100, color: PINK, opacity: 0.02 }
                    ]
                }
            },
            markers: { size: 0, hover: { size: 6 } },
            grid: { borderColor: 'rgba(255,255,255,0.06)', strokeDashArray: 4, padding: { left: 8, right: 8 } },
            xaxis: { categories: lbl, axisBorder: { show: false }, axisTicks: { show: false }, labels: { style: axisStyle } },
            yaxis: { labels: { style: axisStyle, formatter: function (v) { return Math.round(v * 100) / 100; } } },
            tooltip: { theme: 'dark', y: { formatter: function (v) { return Math.round(v * 100) / 100; } } }
        };
        var spendEl = document.querySelector('#qc-spend-chart');
        var spendChart = spendEl ? new ApexCharts(spendEl, spendOptions) : null;
        if (spendChart) spendChart.render();

        var tabs = document.querySelectorAll('#qcSpendTabs button');
        tabs.forEach(function (btn) {
            btn.addEventListener('click', function () {
                tabs.forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                if (!spendChart) return;
                if (btn.getAttribute('data-range') === '6') {
                    spendChart.updateOptions({ xaxis: { categories: lbl.slice(6) } }, false, false);
                    spendChart.updateSeries([{ name: {{ 'Spent'|trans|json_encode|raw }}, data: sum.slice(6) }]);
                } else {
                    spendChart.updateOptions({ xaxis: { categories: lbl } }, false, false);
                    spendChart.updateSeries([{ name: {{ 'Spent'|trans|json_encode|raw }}, data: sum }]);
                }
            });
        });

        var billPct = {{ qc_bill_pct }};
        var billOptions = {
            series: [billPct],
            chart: { height: 275, type: 'radialBar', fontFamily: 'Inter, sans-serif' },
            colors: [PINK],
            plotOptions: {
                radialBar: {
                    hollow: { size: '62%' },
                    track: { background: '#1d1d22', strokeWidth: '100%' },
                    dataLabels: {
                        name: { show: false },
                        value: { show: true, fontSize: '30px', fontWeight: '700', color: '#f5f6f8', offsetY: 2, formatter: function (v) { return Math.round(v) + '%'; } }
                    }
                }
            },
            stroke: { lineCap: 'round' },
            labels: [{{ 'Settled'|trans|json_encode|raw }}]
        };
        var billEl = document.querySelector('#qc-billing-chart');
        if (billEl) new ApexCharts(billEl, billOptions).render();

        var activityOptions = {
            series: [
                { name: {{ 'Service events'|trans|json_encode|raw }}, data: acts },
                { name: {{ 'Payments'|trans|json_encode|raw }}, data: pays }
            ],
            chart: { type: 'bar', height: 330, stacked: true, toolbar: { show: false }, fontFamily: 'Inter, sans-serif' },
            plotOptions: {
                bar: { horizontal: false, columnWidth: '38%', borderRadius: 4, borderRadiusApplication: 'end' }
            },
            colors: [PINK, CYAN],
            dataLabels: { enabled: false },
            fill: { opacity: 1 },
            legend: {
                position: 'bottom', horizontalAlign: 'center', fontSize: '12px', fontWeight: 500,
                labels: { colors: '#9ca3af' },
                markers: { width: 10, height: 10, radius: 10, strokeWidth: 0 },
                itemMargin: { horizontal: 12 }
            },
            grid: { borderColor: 'rgba(255,255,255,0.06)', strokeDashArray: 4 },
            xaxis: { categories: lbl, axisBorder: { show: false }, axisTicks: { show: false }, labels: { style: axisStyle } },
            yaxis: { labels: { style: axisStyle, formatter: function (v) { return Math.floor(v) === v ? v : Math.round(v); } } },
            tooltip: { theme: 'dark' }
        };
        var activityEl = document.querySelector('#qc-activity-chart');
        if (activityEl) new ApexCharts(activityEl, activityOptions).render();
    });
    </script>
{% else %}
    <div class="qcd-empty"><p>{{ 'Please sign in to view your dashboard.'|trans }}</p></div>
{% endif %}
{% endblock %}
