{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'My Products & Services'|trans }}{% endblock %}

{% block body_class %}order-list qc-has-banner{% endblock %}

{% block breadcrumbs %}{% endblock %}

{% block banner %}
    <div class="iq-banner">
        <div class="iq-banner-art" aria-hidden="true"></div>
        <div class="container-fluid iq-container">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <h1>{{ 'My Products & Services'|trans }}</h1>
                    <p>{{ 'Everything on your account — servers, hosting and domains — in one place.'|trans }}</p>
                </div>
                <div>
                    <a href="{{ '/order'|link }}" class="btn btn-soft-light d-inline-flex gap-2 align-items-center">
                        <svg width="16" height="16" fill="currentColor"><use href="#i-buy"/></svg>
                        {{ 'Order new service'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
{% if client %}
    {# ================= data gathering (all real, from client APIs) ================= #}
    {% set qc_all = client.order_get_list({ "per_page": 100, "hide_addons": 1 }).list %}
    {% set qc_domains = [] %}
    {% set qc_services = [] %}
    {% set qc_next = null %}
    {% for order in qc_all %}
        {% if order.status == 'active' %}
            {% if order.service_type == 'domain' %}
                {% set qc_domains = qc_domains|merge([order]) %}
            {% else %}
                {% set qc_services = qc_services|merge([order]) %}
            {% endif %}
            {% if order.expires_at %}
                {% if qc_next is null or order.expires_at < qc_next %}
                    {% set qc_next = order.expires_at %}
                {% endif %}
            {% endif %}
        {% endif %}
    {% endfor %}

    {% set qc_unpaid = client.invoice_get_list({ "status": "unpaid", "per_page": 100 }).list %}
    {% set qc_due = 0 %}
    {% for inv in qc_unpaid %}{% set qc_due = qc_due + inv.total %}{% endfor %}

    {% set qc_tickets = client.support_ticket_get_list({ "per_page": 50 }).list %}
    {% set qc_open_tickets = 0 %}
    {% for t in qc_tickets %}
        {% if t.status in ['open', 'on_hold'] %}
            {% set qc_open_tickets = qc_open_tickets + 1 %}
        {% endif %}
    {% endfor %}

    {% set qc_currency = profile.currency %}
    {% set qc_total_orders = qc_all|length > 0 ? qc_all|length : 1 %}
    {% set qc_total_tickets = qc_tickets|length > 0 ? qc_tickets|length : 1 %}
    {% set qc_ring_svc = ((qc_services|length / qc_total_orders) * 100)|round %}
    {% set qc_ring_dom = ((qc_domains|length / qc_total_orders) * 100)|round %}
    {% set qc_ring_due = ((qc_due / (qc_due + 1)) * 100)|round %}
    {% set qc_ring_tkt = ((qc_open_tickets / qc_total_tickets) * 100)|round %}

    {% set orders = client.order_get_list({"per_page":10, "page":request.page, "hide_addons":1}) %}

    {# ================= stat cards ================= #}
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress" style="--val:{{ qc_ring_svc }}">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-folder"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Active Services'|trans }}</p>
                            <h4>{{ qc_services|length }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress circle-progress-info" style="--val:{{ qc_ring_dom }}">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-globe"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Active Domains'|trans }}</p>
                            <h4>{{ qc_domains|length }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress circle-progress-warning" style="--val:{{ qc_ring_due }}">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-wallet"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Amount Due'|trans }}</p>
                            <h4>{{ qc_due|money(qc_currency) }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress circle-progress-success" style="--val:{{ qc_ring_tkt }}">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-chat"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Open Tickets'|trans }}</p>
                            <h4>{{ qc_open_tickets }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ================= services table ================= #}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="header-title">
                <h4 class="card-title">{{ 'Your Services'|trans }}</h4>
                <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'All of your orders are displayed here. Click on any service to get full information about it.'|trans }}</p>
            </div>
            <a href="{{ '/order'|link }}" class="link-primary text-size-12 text-decoration-none fw-medium">{{ 'Order More'|trans }}</a>
        </div>
        <div class="card-body">
            {% if orders.list %}
                <div class="table-responsive">
                    <table class="table table-layout-flat">
                        <thead>
                            <tr>
                                <th>{{ 'Service'|trans }}</th>
                                <th>{{ 'Type'|trans }}</th>
                                <th>{{ 'Price'|trans }}</th>
                                <th>{{ 'Next Renewal'|trans }}</th>
                                <th>{{ 'Status'|trans }}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for order in orders.list %}
                            {% set qc_setup = false %}
                            {% if order.service_type == 'interserver' and order.service_id and order.status == 'active' and not order.unpaid_invoice_id %}
                                {% set qc_service = client.order_service({ 'id': order.id }) %}
                                {% if qc_service is not empty and qc_service.provisioning_state is defined and qc_service.provisioning_state != 'active' %}
                                    {% set qc_setup = true %}
                                {% endif %}
                            {% endif %}
                            <tr>
                                <td>
                                    <div class="service-cell">
                                        <span class="service-ico {{ order.service_type == 'domain' ? 'bg-soft-info' : (order.service_type == 'hosting' ? 'bg-soft-primary' : 'bg-soft-warning') }}">
                                            {% if order.service_type == 'domain' %}<svg fill="currentColor"><use href="#i-globe"/></svg>
                                            {% elseif order.service_type == 'hosting' %}<svg fill="currentColor"><use href="#i-folder"/></svg>
                                            {% else %}<svg fill="currentColor"><use href="#i-activity"/></svg>{% endif %}
                                        </span>
                                        <div>
                                            <div class="service-name">{{ order.title|truncate(30) }}</div>
                                            <div class="service-sub">#{{ order.id }}{% if qc_setup %} · {{ 'Usually ready within 30 minutes of payment'|trans }}{% endif %}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-size-12">{{ order.service_type == 'domain' ? 'Domain'|trans : (order.service_type == 'hosting' ? 'Web Hosting'|trans : 'Service'|trans) }}</td>
                                <td class="fw-medium" style="color:var(--iq-heading)">{{ order.total|money(order.currency) }}{% if order.period %} · {{ order.period|period_title }}{% endif %}</td>
                                <td class="text-size-12">{% if order.expires_at %}{{ order.expires_at|format_date(pattern="MMM d, yyyy") }}{% else %}—{% endif %}</td>
                                <td>
                                    {% if qc_setup %}
                                        <span class="iq-badge bg-soft-warning"><span class="iq-badge-dot"></span>{{ 'Setting up'|trans }}</span>
                                    {% elseif order.status == 'active' %}
                                        <span class="iq-badge bg-soft-success"><span class="iq-badge-dot"></span>{{ mf.status_name(order.status) }}</span>
                                    {% elseif order.status == 'pending_setup' %}
                                        <span class="iq-badge bg-soft-warning"><span class="iq-badge-dot"></span>{{ mf.status_name(order.status) }}</span>
                                    {% elseif order.status in ['suspended', 'failed_setup', 'failed_renew'] %}
                                        <span class="iq-badge bg-soft-danger"><span class="iq-badge-dot"></span>{{ mf.status_name(order.status) }}</span>
                                    {% else %}
                                        <span class="iq-badge" style="background:#1e1e24;color:#9aa3b2"><span class="iq-badge-dot"></span>{{ mf.status_name(order.status) }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a class="iq-menu-bt" style="width:28px;height:28px" href="{{ '/order/service/manage'|link }}/{{ order.id }}" title="{{ 'Manage'|trans }}" aria-label="{{ 'Manage'|trans }}">
                                        <svg width="14" height="14" fill="currentColor"><use href="#i-chevron"/></svg>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="d-flex justify-content-center my-2 py-4">
                    <span class="m-0" style="color:var(--iq-body)">{{ 'No orders yet'|trans }}</span>
                </div>
            {% endif %}
            {{ include('partial_pagination.html.twig', { 'list': orders }) }}
        </div>
    </div>
{% else %}
    <div class="qcd-empty"><p>{{ 'Please sign in to view your services.'|trans }}</p></div>
{% endif %}
{% endblock %}
