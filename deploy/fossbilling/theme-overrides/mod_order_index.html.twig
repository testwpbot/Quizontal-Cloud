{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'order' %}

{% block meta_title %}{{ 'Order'|trans }}{% endblock %}
{% block meta_description %}{{ 'Configure and place your order online.'|trans }}{% endblock %}

{% set loader_nr = request.loader|default("8")%}
{% set loader_url = ('img/assets/loaders/loader'~loader_nr~'.gif') %}

{% block body_class %}order-index{% if client %} qc-has-banner{% endif %}{% endblock %}
{% block breadcrumbs %}{% endblock %}

{# active slide: config -> account (guest) -> checkout #}
{% set qc_active = 'config' %}
{% if request.checkout %}
    {% set qc_active = client ? 'checkout' : 'account' %}
{% endif %}

{% block banner %}
    <div class="iq-banner">
        <div class="iq-banner-art" aria-hidden="true"></div>
        <div class="container-fluid iq-container">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <h1>{{ 'Order'|trans }}</h1>
                    <p>{{ 'Configure your service and check out in a few steps.'|trans }}</p>
                </div>
                <div class="qc-currency-wrap">
                    {{ include('mod_orderbutton_currency.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    {# ================= checkout stepper ================= #}
    <div class="qc-stepper mb-3" id="qc-stepper">
        <div class="qc-stepper-step {{ qc_active == 'config' ? 'active' : (qc_active in ['account','checkout'] ? 'done' : '') }}" data-qc-step="config">
            <span class="qc-stepper-dot">{% if qc_active in ['account','checkout'] %}<svg fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z"/></svg>{% else %}1{% endif %}</span>
            <span class="qc-stepper-label">{{ 'Configuration'|trans }}</span>
        </div>
        <span class="qc-stepper-line {{ qc_active in ['account','checkout'] ? 'done' : '' }}"></span>

        {% if not client %}
        <div class="qc-stepper-step {{ qc_active == 'account' ? 'active' : (qc_active == 'checkout' ? 'done' : '') }}" data-qc-step="account">
            <span class="qc-stepper-dot">{% if qc_active == 'checkout' %}<svg fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z"/></svg>{% else %}2{% endif %}</span>
            <span class="qc-stepper-label">{{ 'Account'|trans }}</span>
        </div>
        <span class="qc-stepper-line {{ qc_active == 'checkout' ? 'done' : '' }}"></span>
        {% endif %}

        <div class="qc-stepper-step {{ qc_active == 'checkout' ? 'active' : '' }}" data-qc-step="checkout">
            <span class="qc-stepper-dot">{{ client ? 2 : 3 }}</span>
            <span class="qc-stepper-label">{{ 'Checkout'|trans }}</span>
        </div>
    </div>

    <div class="qc-order-shell">
        {{ include('mod_orderbutton_index.html.twig') }}
    </div>

    <style>
        /* ---- checkout stepper ---- */
        .qc-stepper { display: flex; align-items: flex-start; justify-content: center; flex-wrap: wrap; }
        .qc-stepper-step { display: flex; flex-direction: column; align-items: center; gap: 7px; min-width: 74px; }
        .qc-stepper-dot {
            width: 34px; height: 34px; border-radius: 50%;
            display: grid; place-items: center;
            background: #1a1a1f; color: #7d8494;
            border: 1px solid var(--iq-line, rgba(255,255,255,.08));
            font-weight: 700; font-size: .85rem;
            transition: background .2s ease, color .2s ease, border-color .2s ease, box-shadow .2s ease;
        }
        .qc-stepper-dot svg { width: 16px; height: 16px; }
        .qc-stepper-step.active .qc-stepper-dot {
            background: linear-gradient(135deg, var(--iq-primary, #e31c64), var(--iq-primary-dark, #a51149));
            border-color: transparent; color: #fff;
            box-shadow: 0 6px 16px rgba(227, 28, 100, .35);
        }
        .qc-stepper-step.done .qc-stepper-dot { background: var(--iq-success-light, rgba(32,201,151,.15)); color: var(--iq-success, #20c997); border-color: rgba(32,201,151,.35); }
        .qc-stepper-label { font-size: .74rem; font-weight: 600; color: #7d8494; text-align: center; }
        .qc-stepper-step.active .qc-stepper-label { color: #f06b9d; }
        .qc-stepper-step.done .qc-stepper-label { color: var(--iq-body, #9aa3b2); }
        .qc-stepper-line { flex: 1 1 40px; height: 1px; background: var(--iq-line, rgba(255,255,255,.08)); margin: 17px 6px 0; min-width: 20px; max-width: 90px; }
        .qc-stepper-line.done { background: var(--iq-success, #20c997); }
        @media (max-width: 575.98px) {
            .qc-stepper-step { min-width: 60px; }
            .qc-stepper-label { font-size: .68rem; }
            .qc-stepper-line { max-width: 40px; }
        }

        /* ---- slide deck ---- */
        .qc-order-shell { position: relative; }
        .qc-slide { display: none; }
        .qc-slide.qc-slide-active { display: block; animation: qcSlideIn .4s cubic-bezier(.22,.72,.24,1); }
        @keyframes qcSlideIn { from { opacity: 0; transform: translateX(34px); } to { opacity: 1; transform: none; } }
        @media (prefers-reduced-motion: reduce) { .qc-slide.qc-slide-active { animation: none; } }

        /* slide card wrapper */
        .qc-slide-card {
            background: var(--iq-surface, #0b0b0e);
            border: 1px solid var(--iq-line, rgba(255,255,255,.06));
            border-radius: .85rem;
            padding: 24px;
            color: var(--iq-body, #9aa3b2);
        }
        .qc-slide-card h2, .qc-slide-card h3, .qc-slide-card h5 { color: var(--iq-heading, #f5f6f8); }
        .qc-slide-head { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--iq-line, rgba(255,255,255,.06)); }
        .qc-slide-head .qc-slide-ico {
            width: 42px; height: 42px; border-radius: 50%; flex: none;
            display: grid; place-items: center;
            background: var(--iq-primary-light, rgba(227,28,100,.16)); color: #f06b9d;
        }
        .qc-slide-head .qc-slide-ico svg { width: 20px; height: 20px; }
        .qc-slide-head h2 { font-size: 1.2rem; margin: 0; }
        .qc-slide-head p { margin: 2px 0 0; font-size: .8rem; color: #7d8494; }

        /* product details well in configuration */
        .order-index .well {
            background: rgba(255,255,255,.02);
            border: 1px solid var(--iq-line, rgba(255,255,255,.06));
            border-radius: .75rem; color: var(--iq-body, #9aa3b2);
            padding: 18px;
        }
        .order-index .well h3 { color: var(--iq-heading, #f5f6f8); }
        .order-index .well hr { border-color: var(--iq-line, rgba(255,255,255,.08)); }

        /* currency selector in banner */
        .qc-currency-wrap { color: rgba(255,255,255,.9); }
        .qc-currency-wrap form, .qc-currency-wrap label, .qc-currency-wrap select { color: rgba(255,255,255,.85); }
    </style>
{% endblock %}

{% block sidebar2 %}
    {{ include('partial_currency.html.twig') }}
{% endblock %}

{% block js %}
{% autoescape "js" %}
<script>
    function resizeIframe(obj) {
        obj.style.height = obj.contentWindow.document.documentElement.scrollHeight + 'px';
        var loader = document.getElementById('loader-image');
        if (loader) loader.style.display = 'none';
    }
    /* slide transition helper (used after login/register advances to checkout) */
    window.qcGoToSlide = function (id) {
        document.querySelectorAll('.qc-slide').forEach(function (s) { s.classList.remove('qc-slide-active'); });
        var el = document.getElementById(id);
        if (el) el.classList.add('qc-slide-active');
        var stepper = document.getElementById('qc-stepper');
        if (stepper) {
            stepper.querySelectorAll('.qc-stepper-step').forEach(function (st) {
                st.classList.remove('active');
                if (st.getAttribute('data-qc-step') === id.replace('qc-slide-', '')) st.classList.add('active');
            });
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };
</script>
{% endautoescape %}
{% endblock %}
