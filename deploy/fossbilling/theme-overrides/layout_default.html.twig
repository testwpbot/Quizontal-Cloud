<!DOCTYPE html>
<html lang="en" data-bs-theme="{{ settings.theme|default('light') }}">
<head>
    <meta charset="utf-8">
   <title>{{ settings.meta_title_prefix }} {% block meta_title %}{% endblock %} {{ settings.meta_title_suffix }}</title>

    <meta property="bb:url" content="{{ constant('SYSTEM_URL') }}">
    <meta property="bb:client_area" content="{{ '/'|link }}">
    <meta name="csrf-token" content="{{ CSRFToken }}">

    <meta name="description" content="{% block meta_description %}{{ settings.meta_description }}{% endblock %}">
    <meta name="keywords" content="{{ settings.meta_keywords }}">
    <meta name="robots" content="{{ settings.meta_robots }}">
    <meta name="author" content="{{ settings.meta_author }}">
    <meta name="generator" content="FOSSBilling">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% block opengraph %}{% endblock %}
    {# Crash guard: shared layout name means a stale copy resolved in the ADMIN
       area must never ask Encore for the client 'huraga' entry (that entry only
       exists in the client theme and fataled the whole admin panel once). #}
    {% set qc_encore_entry = constant('ADMIN_AREA') ? 'fossbilling' : 'huraga' %}
    <link rel='stylesheet' type='text/css' href="{{ 'css/font-awesome.css' | asset_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    {{ encore_entry_link_tags(qc_encore_entry) }}
    <link rel="shortcut icon" href="{{ guest.system_company.favicon_url }}">

    {{ "Api/API.js" | library_url | script_tag }}
    {{ encore_entry_script_tags(qc_encore_entry) }}

    {{ DebugBar_renderHead() }}

    {% block head %}{% endblock %}
    {% block js %}{% endblock %}
</head>

<body class="{% block body_class %}{% endblock %}{{ client ? ' qc-authed' : '' }}">

{% block body %}
{% if not client and settings.require_login %}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const publicPaths = [
                '/news',
                '/tos',
                '/privacy-policy'
            ];
            const currentPath = window.location.pathname;

            const isAllowed = publicPaths.some(path => currentPath.startsWith(path));
            if (!isAllowed) {
                window.location.href = '{{ "login"|link }}';
            }
        });
    </script>
{% endif %}

{% if client %}
    {% set profile = client.profile_get %}
{% endif %}
{% set company = guest.system_company %}

{% if settings.theme == 'dark' %}
    {% set logo_url =  company.logo_url_dark %}
{% else %}
    {% set logo_url =  company.logo_url %}
{% endif %}
<div class="container">
    <header>
        {# Quizontal: initial cart count server-side (JS keeps it live afterwards) #}
        {% set qc_cart_count = guest.cart_get.items|default([])|length %}
        <nav class="navbar navbar-expand-md py-4">
            <div class="container-fluid">
                {% if logo_url and settings.show_company_logo %}
                    <a class="navbar-brand qc-brand-top" href="{{ '/'|link }}">
                        <img class="d-none d-sm-block" src="{{ logo_url }}" alt="{{ company.name }}" height="45px"
                             title="{{ company.name }}">
                        <span class="d-sm-none">{{ company.name }}</span>
                    </a>
                {% else %}
                    <a class="navbar-brand qc-brand-top" href="{{ '/'|link }}">
                        <span>{{ company.name }}</span>
                    </a>
                {% endif %}
                {% if client %}
                    {% set qc_bell_count = guest.extension_is_on({ "mod": "news" }) ? guest.news_get_list({ "per_page": 1 }).total : 0 %}
                    <form class="qcd-topsearch d-none d-md-flex" role="search" onsubmit="return false">
                        <svg viewBox="0 0 24 24"><path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/></svg>
                        <input type="search" placeholder="{{ 'Search your services...'|trans }}" aria-label="{{ 'Search services'|trans }}">
                    </form>
                    {% if guest.extension_is_on({ "mod": "news" }) %}
                        <a class="qcd-bell d-none d-md-grid" href="{{ '/news'|link }}" aria-label="{{ 'Announcements'|trans }}" title="{{ 'Announcements'|trans }}">
                            <svg viewBox="0 0 24 24"><path d="M21,19V20H3V19L5,17V11C5,7.9 7.03,5.17 10,4.29C10,4.19 10,4.1 10,4A2,2 0 0,1 12,2A2,2 0 0,1 14,4C14,4.1 14,4.19 14,4.29C16.97,5.17 19,7.9 19,11V17L21,19M14,21A2,2 0 0,1 12,23A2,2 0 0,1 10,21"/></svg>
                            {% if qc_bell_count > 0 %}<span class="qcd-bell-badge">{{ qc_bell_count }}</span>{% endif %}
                        </a>
                    {% endif %}
                {% endif %}
                <a href="{{ '/order'|link({'checkout': 1}) }}" class="nav-link d-md-none ms-auto pe-2 position-relative" aria-label="{{ 'Cart'|trans }}" title="{{ 'Cart'|trans }}">
                    <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="width:22px;height:22px"><path d="M17,18C15.89,18 15,18.89 15,20A2,2 0 0,0 17,22A2,2 0 0,0 19,20C19,18.89 18.1,18 17,18M1,2V4H3L6.6,11.59L5.24,14.04C5.09,14.32 5,14.65 5,15A2,2 0 0,0 7,17H19V15H7.42A0.25,0.25 0 0,1 7.17,14.75C7.17,14.7 7.18,14.66 7.2,14.63L8.1,13H15.55C16.3,13 16.96,12.59 17.3,11.97L20.88,5.5C20.95,5.34 21,5.17 21,5A1,1 0 0,0 20,4H5.21L4.27,2M7,18C5.89,18 5,18.89 5,20A2,2 0 0,0 7,22A2,2 0 0,0 9,20C9,18.89 8.1,18 7,18Z" /></svg>
                    <span class="qc-cart-count position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success" style="font-size:.6rem" title="{{ qc_cart_count }} {% if qc_cart_count == 1 %}{{ 'item in cart'|trans }}{% else %}{{ 'items in cart'|trans }}{% endif %}">{{ qc_cart_count }}</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="{{ 'Toggle navigation'|trans }}">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <div class="navbar-nav me-auto mb-2 mb-lg-0 w-100 d-flex justify-content-end">


                        {% set languages = guest.extension_languages(true) %}
                        {% if languages|length > 1 %}
                            <li class="nav-item">
                                <select name="lang" class="form-select js-language-selector">
                                    {% for lang in languages %}
                                        <option value="{{ lang.locale }}" data-custom-properties="&lt;span class=&quot;fi fi-{{ lang.locale|split('_')[1]|lower }}&quot;&gt;&lt;/span&gt;">&nbsp;{{ lang.title }}</option>
                                    {% endfor %}
                                </select>
                            </li>
                        {% endif %}

                        {% if settings.top_menu_dashboard %}
                            <li class="nav-item d-none d-md-block">
                                <a class="nav-link" href="{{ ''|link }}">{{ 'Dashboard'|trans }}</a>
                            </li>
                        {% endif %}

                        {% if settings.top_menu_order %}
                            <li class="nav-item d-none d-md-block">
                                <a class="nav-link" href="{{ '/order'|link }}">{{ 'Order'|trans }}</a>
                            </li>
                        {% endif %}

                        <li class="nav-item d-none d-md-block">
                            <a class="nav-link d-flex align-items-center" href="{{ '/order'|link({'checkout': 1}) }}">
                                <svg class="svg-icon me-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="width:18px;height:18px"><path d="M17,18C15.89,18 15,18.89 15,20A2,2 0 0,0 17,22A2,2 0 0,0 19,20C19,18.89 18.1,18 17,18M1,2V4H3L6.6,11.59L5.24,14.04C5.09,14.32 5,14.65 5,15A2,2 0 0,0 7,17H19V15H7.42A0.25,0.25 0 0,1 7.17,14.75C7.17,14.7 7.18,14.66 7.2,14.63L8.1,13H15.55C16.3,13 16.96,12.59 17.3,11.97L20.88,5.5C20.95,5.34 21,5.17 21,5A1,1 0 0,0 20,4H5.21L4.27,2M7,18C5.89,18 5,18.89 5,20A2,2 0 0,0 7,22A2,2 0 0,0 9,20C9,18.89 8.1,18 7,18Z" /></svg>
                                {{ 'Cart'|trans }}&nbsp;<span class="qc-cart-count badge rounded-pill bg-success" title="{{ qc_cart_count }} {% if qc_cart_count == 1 %}{{ 'item in cart'|trans }}{% else %}{{ 'items in cart'|trans }}{% endif %}">{{ qc_cart_count }}</span>
                            </a>
                        </li>

                        {% if settings.top_menu_profile %}
                            <li class="nav-item d-none d-md-block">
                                {% if not client %}
                                    <a class="nav-link" href="{{ 'login'|link }}">{{ 'Login'|trans }}</a>
                                {% endif %}
                            </li>
                        {% endif %}

                        {% if settings.top_menu_signout %}
                            <li class="nav-item d-none d-md-block">
                                {% if client %}
                                    <div class="dropdown">
                                        <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <img class="img-fluid rounded-circle" alt="{{ profile.first_name }} {{ profile.last_name }} gravatar" src="{{ profile.email|gravatar(60) }}" height="25px" width="25px">
                                            {% if profile.company %}
                                                <span>{{ profile.first_name }} {{ profile.last_name }} ({{ profile.company }})</span>
                                            {% else %}
                                                <span>{{ profile.first_name }} {{ profile.last_name }}</span>
                                            {% endif %}
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item"
                                                   href="{{ 'client/profile'|link }}">{{ 'Profile'|trans }}</a></li>
                                            <li><a class="dropdown-item"
                                                   href="{{ 'client/logout'|link }}">{{ 'Sign out'|trans }}</a></li>
                                        </ul>
                                    </div>
                                {% else %}
                                    <a class="ms-2 btn btn-outline-primary d-none d-md-block"
                                       href="{{ 'signup'|link }}">{{ 'Register'|trans }}</a>
                                {% endif %}
                            </li>
                        {% endif %}

                        <div class="d-md-none">
                            {{ include('mobile_menu.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <div class="row">
        {% if client or not settings.hide_menu %}
            <div class="col-3 d-none d-md-block">
                {{ include('partial_menu.html.twig') }}
            </div>
        {% endif %}
            <div class="col-12 col-md-9" {% if not client and settings.hide_menu %} style="margin-left: auto; margin-right: auto;" {% endif %}>
                <div id="wrapper">
                    <section role="main">
                        {% block content_before %}{% endblock %}
                        <div class="content-block" role="main">
                            {% if settings.show_breadcrumb %}
                                {% block breadcrumbs %}
                                    <nav aria-label="{{ 'breadcrumb'|trans }}">
                                        <ol class="breadcrumb d-none d-md-flex">
                                            <li class="breadcrumb-item"><a href="{{ '/'|link }}">{{ 'Home'|trans }}</a>
                                            </li>
                                            {% block breadcrumb %}
                                                <li class="active breadcrumb-item">{{ 'Dashboard'|trans }}</li>
                                            {% endblock %}
                                        </ol>
                                    </nav>
                                {% endblock %}
                            {% endif %}

                            {% block content %}{% endblock %}

                            {{ include('partial_message.html.twig') }}

                            {% block content_after %}{% endblock %}
                        </div>
                    </section>
                    <div id="push"></div>
                </div>

                {% if settings.footer_enabled %}
                    <footer id="footer" class="small text-muted mt-2 mb-3">
                        <div class="d-flex flex-column">
                            <div class="d-flex justify-content-center">
                                <span>&copy; {{ now|format_date(pattern='yyyy') }} {{ settings.footer_signature | default(company.signature) }}
                                    {% if company.bank_info_pagebottom == 1 %}
                                        <br/>
                                        <b>{{'Payment Information'|trans}}</b> - {{'Bank Name'|trans}}: {{ company.bank_name }} | {{'BIC / SWIFT Code'|trans}}: {{ company.bic }} | {{'Account Number'|trans}}: {{ company.account_number }}
                                    {% endif %}
                                </span>
                            </div>
                            <div class="d-flex justify-content-center">
                                {% if settings.footer_link_1_enabled %}
                                    {% if 'http://' in settings.footer_link_1_page or  'https://' in settings.footer_link_1_page %}
                                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                           href="{{ settings.footer_link_1_page }}">{{ settings.footer_link_1_title }}</a>
                                    {% else %}
                                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                           href="{{ settings.footer_link_1_page | link }}">{{ settings.footer_link_1_title }}</a>
                                    {% endif %}
                                {% endif %}
                                {% if settings.footer_link_2_enabled %}
                                    &nbsp;&#x2022;&nbsp;
                                    {% if 'http://' in settings.footer_link_2_page or  'https://' in settings.footer_link_2_page %}
                                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                           href="{{ settings.footer_link_2_page }}">{{ settings.footer_link_2_title }}</a>
                                    {% else %}
                                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                           href="{{ settings.footer_link_2_page | link }}">{{ settings.footer_link_2_title }}</a>
                                    {% endif %}
                                {% endif %}
                                {% if settings.footer_link_3_enabled %}
                                    &nbsp;&#x2022;&nbsp;
                                    {% if 'http://' in settings.footer_link_3_page or  'https://' in settings.footer_link_3_page %}
                                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                           href="{{ settings.footer_link_3_page }}">{{ settings.footer_link_3_title }}</a>
                                    {% else %}
                                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                           href="{{ settings.footer_link_3_page | link }}">{{ settings.footer_link_3_title }}</a>
                                    {% endif %}
                                {% endif %}
                                {% if settings.footer_link_4_enabled %}
                                    &nbsp;&#x2022;&nbsp;
                                    {% if 'http://' in settings.footer_link_4_page or  'https://' in settings.footer_link_4_page %}
                                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                           href="{{ settings.footer_link_4_page }}">{{ settings.footer_link_4_title }}</a>
                                    {% else %}
                                        <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                           href="{{ settings.footer_link_4_page | link }}">{{ settings.footer_link_4_title }}</a>
                                    {% endif %}
                                {% endif %}
                            </div>
                            {% if guest.extension_is_on({"mod":'branding'}) %}
                                <div class="d-flex justify-content-center">
                                    <span>{{ 'Powered by the'|trans }}&nbsp;</span>
                                    <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                        href="https://fossbilling.org" title="Billing Software"
                                       target="_blank">{{ 'FOSSBilling Community'|trans }}</a>
                                </div>
                            {% endif %}
                        </div>
                    </footer>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1070;"></div>
    {% if settings.footer_to_top_enabled %}
        <a href="#top" class="position-fixed btn btn-primary bottom-0 end-0 m-3">
            <span class="awe-arrow-up"></span> {{ 'Top'|trans }}</a>
    {% endif %}
    {# Quizontal: skeleton shimmer instead of the stock spinner — matches the storefront's loading style. #}
    <div class="wait" style="display:none" onclick="$(this).hide();">
        <div class="qc-load-card" role="status" aria-label="{{ 'Loading'|trans }}">
            <span class="qc-shimmer-line" style="width: 58%"></span>
            <span class="qc-shimmer-line" style="width: 88%"></span>
            <span class="qc-shimmer-line" style="width: 42%"></span>
        </div>
    </div>
    <style>
        .wait { z-index: 1080; }
        /* Quizontal: top navigation as pill buttons with real gaps (desktop only — mobile uses the drawer) */
        @media (min-width: 768px) {
            header .navbar-nav { align-items: center; gap: .6rem; }
            header .navbar-nav .nav-item > .nav-link,
            header .navbar-nav .dropdown > .btn.dropdown-toggle {
                display: inline-flex; align-items: center; gap: .4rem;
                padding: .5rem 1.05rem; border-radius: 999px;
                border: 1px solid rgba(134, 134, 139, .28);
                background: transparent; color: inherit;
                font-weight: 500; font-size: .95rem; line-height: 1.2;
                transition: background-color .15s ease, border-color .15s ease, color .15s ease, box-shadow .15s ease;
            }
            header .navbar-nav .nav-item > .nav-link:hover,
            header .navbar-nav .nav-item > .nav-link:focus-visible,
            header .navbar-nav .dropdown > .btn.dropdown-toggle:hover {
                background: rgba(216, 27, 96, .07);
                border-color: rgba(216, 27, 96, .4);
                color: #d81b60;
                box-shadow: 0 3px 12px rgba(216, 27, 96, .12);
            }
            header .navbar-nav .dropdown > .btn.dropdown-toggle { padding: .35rem 1rem .35rem .45rem; }
            header .navbar-nav .dropdown > .btn.dropdown-toggle img { border-radius: 50%; }
            header .navbar-nav .btn-outline-primary { border-radius: 999px; padding: .5rem 1.15rem; }
            header .navbar-nav .js-language-selector {
                border-radius: 999px; border-color: rgba(134, 134, 139, .28);
                padding: .45rem 2rem .45rem 1rem; font-weight: 500; font-size: .95rem;
            }
            header .navbar-nav .js-language-selector:hover { border-color: rgba(216, 27, 96, .4); box-shadow: 0 3px 12px rgba(216, 27, 96, .12); }
        }
        .qc-load-card {
            position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1081;
            width: min(320px, 82vw); padding: 20px; display: flex; flex-direction: column; gap: 12px;
            background: var(--bs-body-bg, #fff); border: 1px solid rgba(134, 134, 139, .22);
            border-radius: 16px; box-shadow: 0 18px 50px rgba(0, 0, 0, .16);
        }
        .qc-shimmer-line {
            display: block; height: 12px; border-radius: 999px;
            background: linear-gradient(90deg, rgba(134,134,139,.14) 20%, rgba(134,134,139,.34) 48%, rgba(134,134,139,.14) 76%);
            background-size: 400% 100%; animation: qcShimmer 1.15s ease-in-out infinite;
        }
        .qc-shimmer-line:nth-child(2) { animation-delay: .12s; }
        .qc-shimmer-line:nth-child(3) { animation-delay: .24s; }
        @keyframes qcShimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
        @media (prefers-reduced-motion: reduce) { .qc-shimmer-line { animation: none; } }
    </style>
    <style>
        /* ===== Quizontal Cloud app-shell (client area) ===== */
        .qc-authed { background: #f6f5fa; }
        .qc-authed, .qc-authed .qcd, .qc-authed .qcd-rail { font-family: 'DM Sans', sans-serif; }
        .qc-authed h1, .qc-authed h2, .qc-authed h3, .qc-authed .qcd h3 { font-family: 'Space Grotesk', 'DM Sans', sans-serif; letter-spacing: -.02em; }
        @media (min-width: 768px) {
            .qc-authed header .qc-brand-top { display: none !important; }
            /* fixed-width rail */
            .qc-authed header + .container .row > .col-3 { flex: 0 0 284px; max-width: 284px; }
            .qc-authed header + .container .row > .col-md-9 { flex: 1 1 auto; max-width: calc(100% - 284px); }
            .qcd-rail .offcanvas-body {
                background: #fff; border: 1px solid #e8e6f0; border-radius: 22px;
                padding: 20px 14px; margin-top: 4px; position: sticky; top: 18px;
                max-height: calc(100vh - 36px); box-shadow: 0 14px 40px rgba(21,10,38,.06);
                display: flex; flex-direction: column;
            }
        }
        .qcd-rail-brand img { width: 168px; height: 44px; object-fit: contain; margin: 4px 10px 18px; }
        .qcd-rail-nav { gap: 4px; }
        .qcd-rail-nav .nav-link {
            border-radius: 13px; padding: .68rem .9rem; color: #55596a; font-weight: 600; font-size: .93rem;
            transition: background .16s ease, color .16s ease;
        }
        .qcd-rail-nav .nav-link svg { width: 19px; height: 19px; }
        .qcd-rail-nav .nav-link:hover { background: rgba(227,28,100,.07); color: #d8185b; }
        .qcd-rail-nav .nav-link.qcd-active {
            background: linear-gradient(135deg, #e31c64, #a855f7); color: #fff;
            box-shadow: 0 10px 24px rgba(227,28,100,.25);
        }
        .qcd-rail .text-secondary { color: #9aa0b4 !important; font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; }
        .qcd-rail-promo {
            margin: auto 6px 4px; margin-top: auto; position: relative; overflow: hidden;
            border-radius: 18px; padding: 22px 18px; color: #fff;
            background: linear-gradient(150deg, #e31c64, #7c3aed);
        }
        .qcd-rail-promo strong { display: block; font-size: 1.02rem; line-height: 1.3; margin-bottom: 8px; position: relative; z-index: 1; }
        .qcd-rail-promo p { font-size: .8rem; opacity: .88; margin: 0 0 14px; position: relative; z-index: 1; }
        .qcd-promo-btn {
            position: relative; z-index: 1; display: inline-block; background: #fff; color: #d8185b;
            font-weight: 700; font-size: .82rem; border-radius: 999px; padding: .5rem 1.1rem; transition: transform .18s ease;
        }
        .qcd-promo-btn:hover { transform: translateY(-1px); color: #d8185b; }
        .qcd-promo-glow { position: absolute; border-radius: 50%; background: rgba(255,255,255,.16); filter: blur(2px); }
        .qcd-promo-glow.g1 { width: 120px; height: 120px; right: -40px; top: -44px; }
        .qcd-promo-glow.g2 { width: 80px; height: 80px; left: -30px; bottom: -34px; opacity: .6; }

        /* topbar search + bell */
        .qcd-topsearch {
            flex: 1 1 320px; max-width: 440px; margin: 0 14px; align-items: center; gap: 8px;
            background: #fff; border: 1.5px solid #e8e6f0; border-radius: 999px; padding: .5rem 1rem;
            transition: border-color .16s ease, box-shadow .16s ease;
        }
        .qcd-topsearch:focus-within { border-color: #e31c64; box-shadow: 0 0 0 3px rgba(227,28,100,.1); }
        .qcd-topsearch svg { width: 17px; height: 17px; fill: #9aa0b4; flex: none; }
        .qcd-topsearch input { border: 0; outline: 0; background: transparent; width: 100%; font: 500 .9rem 'DM Sans', sans-serif; color: #23263a; }
        .qcd-bell {
            position: relative; width: 42px; height: 42px; border-radius: 50%; place-items: center;
            background: #fff; border: 1.5px solid #e8e6f0; transition: border-color .16s ease, box-shadow .16s ease;
        }
        .qcd-bell:hover { border-color: rgba(227,28,100,.45); box-shadow: 0 6px 16px rgba(227,28,100,.14); }
        .qcd-bell svg { width: 19px; height: 19px; fill: #4a4e63; }
        .qcd-bell-badge {
            position: absolute; top: -5px; right: -5px; min-width: 19px; height: 19px; border-radius: 999px;
            background: #e31c64; color: #fff; font-size: .62rem; font-weight: 700; display: grid; place-items: center; padding: 0 4px;
            border: 2px solid #f6f5fa;
        }

        /* ===== dashboard content ===== */
        .qcd-hero { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin: 8px 0 22px; }
        .qcd-hero-title { font-size: clamp(1.55rem, 2.6vw, 2rem); font-weight: 700; margin: 0; color: #171a26; }
        .qcd-hero-sub { color: #8b8fa3; margin: 6px 0 0; font-size: .95rem; }
        .qcd-hero-art { position: relative; width: 130px; height: 64px; flex: none; }
        .qcd-blob { position: absolute; border-radius: 24px; }
        .qcd-blob.b1 { width: 64px; height: 64px; right: 0; top: 0; background: linear-gradient(135deg, #e31c64, #a855f7); opacity: .9; }
        .qcd-blob.b2 { width: 44px; height: 44px; right: 58px; top: 10px; background: rgba(227,28,100,.14); border: 1.5px dashed rgba(227,28,100,.45); }
        .qcd-blob.b3 { width: 26px; height: 26px; right: 44px; top: -8px; background: rgba(168,85,247,.28); }
        .qcd-wave { display: inline-block; animation: qcdwave 2.2s ease-in-out infinite; transform-origin: 70% 70%; }
        @keyframes qcdwave { 0%,60%,100% { transform: rotate(0); } 10% { transform: rotate(14deg); } 20% { transform: rotate(-8deg); } 30% { transform: rotate(14deg); } 40% { transform: rotate(-4deg); } 50% { transform: rotate(10deg); } }
        @media (prefers-reduced-motion: reduce) { .qcd-wave { animation: none; } }

        .qcd-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 18px; }
        .qcd-stat { position: relative; display: flex; gap: 13px; align-items: flex-start; background: #fff; border: 1px solid #eae8f2; border-radius: 18px; padding: 18px; overflow: hidden; transition: transform .2s ease, box-shadow .2s ease; }
        .qcd-stat:hover { transform: translateY(-3px); box-shadow: 0 14px 34px rgba(21,10,38,.09); }
        .qcd-stat-ic { width: 44px; height: 44px; border-radius: 13px; display: grid; place-items: center; flex: none; }
        .qcd-stat-ic svg { width: 22px; height: 22px; fill: currentColor; }
        .ic-vps { background: rgba(227,28,100,.12); color: #e31c64; }
        .ic-host { background: rgba(59,130,246,.12); color: #2563eb; }
        .ic-dom { background: rgba(16,185,129,.12); color: #0d9e6e; }
        .ic-due { background: rgba(245,158,11,.14); color: #d97706; }
        .qcd-stat-label { display: block; color: #8b8fa3; font-size: .78rem; font-weight: 600; }
        .qcd-stat-num { display: block; font: 700 1.5rem 'Space Grotesk', sans-serif; color: #171a26; margin: 2px 0; }
        .qcd-stat-note { display: block; font-size: .72rem; font-weight: 700; }
        .n-pink { color: #e31c64; } .n-blue { color: #2563eb; } .n-green { color: #0d9e6e; } .n-amber { color: #d97706; }
        .qcd-stat-bar { position: absolute; left: 18px; bottom: 12px; width: 26px; height: 3.5px; border-radius: 99px; }
        .b-pink { background: #e31c64; } .b-blue { background: #2563eb; } .b-green { background: #10b981; } .b-amber { background: #f59e0b; }

        .qcd-grid { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,1.35fr) minmax(0,.95fr); gap: 16px; align-items: start; }
        .qcd-card { background: #fff; border: 1px solid #eae8f2; border-radius: 20px; padding: 20px; }
        .qcd-card + .qcd-card { margin-top: 16px; }
        .qcd-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
        .qcd-card-head h3 { font-size: 1.02rem; font-weight: 700; margin: 0; color: #171a26; }
        .qcd-link-btn { font: 700 .76rem 'DM Sans', sans-serif; color: #5b5f74; background: #f2f0f8; border-radius: 10px; padding: .42rem .8rem; transition: .16s; }
        .qcd-link-btn:hover { background: rgba(227,28,100,.1); color: #d8185b; }
        .qcd-link-btn.is-static { cursor: default; } .qcd-link-btn.is-static:hover { background: #f2f0f8; color: #5b5f74; }

        .qcd-svc-list { display: grid; gap: 4px; }
        .qcd-svc { display: flex; align-items: center; gap: 12px; padding: 11px 10px; border-radius: 14px; transition: background .15s ease; }
        .qcd-svc:hover { background: #f8f7fc; }
        .qcd-svc-ic { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; flex: none; }
        .qcd-svc-ic svg { width: 20px; height: 20px; fill: currentColor; }
        .t-vps { background: rgba(227,28,100,.1); color: #e31c64; }
        .t-host { background: rgba(59,130,246,.1); color: #2563eb; }
        .t-dom { background: rgba(124,58,237,.1); color: #7c3aed; }
        .qcd-svc-body { min-width: 0; flex: 1; }
        .qcd-svc-body strong { display: block; font-size: .9rem; color: #23263a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .qcd-svc-body small { display: block; color: #9aa0b4; font-size: .76rem; margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .qcd-chip { flex: none; font: 700 .68rem 'DM Sans', sans-serif; border-radius: 999px; padding: .28rem .7rem; }
        .ch-ok { background: rgba(16,185,129,.13); color: #0d9e6e; }
        .ch-warn { background: rgba(245,158,11,.15); color: #b45309; }
        .ch-bad { background: rgba(239,68,68,.12); color: #dc2626; }
        .ch-mute { background: #eef0f4; color: #8b8fa3; }

        .qcd-total small { color: #8b8fa3; font-size: .8rem; font-weight: 600; display: block; }
        .qcd-total-row { display: flex; align-items: center; gap: 12px; margin: 4px 0 10px; }
        .qcd-total-row strong { font: 700 1.7rem 'Space Grotesk', sans-serif; color: #171a26; }
        .qcd-delta { font-size: .75rem; font-weight: 700; border-radius: 999px; padding: .22rem .6rem; }
        .qcd-delta.up { background: rgba(227,28,100,.1); color: #d8185b; }
        .qcd-delta.down { background: rgba(16,185,129,.13); color: #0d9e6e; }
        .qcd-chart { width: 100%; height: 130px; display: block; margin-top: 6px; }
        .qcd-chart-x { display: flex; justify-content: space-between; padding: 4px 2px 0; }
        .qcd-chart-x span { font-size: .68rem; color: #9aa0b4; font-weight: 600; }

        .qcd-act-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 13px; }
        .qcd-act-list li { display: flex; gap: 11px; align-items: flex-start; }
        .qcd-act-dot { width: 10px; height: 10px; border-radius: 50%; background: linear-gradient(135deg, #e31c64, #a855f7); margin-top: 5px; flex: none; box-shadow: 0 0 0 4px rgba(227,28,100,.1); }
        .qcd-act-dot.d-green { background: linear-gradient(135deg, #10b981, #34d399); box-shadow: 0 0 0 4px rgba(16,185,129,.1); }
        .qcd-act-list a { color: inherit; }
        .qcd-act-list a:hover strong, .qcd-act-list strong a:hover { color: #d8185b; }
        .qcd-act-list strong a { font-weight: 600; }
.qcd-act-list strong { display: block; font-size: .84rem; color: #2b2e40; font-weight: 600; line-height: 1.4; }
        .qcd-act-list small { color: #9aa0b4; font-size: .73rem; }

        .qcd-act-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        .qcd-qa { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; padding: 14px 8px; border-radius: 15px; border: 1px solid #eeecf6; background: #fbfbfe; font: 700 .76rem 'DM Sans', sans-serif; color: #3b3e52; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
        .qcd-qa:hover { transform: translateY(-2px); border-color: rgba(227,28,100,.35); box-shadow: 0 10px 22px rgba(21,10,38,.07); color: #d8185b; }
        .qa-ic { width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; font-size: 1rem; color: var(--qac, #e31c64); background: color-mix(in srgb, var(--qac, #e31c64) 12%, #fff); }
        .qcd-news-item { display: block; padding: 11px 12px; border-radius: 14px; background: #fbf7fa; border: 1px solid #f2e7ee; margin-top: 6px; transition: .15s; }
        .qcd-news-item:hover { border-color: rgba(227,28,100,.35); }
        .qcd-news-item strong { display: block; font-size: .86rem; color: #23263a; }
        .qcd-news-item small { color: #9aa0b4; font-size: .73rem; }
        .qcd-empty { text-align: center; padding: 26px 14px; color: #9aa0b4; font-size: .88rem; }
        .qcd-empty p { margin-bottom: 10px; }

        @media (max-width: 1199.98px) {
            .qcd-grid { grid-template-columns: 1fr 1fr; }
            .qcd-side { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
            .qcd-side .qcd-card + .qcd-card { margin-top: 0; }
            .qcd-news { grid-column: 1 / -1; }
        }
        @media (max-width: 991.98px) {
            .qcd-stats { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 767.98px) {
            .qcd-grid, .qcd-side { grid-template-columns: 1fr; }
            .qcd-hero-art { display: none; }
            .qcd-act-grid { grid-template-columns: repeat(2, 1fr); }
            .qc-authed .content-block > .breadcrumb { display: none; }
        }
        @media (max-width: 460px) { .qcd-stats { grid-template-columns: 1fr; } }
    </style>
    <noscript>{{ "NOTE: Many features on FOSSBilling require Javascript and cookies. You can enable both in your browser's preference settings."|trans }}</noscript>

    {# Quizontal: live cart badge in the header. Refreshes on load and whenever the tab regains focus. #}
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var badges = document.querySelectorAll('.qc-cart-count');
        if (!badges.length || typeof API === 'undefined' || !API.guest) return;
        function refreshCartCount() {
            API.guest.get('cart/get', {}, function (result) {
                var count = result && result.items ? result.items.length : 0;
                badges.forEach(function (badge) {
                    badge.textContent = count;
                    badge.title = count + (count === 1 ? ' item in cart' : ' items in cart');
                });
            }, function () {}, false);
        }
        refreshCartCount();
        window.addEventListener('focus', refreshCartCount);
        document.addEventListener('visibilitychange', function () { if (!document.hidden) refreshCartCount(); });
    });
    </script>

    {% endblock %}

    {% if settings.inject_javascript %}
        {{ settings.inject_javascript | raw }}
    {% endif %}
    {{ include('partial_pending_messages.html.twig', ignore_missing: true) }}
    {% if guest.extension_is_on({ "mod": "cookieconsent" }) %}
        {{ include('mod_cookieconsent_index.html.twig', ignore_missing: true) }}
    {% endif %}
</div>
{{ DebugBar_render() }}
</body>
</html>
