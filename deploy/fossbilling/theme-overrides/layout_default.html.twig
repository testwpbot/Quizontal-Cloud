    {# ---- page loader ---- #}
    <div id="loading">
        <div class="loader-box">
            <div class="loader-logo">Q</div>
            <div class="loader-text">{{ company.name }}</div>
        </div>
    </div>

    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    {# ---- sidebar ---- #}
    <aside class="iq-sidebar" id="iq-sidebar">
        <div class="iq-sidebar-logo">
            <a href="{{ '/'|link }}" class="header-logo">
                <span class="logo-icon">Q</span>
                <span class="logo-title">Quizontal<small>{{ 'Client Area'|trans }}</small></span>
            </a>
            <div class="iq-menu-bt-sidebar">
                <button class="sidebar-close" id="sidebar-close" type="button" aria-label="{{ 'Close menu'|trans }}">
                    <svg width="14" height="14" fill="currentColor"><use href="#i-close"/></svg>
                </button>
            </div>
        </div>
        <div class="iq-sidebar-scroll">
            {{ include('partial_menu.html.twig') }}
            <div class="sidebar-upgrade sidebar-wallet">
                <div class="d-flex align-items-center justify-content-between gap-2 position-relative">
                    <div class="text-start">
                        <div class="sw-label">{{ 'Wallet balance'|trans }}</div>
                        <div class="sw-amount">{{ profile.balance|money(profile.currency) }}</div>
                    </div>
                    <a class="sw-plus" href="{{ '/client/balance'|link }}" title="{{ 'Add funds'|trans }}" aria-label="{{ 'Add funds'|trans }}">+</a>
                </div>
            </div>
            <div class="text-center text-size-12" style="color:#5b6270; padding-bottom:.5rem">{{ company.name }} · {{ 'now'|date('Y') }}</div>
        </div>
    </aside>

    {# ---- top navbar ---- #}
    <nav class="iq-navbar">
        <button class="menu-toggle" id="menu-toggle" type="button" aria-label="{{ 'Toggle sidebar'|trans }}">
            <span></span><span></span><span></span>
        </button>
        <div class="navbar-crumb">
            <div class="page-label">{{ 'Control Panel'|trans }}</div>
            <strong>{{ block('meta_title') }}</strong>
        </div>
        <div class="search-box">
            <div class="input-group">
                <span class="input-group-text"><svg fill="currentColor"><use href="#i-search"/></svg></span>
                <input type="text" class="form-control" placeholder="{{ 'Search your services...'|trans }}">
            </div>
        </div>
        <div class="iq-navbar-right">
            <div class="dropdown">
                <button class="iq-menu-bt position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'Cart'|trans }}" title="{{ 'Cart'|trans }}">
                    <svg fill="currentColor"><use href="#i-buy"/></svg>
                    <span class="iq-badge qc-cart-count" title="{{ qc_cart_count }} {% if qc_cart_count == 1 %}{{ 'item in cart'|trans }}{% else %}{{ 'items in cart'|trans }}{% endif %}">{{ qc_cart_count }}</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end card-dropdown-menu" style="width:270px">
                    <div class="dropdown-header">{{ 'Shopping Cart'|trans }}</div>
                    <div class="px-2 pb-2">
                        <div class="stat-value mb-1"><span class="qc-cart-count">{{ qc_cart_count }}</span> {% if qc_cart_count == 1 %}{{ 'item'|trans }}{% else %}{{ 'items'|trans }}{% endif %}</div>
                        <div class="text-size-12" style="color:#98a1b3">{{ 'Products waiting for checkout'|trans }}</div>
                    </div>
                    <hr class="my-1">
                    <a href="{{ '/order'|link }}" class="dropdown-item"><svg width="16" height="16" fill="currentColor" class="me-2"><use href="#i-buy"/></svg>{{ 'Browse products'|trans }}</a>
                    <a href="{{ '/order'|link({'checkout': 1}) }}" class="dropdown-item"><svg width="16" height="16" fill="currentColor" class="me-2"><use href="#i-activity"/></svg>{{ 'Go to checkout'|trans }}</a>
                </div>
            </div>
            {% if qc_news_on %}
                <div class="dropdown">
                    <button class="iq-menu-bt" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'Announcements'|trans }}" title="{{ 'Announcements'|trans }}">
                        <svg fill="currentColor"><use href="#i-bell"/></svg>
                        {% if qc_bell_count > 0 %}<span class="iq-badge">{{ qc_bell_count > 9 ? '9+' : qc_bell_count }}</span>{% endif %}
                    </button>
                    <div class="dropdown-menu dropdown-menu-end card-dropdown-menu" style="width:320px">
                        <div class="d-flex justify-content-between align-items-center px-2 py-1">
                            <h6 class="mb-0">{{ 'Announcements'|trans }}</h6>
                            <a href="{{ '/news'|link }}" class="text-size-12 link-primary text-decoration-none">{{ 'View all'|trans }}</a>
                        </div>
                        {% for post in qc_bell_posts %}
                            <a class="notify-item text-decoration-none" href="{{ '/news'|link }}/{{ post.slug }}">
                                <span class="notify-icon bg-soft-primary"><svg fill="currentColor"><use href="#i-bell"/></svg></span>
                                <div class="notify-text"><strong>{{ post.title|truncate(46) }}</strong><div class="notify-time">{{ post.created_at|timeago }} {{ 'ago'|trans }}</div></div>
                            </a>
                        {% else %}
                            <div class="notify-item"><div class="notify-text">{{ 'No announcements yet — we will post updates here.'|trans }}</div></div>
                        {% endfor %}
                        <a href="{{ '/news'|link }}" class="dropdown-item text-center text-size-12 link-primary">{{ 'All announcements'|trans }}</a>
                    </div>
                </div>
            {% endif %}
            {% if settings.sidebar_balance_enabled or settings.side_menu_payments %}
                <div class="dropdown">
                    <button class="iq-menu-bt" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'Wallet'|trans }}" title="{{ 'Wallet'|trans }}">
                        <svg fill="currentColor"><use href="#i-wallet"/></svg>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end card-dropdown-menu" style="width:280px">
                        <div class="dropdown-header">{{ 'Account Balance'|trans }}</div>
                        <div class="px-2 pb-2">
                            <div class="stat-value mb-1">{{ profile.balance|money(profile.currency) }}</div>
                            <div class="text-size-12" style="color:#98a1b3">{{ 'Available for renewals & new orders'|trans }}</div>
                        </div>
                        <hr class="my-1">
                        <a href="{{ '/client/balance'|link }}" class="dropdown-item"><svg width="16" height="16" fill="currentColor" class="me-2"><use href="#i-buy"/></svg>{{ 'Add funds'|trans }}</a>
                        <a href="{{ '/invoice'|link }}" class="dropdown-item"><svg width="16" height="16" fill="currentColor" class="me-2"><use href="#i-document"/></svg>{{ 'Invoice history'|trans }}</a>
                    </div>
                </div>
            {% endif %}
            <div class="dropdown">
                <button class="iq-menu-bt" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width:auto;padding:0 .35rem;gap:.65rem">
                    <span class="avatar-user">{{ (profile.first_name|default('?'))|first|upper }}{{ (profile.last_name|default(''))|first|upper }}</span>
                    <span class="user-info">
                        <strong>{{ profile.first_name }} {{ profile.last_name|first|upper }}{% if profile.last_name %}.{% endif %}</strong>
                        <small>{{ profile.email|truncate(30) }}</small>
                    </span>
                    <svg width="12" height="12" fill="currentColor"><use href="#i-chevron"/></svg>
                </button>
                <div class="dropdown-menu dropdown-menu-end card-dropdown-menu" style="width:260px">
                    <div class="d-flex align-items-center gap-3 px-2 py-2 mb-1">
                        <span class="avatar-user">{{ (profile.first_name|default('?'))|first|upper }}{{ (profile.last_name|default(''))|first|upper }}</span>
                        <div class="user-info"><strong>{{ profile.first_name }} {{ profile.last_name }}</strong><small>{{ profile.email|truncate(30) }}</small></div>
                    </div>
                    <a href="{{ 'client/profile'|link }}" class="dropdown-item"><svg width="16" height="16" fill="currentColor" class="me-2"><use href="#i-profile"/></svg>{{ 'My Profile'|trans }}</a>
                    <a href="{{ 'client/profile'|link }}" class="dropdown-item"><svg width="16" height="16" fill="currentColor" class="me-2"><use href="#i-setting"/></svg>{{ 'Account Settings'|trans }}</a>
                    <a href="{{ '/invoice'|link }}" class="dropdown-item"><svg width="16" height="16" fill="currentColor" class="me-2"><use href="#i-wallet"/></svg>{{ 'Billing'|trans }}</a>
                    <hr class="my-1">
                    <a href="{{ 'client/logout'|link }}" class="dropdown-item text-danger"><svg width="16" height="16" fill="currentColor" class="me-2"><use href="#i-lock"/></svg>{{ 'Sign Out'|trans }}</a>
                </div>
            </div>
        </div>
    </nav>

    {# ---- main ---- #}
    <main class="main-content" id="main-content">
        {% block banner %}{% endblock %}
        <div class="container-fluid content-inner">
{% else %}
    {# ==================== GUEST / PUBLIC AREA (stock light chrome) ==================== #}
<div class="container">
    <header>
        {# Quizontal: initial cart count server-side (JS keeps it live afterwards) #}
        {% set qc_cart_count = guest.cart_get.items|default([])|length %}
        <nav class="navbar navbar-expand-md py-4">
            <div class="container-fluid">
                {% if logo_url and settings.show_company_logo %}
                    <a class="navbar-brand qc-brand-top" href="{{ '/'|link }}">
                        <img class="d-none d-sm-block" src="{{ logo_url }}" alt="{{ company.name }}" height="45px"
                             title="{{ company.name }}">
                        <span class="d-sm-none">{{ company.name }}</span>
                    </a>
                {% else %}
                    <a class="navbar-brand qc-brand-top" href="{{ '/'|link }}">
                        <span>{{ company.name }}</span>
                    </a>
                {% endif %}
