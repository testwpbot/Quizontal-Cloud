    {% if client %}
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Page loader (hidden once everything — charts included — is up)
        var hideLoader = function () {
            var el = document.getElementById('loading');
            if (el) el.classList.add('hide');
        };
        if (document.readyState === 'complete') { setTimeout(hideLoader, 250); }
        window.addEventListener('load', function () { setTimeout(hideLoader, 250); });
        setTimeout(hideLoader, 3500); // failsafe — never trap the user on a spinner

        // Sidebar toggles
        var menuToggle = document.getElementById('menu-toggle');
        if (menuToggle) {
            menuToggle.addEventListener('click', function () {
                if (window.innerWidth > 1199) {
                    document.body.classList.toggle('sidebar-mini');
                } else {
                    document.body.classList.toggle('mobile-menu-open');
                }
            });
        }
        var closeSidebar = function () { document.body.classList.remove('mobile-menu-open'); };
        var closeBtn = document.getElementById('sidebar-close');
        var overlay = document.getElementById('sidebar-overlay');
        if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
        if (overlay) overlay.addEventListener('click', closeSidebar);

        // Vanilla submenu toggles (bootstrap collapse handles it if present)
        document.querySelectorAll('.iq-sidebar-menu .nav-link[data-qc-toggle]').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                var target = document.querySelector(link.getAttribute('data-qc-target'));
                var li = link.closest('li.submenu');
                if (!target) return;
                target.classList.toggle('show');
                if (li) li.classList.toggle('show', target.classList.contains('show'));
            });
        });

        // Active menu state from the current URL
        var path = window.location.pathname.replace(/\/+$/, '') || '/';
        document.querySelectorAll('.iq-sidebar-menu .nav-link').forEach(function (a) {
            try {
                var href = new URL(a.href, window.location.origin).pathname.replace(/\/+$/, '') || '/';
                if (href === path) {
                    a.classList.add('active');
                    var sub = a.closest('.iq-submenu');
                    if (sub) {
                        sub.classList.add('show');
                        var li = sub.closest('li.submenu');
                        if (li) {
                            li.classList.add('show');
                            var parentLink = li.querySelector('.nav-link');
                            if (parentLink) parentLink.classList.add('active');
                        }
                    }
                }
            } catch (e) {}
        });
    });
    </script>
