    <style>
        /* =====================================================================
           Quizontal Cloud client app — dark theme shell (Inter)
           Scoped to authenticated pages only (body.qc-app). Guest, signup and
           order marketing pages keep the stock light theme.
           ===================================================================== */
        :root {
            --iq-primary: #E31C64;
            --iq-primary-hover: #ee3d80;
            --iq-primary-dark: #a51149;
            --iq-primary-light: rgba(227, 28, 100, 0.16);
            --iq-secondary: #22d3ee;
            --iq-secondary-hover: #19c1db;
            --iq-secondary-light: rgba(34, 211, 238, 0.15);
            --iq-success: #20c997;
            --iq-success-light: rgba(32, 201, 151, 0.15);
            --iq-warning: #ffbc35;
            --iq-warning-light: rgba(255, 188, 53, 0.16);
            --iq-danger: #f4113c;
            --iq-danger-light: rgba(244, 17, 60, 0.15);
            --iq-body-bg: #000000;
            --iq-heading: #f5f6f8;
            --iq-body: #9aa3b2;
            --iq-sidebar-width: 260px;
            --iq-navbar-height: 72px;
            --iq-border: #1b1b20;
            --iq-line: rgba(255, 255, 255, 0.06);
        }
        body.qc-app {
            background: #000;
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            color: var(--iq-body);
            overflow-x: hidden;
        }
        body.qc-app * { scrollbar-width: thin; scrollbar-color: #2a2a30 transparent; }
        body.qc-app ::-webkit-scrollbar { width: 5px; height: 5px; }
        body.qc-app ::-webkit-scrollbar-thumb { background: #2a2a30; border-radius: 10px; }
        .qc-app h1, .qc-app h2, .qc-app h3, .qc-app h4, .qc-app h5, .qc-app h6 { color: var(--iq-heading); }
        .qc-app a { color: #f06b9d; text-decoration: none; }
        .qc-app a:hover { color: var(--iq-primary-hover); }
        .qc-app .text-muted { color: #7d8494 !important; }

        /* ---- brand color plumbing used across the shell ---- */
        .qc-app .text-primary { color: var(--iq-primary) !important; }
        .qc-app .link-primary { color: var(--iq-primary) !important; }
        .qc-app .bg-soft-primary { background-color: var(--iq-primary-light) !important; color: #f06b9d !important; }
        .qc-app .bg-soft-info { background-color: var(--iq-secondary-light) !important; color: var(--iq-secondary) !important; }
        .qc-app .bg-soft-success { background-color: var(--iq-success-light) !important; color: #2fd9a8 !important; }
        .qc-app .bg-soft-warning { background-color: var(--iq-warning-light) !important; color: #ffc95e !important; }
        .qc-app .bg-soft-danger { background-color: var(--iq-danger-light) !important; color: #ff5c77 !important; }
        .qc-app .btn { border-radius: 0.5rem; font-size: 0.85rem; font-weight: 500; }
        .qc-app .btn-primary {
            --bs-btn-bg: var(--iq-primary);
            --bs-btn-border-color: var(--iq-primary);
            --bs-btn-hover-bg: var(--iq-primary-hover);
            --bs-btn-hover-border-color: var(--iq-primary-hover);
            --bs-btn-active-bg: var(--iq-primary-dark);
            --bs-btn-active-border-color: var(--iq-primary-dark);
            --bs-btn-focus-shadow-rgb: 227, 28, 100;
            color: #fff;
        }
        /* Anchor buttons: the global `.qc-app a:hover { color: pink }` link rule
           is more specific than `.qc-app .btn-primary`, so <a> buttons flip to
           rose text on hover. Pin them back to white (like <button> variants). */
        .qc-app a.btn-primary,
        .qc-app a.btn-primary:hover,
        .qc-app a.btn-primary:focus { color: #fff; }
        .qc-app a.btn-outline-primary,
        .qc-app a.btn-outline-primary:focus { color: #f06b9d; }
        .qc-app a.btn-outline-primary:hover { color: #fff; }
        .qc-app .btn-outline-primary {
            --bs-btn-color: #f06b9d;
            --bs-btn-border-color: var(--iq-primary);
            --bs-btn-hover-bg: var(--iq-primary);
            --bs-btn-hover-border-color: var(--iq-primary);
            --bs-btn-active-bg: var(--iq-primary-dark);
            --bs-btn-focus-shadow-rgb: 227, 28, 100;
        }

        /* ---- stock bootstrap building blocks, re-toned for dark pages ---- */
        .qc-app .card {
            border: 1px solid var(--iq-line);
            border-radius: 0.5rem;
            box-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.55);
            background: #0b0b0e;
            color: var(--iq-body);
        }
        .qc-app .card-header {
            background: transparent;
            border-bottom: 1px solid var(--iq-line);
            padding: 1.1rem 1.25rem;
        }
        .qc-app .card-body { padding: 1.25rem; }
        .qc-app .card-title { font-size: 1rem; font-weight: 600; margin-bottom: 0.25rem; }
        .qc-app .text-size-14 { font-size: 0.875rem; }
        .qc-app .text-size-12 { font-size: 0.75rem; }
        .qc-app .table {
            --bs-table-color: var(--iq-body);
            --bs-table-bg: transparent;
        }
        .qc-app .table > :not(caption) > * > * {
            background: transparent;
            color: var(--iq-body);
            border-bottom-color: rgba(255, 255, 255, 0.06);
            box-shadow: none;
        }
        .qc-app .form-control, .qc-app .form-select {
            background-color: rgba(255, 255, 255, 0.03);
            border: 1px solid #26262b;
            color: #e6e8ec;
            border-radius: 0.5rem;
        }
        .qc-app .form-control:focus, .qc-app .form-select:focus {
            background-color: rgba(255, 255, 255, 0.04);
            border-color: #f1719f;
            box-shadow: 0 0 0 0.22rem rgba(227, 28, 100, 0.15);
            color: #e6e8ec;
        }
        .qc-app .form-control::placeholder { color: #5f6673; }
        .qc-app .form-select option { background: #101014; color: #e6e8ec; }
        .qc-app .input-group-text { background: transparent; border-color: #26262b; color: #7e8594; }
        .qc-app .form-label, .qc-app .form-check-label { color: #9aa3b2; }
        .qc-app .form-check-input { background-color: #1c1c22; border-color: #2a2a32; }
        .qc-app .form-check-input:checked { background-color: var(--iq-primary); border-color: var(--iq-primary); }
        .qc-app .list-group-item { background: #0b0b0e; border-color: var(--iq-line); color: var(--iq-body); }
        .qc-app .dropdown-menu { background: #101014; border: 1px solid #26262b; }
        .qc-app .dropdown-item { color: #9aa3b2; }
        .qc-app .dropdown-item:hover, .qc-app .dropdown-item:focus { background: var(--iq-primary-light); color: #f06b9d; }
        .qc-app .modal-content { background: #101014; border: 1px solid #26262b; }
        .qc-app .modal-header, .qc-app .modal-footer { border-color: var(--iq-line); }
        .qc-app .btn-close { filter: invert(1) grayscale(1); }
        .qc-app .nav-tabs { border-color: var(--iq-line); }
        .qc-app .nav-tabs .nav-link { color: #7e8594; }
        .qc-app .nav-tabs .nav-link.active {
            background: var(--iq-primary-light); color: #f06b9d; border-color: transparent;
        }
        .qc-app .nav-pills .nav-link { border-radius: 0.5rem; color: #7e8594; }
        .qc-app .nav-pills .nav-link.active { background: var(--iq-primary); color: #fff; }
        .qc-app .pagination .page-link {
            background: #101014; border-color: #26262b; color: #9aa3b2; border-radius: 0.5rem; margin: 0 2px;
        }
        .qc-app .pagination .active > .page-link { background: var(--iq-primary); border-color: var(--iq-primary); color: #fff; }
        .qc-app .progress { background: #1e1e24; }
        .qc-app .progress-bar { background: var(--iq-primary); }
        .qc-app .alert { border-radius: 0.75rem; border-width: 1px; }
        .qc-app .alert-info { background: rgba(34, 211, 238, .08); border-color: rgba(34, 211, 238, .25); color: #a5ecf8; }
        .qc-app .alert-danger { background: rgba(244, 17, 60, .08); border-color: rgba(244, 17, 60, .3); color: #ff9db1; }
        .qc-app .alert-warning { background: rgba(255, 188, 53, .08); border-color: rgba(255, 188, 53, .3); color: #ffd98a; }
        .qc-app .badge.bg-primary { background-color: var(--iq-primary) !important; }
        .qc-app .content-block { background: transparent; border: 0; box-shadow: none; padding: 0; }
        .qc-app #wrapper { background: transparent; padding: 0; }

        /* ---- badges ---- */
        .qc-app .iq-badge {
            display: inline-flex; align-items: center; gap: 0.35rem;
            padding: 0.4em 0.75em; font-size: 0.72rem; font-weight: 600;
            border-radius: 10rem; line-height: 1;
        }
        .qc-app .iq-badge .iq-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

        /* ---- sidebar ---- */
        .iq-sidebar {
            position: fixed; top: 0; left: 0; bottom: 0;
            width: var(--iq-sidebar-width);
            background: #050507;
            border-right: 1px solid var(--iq-line);
            z-index: 1045;
            display: flex; flex-direction: column;
            transition: width 0.35s ease, transform 0.35s ease;
        }
        .iq-sidebar-logo {
            display: flex; align-items: center;
            padding: 0.9rem 1rem;
            border-bottom: 1px solid var(--iq-line);
            min-height: var(--iq-navbar-height);
            gap: 0.75rem;
        }
        .logo-icon {
            width: 40px; height: 40px; flex: 0 0 40px;
            border-radius: 0.75rem;
            background: linear-gradient(135deg, var(--iq-primary), var(--iq-primary-dark));
            display: inline-flex; align-items: center; justify-content: center;
            font-weight: 800; font-size: 1.25rem; color: #fff;
            box-shadow: 0 6px 14px rgba(227, 28, 100, 0.35);
        }
        .iq-sidebar-logo .header-logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
        .logo-title { font-size: 1.2rem; font-weight: 700; color: var(--iq-heading); line-height: 1; }
        .logo-title small {
            display: block; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.22em;
            color: var(--iq-primary); margin-top: 0.2rem; text-transform: uppercase;
        }
        .iq-menu-bt-sidebar { display: none; margin-left: auto; }
        .sidebar-close {
            width: 32px; height: 32px; border: 0; border-radius: 0.5rem;
            background: var(--iq-primary-light); color: #f06b9d;
            display: inline-flex; align-items: center; justify-content: center;
        }
        .iq-sidebar-scroll { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 1rem 0.75rem 1rem; }
        .iq-sidebar-menu .iq-menu { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem; }
        .iq-sidebar-menu .iq-menu > li.submenu > .nav-link { position: relative; }
        .iq-sidebar-menu .iq-menu > li.submenu > .nav-link::after {
            content: ""; position: absolute; right: 1.1rem; top: 50%;
            width: 8px; height: 8px; transform: translateY(-50%) rotate(45deg);
            border-right: 2px solid #5b6270; border-bottom: 2px solid #5b6270;
            transition: transform 0.25s ease;
        }
        .iq-sidebar-menu .iq-menu > li.submenu.show > .nav-link::after { transform: translateY(-50%) rotate(225deg); }
        .iq-sidebar-menu .nav-link {
            display: flex; align-items: center; gap: 0.85rem;
            padding: 0.75rem 0.9rem;
            border-radius: 0.5rem;
            color: #a6aebb;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.25s ease;
            white-space: nowrap;
        }
        .iq-sidebar-menu .nav-link:hover { background: #15151a; color: var(--iq-primary); }
        .iq-sidebar-menu .nav-link.active,
        .qc-app .iq-sidebar-menu .nav-link.active {
            background: linear-gradient(90deg, var(--iq-primary-light), rgba(227, 28, 100, 0.03));
            color: #f06b9d;
            box-shadow: inset 3px 0 0 var(--iq-primary);
        }
        .iq-sidebar-menu .nav-link .icon-box {
            width: 22px; height: 22px; flex: 0 0 22px;
            display: inline-flex; align-items: center; justify-content: center;
        }
        .iq-sidebar-menu .nav-link .icon-box svg { width: 20px; height: 20px; }
        .iq-sidebar-menu .nav-link-text { flex: 1; overflow: hidden; text-overflow: ellipsis; font-size: 0.88rem; }
        .iq-sidebar-menu .nav-link .badge-dot { width: 6px; height: 6px; border-radius: 50%; flex: 0 0 6px; }
        .menu-group-title {
            padding: 0.9rem 0.9rem 0.4rem;
            font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em;
            text-transform: uppercase; color: #5b6270;
            white-space: nowrap;
        }
        .iq-menu .collapse:not(.show) { display: none; }
        .iq-submenu { list-style: none; padding: 0; margin: 0.25rem 0 0; }
        .iq-submenu li { position: relative; }
        .iq-submenu li::before {
            content: ""; position: absolute; left: 2.1rem; top: 50%; transform: translateY(-50%);
            width: 6px; height: 6px; border-radius: 50%;
            background: #33333c; transition: background 0.2s ease;
        }
        .iq-submenu li:hover::before { background: var(--iq-primary); }
        .iq-submenu .nav-link {
            padding: 0.6rem 0.9rem 0.6rem 2.85rem;
            font-weight: 400; font-size: 0.85rem;
            background: transparent; box-shadow: none;
        }
        .iq-submenu .nav-link.active { background: var(--iq-primary-light); box-shadow: none; }
        .sidebar-balance {
            margin: 0.4rem 0.9rem 0.2rem; padding: 0.55rem 0.9rem;
            border: 1px dashed #26262b; border-radius: 0.5rem;
            font-size: 0.78rem; color: #7d8494;
            display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
        }
        .sidebar-balance strong { color: var(--iq-heading); white-space: nowrap; }
        .sidebar-upgrade {
            margin: 0.75rem;
            border-radius: 1rem;
            padding: 1.25rem;
            background: linear-gradient(135deg, #E31C64 0%, #8f1046 100%);
            color: #fff; text-align: center; position: relative; overflow: hidden;
        }
        .sidebar-upgrade::before, .sidebar-upgrade::after {
            content: ""; position: absolute; border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
        }
        .sidebar-upgrade::before { width: 110px; height: 110px; top: -40px; right: -30px; }
        .sidebar-upgrade::after { width: 70px; height: 70px; bottom: -25px; left: -20px; background: rgba(34, 211, 238, 0.15); }
        .sidebar-upgrade .upgrade-icon {
            width: 42px; height: 42px; margin: 0 auto 0.75rem;
            background: rgba(255, 255, 255, 0.15); border-radius: 0.75rem;
            display: flex; align-items: center; justify-content: center;
        }
        .sidebar-upgrade .upgrade-icon svg { width: 22px; height: 22px; }
        .sidebar-upgrade h6 { color: #fff; font-weight: 700; position: relative; }
        .sidebar-upgrade p { font-size: 0.75rem; color: rgba(255, 255, 255, 0.75); margin-bottom: 0.9rem; position: relative; }
        .sidebar-upgrade .btn { position: relative; }

        /* ---- top navbar ---- */
        .iq-navbar {
            position: fixed; top: 0; right: 0; left: var(--iq-sidebar-width);
            height: var(--iq-navbar-height);
            display: flex; align-items: center;
            gap: 1.25rem;
            padding: 0 1.5rem;
            z-index: 1040;
            transition: left 0.35s ease;
            background: rgba(0, 0, 0, 0.78);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }
        .menu-toggle {
            width: 38px; height: 38px; border: 0; border-radius: 0.5rem;
            background: var(--iq-primary-light); color: #f06b9d;
            display: inline-flex; align-items: center; justify-content: center;
            cursor: pointer; flex-direction: column; gap: 0;
        }
        .menu-toggle span {
            display: block; width: 18px; height: 2px; border-radius: 2px;
            background: currentColor; margin: 2px auto; transition: all 0.25s ease;
        }
        .navbar-crumb { line-height: 1.2; }
        .navbar-crumb .page-label { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #6b7280; }
        .navbar-crumb strong { font-size: 1rem; font-weight: 600; color: var(--iq-heading); }
        .search-box { flex: 1; max-width: 320px; }
        .search-box .input-group {
            border-radius: 10rem;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid #26262b;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .search-box .input-group:focus-within { border-color: #f1719f; box-shadow: 0 0 0 0.22rem rgba(227, 28, 100, 0.15); }
        .search-box .input-group-text { background: transparent; border: 0; color: #7e8594; padding-left: 0.9rem; }
        .search-box .input-group-text svg { width: 16px; height: 16px; }
        .search-box .form-control {
            background: transparent; border: 0; box-shadow: none;
            font-size: 0.85rem; padding: 0.5rem 0.5rem;
            color: #e6e8ec;
        }
        .search-box .form-control:focus { box-shadow: none; }
        .search-box .form-control::placeholder { color: #5f6673; }
        .iq-navbar-right { margin-left: auto; display: flex; align-items: center; gap: 0.4rem; }
        .iq-menu-bt {
            position: relative;
            width: 40px; height: 40px; border-radius: 0.6rem;
            background: transparent; border: 0;
            display: inline-flex; align-items: center; justify-content: center;
            color: #a6aebb; cursor: pointer; transition: background 0.2s ease;
        }
        .iq-menu-bt:hover { background: var(--iq-primary-light); color: #f06b9d; }
        .iq-menu-bt svg { width: 20px; height: 20px; }
        .iq-menu-bt .iq-badge {
            position: absolute; top: 3px; right: 2px;
            min-width: 16px; height: 16px; padding: 0 4px;
            font-size: 0.6rem; display: flex; align-items: center; justify-content: center;
            border-radius: 10rem; background: var(--iq-primary); color: #fff; font-weight: 700;
        }
        .avatar-user {
            width: 40px; height: 40px; border-radius: 0.75rem;
            background: linear-gradient(135deg, var(--iq-primary), var(--iq-secondary-hover));
            color: #fff; font-weight: 700; font-size: 0.9rem;
            display: flex; align-items: center; justify-content: center; flex: 0 0 40px;
        }
        .user-info { line-height: 1.2; text-align: left; min-width: 0; }
        .user-info strong { font-size: 0.85rem; color: var(--iq-heading); font-weight: 600; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-info small { font-size: 0.7rem; color: #6b7280; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .card-dropdown-menu {
            border: 1px solid #26262b; border-radius: 1rem;
            box-shadow: 0 16px 48px rgba(0, 0, 0, 0.65);
            padding: 0.75rem;
            background: #101014;
            max-height: 70vh; overflow-y: auto;
        }
        .card-dropdown-menu .dropdown-header { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #6b7280; }
        .card-dropdown-menu hr { border-color: #1d1d23; }
        .card-dropdown-menu .dropdown-item { border-radius: 0.6rem; font-size: 0.85rem; padding: 0.55rem 0.75rem; color: #9aa3b2; }
        .card-dropdown-menu .dropdown-item:hover { background: var(--iq-primary-light); color: #f06b9d; }
        .notify-item { display: flex; gap: 0.75rem; padding: 0.6rem 0.5rem; align-items: flex-start; color: inherit; }
        .notify-item + .notify-item { border-top: 1px solid #1d1d23; }
        .notify-icon {
            width: 36px; height: 36px; flex: 0 0 36px; border-radius: 0.65rem;
            display: flex; align-items: center; justify-content: center;
        }
        .notify-icon svg { width: 17px; height: 17px; }
        .notify-text { flex: 1; font-size: 0.8rem; color: #9aa3b2; line-height: 1.45; min-width: 0; }
        .notify-text strong { color: var(--iq-heading); font-weight: 600; }
        .notify-time { font-size: 0.68rem; color: #6b7280; }

        /* ---- dashboard banner (decorative CSS art, no image asset needed) ---- */
        .iq-banner {
            position: relative; overflow: hidden;
            border-radius: 1.25rem;
            min-height: 215px;
            color: #fff;
            margin: 0;
            background: linear-gradient(120deg, #8f1046 0%, var(--iq-primary) 55%, #f2578f 130%);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .iq-banner .iq-banner-art {
            position: absolute; inset: 0; z-index: 0; overflow: hidden;
        }
        .iq-banner .iq-banner-art::before {
            content: ""; position: absolute; inset: -30% -10% -30% 30%;
            background:
                radial-gradient(28rem 14rem at 78% 18%, rgba(34, 211, 238, .35), transparent 62%),
                radial-gradient(30rem 18rem at 92% 78%, rgba(168, 85, 247, .4), transparent 60%),
                radial-gradient(24rem 20rem at 60% 90%, rgba(255, 255, 255, .28), transparent 58%);
            filter: blur(2px);
            animation: qcBannerDrift 26s ease-in-out infinite;
        }
        .iq-banner .iq-banner-art::after {
            content: ""; position: absolute; inset: 0;
            background:
                linear-gradient(90deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.5) 50%, rgba(0, 0, 0, 0.32) 100%),
                repeating-linear-gradient(115deg, rgba(255,255,255,.05) 0 2px, transparent 2px 26px);
        }
        @keyframes qcBannerDrift {
            0%, 100% { transform: translateX(0) scale(1); }
            50% { transform: translateX(-4%) scale(1.08); }
        }
        .iq-banner .iq-container { padding: 1.75rem 2rem; position: relative; z-index: 2; }
        .iq-banner h1 { color: #fff; font-weight: 700; font-size: 1.75rem; margin-bottom: 0.4rem; }
        .iq-banner p { color: rgba(255, 255, 255, 0.82); max-width: 480px; margin-bottom: 0; }
        .btn-soft-light {
            background: #fff;
            border: 1px solid rgba(255, 255, 255, 0.9);
            color: #e31c64;
            font-weight: 600;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
        }
        .btn-soft-light:hover { background: #fff0f5; border-color: #fff; color: #a51149; }
        .banner-date {
            display: inline-flex; align-items: center; gap: 0.45rem;
            font-size: 0.78rem; font-weight: 500; color: rgba(255, 255, 255, 0.9);
            background: rgba(255, 255, 255, 0.12); border-radius: 10rem;
            padding: 0.35rem 0.9rem; margin-top: 1rem;
        }
        .banner-date svg { width: 14px; height: 14px; }
        .container-fluid.content-inner { padding: 1.5rem 1.5rem 0; position: relative; z-index: 2; }
        body.qc-has-banner .container-fluid.content-inner { margin-top: -3rem; }

        /* ---- circle stat slider ---- */
        .slider-list { list-style: none; flex-wrap: nowrap; scrollbar-width: none; }
        .slider-list::-webkit-scrollbar { display: none; }
        .card-slide { flex: 0 0 auto; min-width: 215px; }
        .card-slide .card-body { padding: 1.1rem 1.25rem; display: flex; align-items: center; }
        .progress-widget { display: flex; align-items: center; gap: 0.9rem; }
        .circle-progress {
            --ring: var(--iq-primary);
            width: 46px; height: 46px; flex: 0 0 46px; border-radius: 50%;
            display: inline-flex; align-items: center; justify-content: center;
            background: conic-gradient(var(--ring) calc(var(--val) * 1%), rgba(255, 255, 255, 0.12) 0);
        }
        .circle-progress-info { --ring: var(--iq-secondary); }
        .circle-progress-success { --ring: var(--iq-success); }
        .circle-progress-warning { --ring: var(--iq-warning); }
        .circle-inner {
            width: 38px; height: 38px; border-radius: 50%;
            background: #0b0b0e;
            display: inline-flex; align-items: center; justify-content: center;
            color: var(--ring);
        }
        .circle-inner svg { width: 16px; height: 16px; }
        .progress-detail p { font-size: 0.78rem; color: #7d8494; margin-bottom: 0.25rem; }
        .progress-detail h4 { font-size: 1.2rem; font-weight: 700; color: var(--iq-heading); margin: 0; }

        /* ---- stats / charts / table widgets ---- */
        .qc-app .stat-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .qc-app .stat-card:hover { transform: translateY(-3px); box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.6); }
        .stat-value { font-size: 1.35rem; font-weight: 700; color: var(--iq-heading); line-height: 1.1; }
        .stat-label { font-size: 0.78rem; color: #7d8494; font-weight: 500; }
        .stat-delta {
            margin-left: auto; display: inline-flex; align-items: center; gap: 0.25rem;
            font-size: 0.75rem; font-weight: 600;
            border-radius: 10rem; padding: 0.3rem 0.6rem; white-space: nowrap;
        }
        .stat-delta svg { width: 12px; height: 12px; }
        .chart-tabs { display: flex; gap: 0.25rem; background: #15151a; border-radius: 10rem; padding: 0.25rem; }
        .chart-tabs button {
            border: 0; background: transparent; border-radius: 10rem;
            padding: 0.35rem 0.85rem; font-size: 0.75rem; font-weight: 600; color: #7e8594;
            transition: all 0.2s ease;
        }
        .chart-tabs button.active { background: #232329; color: #f06b9d; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4); }
        .earning-legend { display: flex; align-items: center; justify-content: space-between; padding: 0 0.25rem; }
        .earning-legend .dot { width: 9px; height: 9px; border-radius: 3px; display: inline-block; }
        .earning-legend .label { font-size: 0.78rem; color: #7d8494; }
        .earning-legend .value { font-size: 0.85rem; font-weight: 600; color: var(--iq-heading); }
        .iq-progress { height: 6px; border-radius: 10rem; background: #1e1e24; overflow: hidden; }
        .iq-progress .progress-bar { background: var(--iq-primary); border-radius: 10rem; }
        .table-layout-flat {
            border-collapse: separate; border-spacing: 0 0.5rem;
            margin-bottom: 0;
            --bs-table-color: var(--iq-body);
            --bs-table-bg: transparent;
        }
        .table-layout-flat thead th {
            border: 0; font-size: 0.7rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: 0.08em; color: #6b7280;
            padding: 0.25rem 0.9rem; white-space: nowrap;
        }
        .table-layout-flat tbody td {
            border: 0; background: #121216; padding: 0.85rem 0.9rem;
            vertical-align: middle; white-space: nowrap;
        }
        .table-layout-flat tbody tr td:first-child { border-radius: 0.75rem 0 0 0.75rem; }
        .table-layout-flat tbody tr td:last-child { border-radius: 0 0.75rem 0.75rem 0; }
        .table-layout-flat tbody tr:hover td { background: #17171c; }
        .service-cell { display: flex; align-items: center; gap: 0.75rem; }
        .service-ico {
            width: 38px; height: 38px; flex: 0 0 38px; border-radius: 0.7rem;
            display: flex; align-items: center; justify-content: center;
        }
        .service-ico svg { width: 18px; height: 18px; }
        .service-name { font-weight: 600; color: var(--iq-heading); font-size: 0.85rem; }
        .service-sub { font-size: 0.72rem; color: #6b7280; }

        /* ---- wallet / activity / misc cards ---- */
        .credit-card-3d {
            position: relative; overflow: hidden;
            border-radius: 1.1rem;
            padding: 1.5rem;
            min-height: 190px;
            color: #fff;
            background: linear-gradient(120deg, #E31C64 0%, #a20f4d 55%, #6d0933 100%);
            box-shadow: 0 18px 36px -12px rgba(227, 28, 100, 0.55);
        }
        .credit-card-3d::before, .credit-card-3d::after {
            content: ""; position: absolute; border-radius: 50%;
        }
        .credit-card-3d::before { width: 190px; height: 190px; background: rgba(34, 211, 238, 0.18); top: -70px; right: -50px; }
        .credit-card-3d::after { width: 120px; height: 120px; background: rgba(255, 255, 255, 0.08); bottom: -50px; left: 40px; }
        .card-chip {
            width: 46px; height: 34px; border-radius: 0.4rem;
