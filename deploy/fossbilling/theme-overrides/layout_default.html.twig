    {# Quizontal: live cart badge. Refreshes on load and whenever the tab regains focus. #}
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var badges = document.querySelectorAll('.qc-cart-count');
        if (!badges.length || typeof API === 'undefined' || !API.guest) return;
        function refreshCartCount() {
            API.guest.get('cart/get', {}, function (result) {
                var count = result && result.items ? result.items.length : 0;
                badges.forEach(function (badge) {
                    badge.textContent = count;
                    badge.title = count + (count === 1 ? ' item in cart' : ' items in cart');
                });
            }, function () {}, false);
        }
        refreshCartCount();
        window.addEventListener('focus', refreshCartCount);
        document.addEventListener('visibilitychange', function () { if (!document.hidden) refreshCartCount(); });
    });
    </script>

    {# Quizontal: premium animated buttons — split the label into two layers of
       per-letter spans and append the arrow, so the white->pink letter-swap
       animation works on any button text without hand-writing spans. #}
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.premium-btn').forEach(function (btn) {
            var label = btn.textContent.replace(/\s+/g, ' ').trim();
            btn.textContent = '';
            var layer1 = document.createElement('span');
            var layer2 = document.createElement('span');
            layer1.className = 'span-mother';
            layer2.className = 'span-mother2';
            for (var i = 0; i < label.length; i++) {
                var ch = label[i];
                var s1 = document.createElement('span');
                var s2 = document.createElement('span');
                s1.textContent = ch === ' ' ? '\u00A0' : ch;
                s2.textContent = ch === ' ' ? '\u00A0' : ch;
                s1.style.transitionDelay = (i * 0.05) + 's';
                s2.style.transitionDelay = (i * 0.05) + 's';
                layer1.appendChild(s1);
                layer2.appendChild(s2);
            }
            var arrow = document.createElement('span');
            arrow.className = 'premium-arrow';
            arrow.setAttribute('aria-hidden', 'true');
            arrow.innerHTML = '<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
            btn.appendChild(layer1);
            btn.appendChild(layer2);
            btn.appendChild(arrow);
        });
        // Static premium buttons: just append the arrow (no letter-swap animation).
        document.querySelectorAll('.premium-btn-static').forEach(function (btn) {
            var arrow = document.createElement('span');
            arrow.className = 'premium-arrow';
            arrow.setAttribute('aria-hidden', 'true');
            arrow.innerHTML = '<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
            btn.appendChild(arrow);
        });
    });
    </script>

