{% extends "layout_public.html.twig" %}

{% set company = guest.system_company %}

{% block meta_title %}{{ 'Login'|trans }}{% endblock %}

{% block body_class %}page-login qc-auth-page{% endblock %}

{% block body %}
<div class="qc-auth">
    <div class="qc-auth-glow g1"></div><div class="qc-auth-glow g2"></div>
    <div class="qc-auth-card">
        <a href="{{ '/'|link }}" class="qc-auth-logo">
            <img src="https://res.cloudinary.com/dt1sdefd6/image/upload/v1786643376/ChatGPT_Image_Aug_13_2026_11_17_40_PM-remove-bg-io_y5zxiu.png" alt="{{ company.name }}">
        </a>
        <h1>{{ 'Login to your account'|trans }}</h1>
        <p class="qc-auth-sub">{{ 'Welcome back — manage domains, hosting and servers in one place.'|trans }}</p>

        <form class="api-form auth" action="{{ 'api/guest/client/login'|link }}" method="post" data-api-redirect="{{ redirect_uri|default('/')|link }}">
            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
            <div class="mb-3">
                <label class="form-label" for="email">{{ 'Email'|trans }}</label>
                <input class="form-control" id="email" type="text" placeholder="{{ 'Enter your email address'|trans }}" name="email" value="{{ request.email }}" required="required" autofocus>
            </div>
            <div class="mb-4">
                <label class="form-label" for="password">{{ 'Password'|trans }}</label>
                <input class="form-control" id="password" type="password" placeholder="{{ 'Enter your password'|trans }}" name="password" required="required" value="{{ request.password }}">
            </div>
            <button type="submit" class="qc-auth-btn">{{ 'Login'|trans }}</button>
        </form>

        <div class="qc-auth-links">
            {% if settings.show_password_reset_link %}
                <a href="{{ 'password-reset'|link }}">{{ 'Forgot password?'|trans }}</a>
            {% endif %}
            {% if settings.show_signup_link %}
                <a href="{{ 'signup'|link }}">{{ 'Create account'|trans }}</a>
            {% endif %}
        </div>
    </div>
</div>
<style>
    .qc-auth-page { margin: 0; }
    .qc-auth {
        position: relative; min-height: 100vh;
        display: flex; align-items: center; justify-content: center;
        padding: 2rem 1rem;
        background: #050508; color: #9aa3b2; overflow: hidden;
    }
    .qc-auth-glow { position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none; }
    .qc-auth-glow.g1 { width: 520px; height: 520px; background: rgba(227, 28, 100, .28); right: -180px; top: -120px; }
    .qc-auth-glow.g2 { width: 420px; height: 420px; background: rgba(168, 85, 247, .22); left: -180px; bottom: -140px; }
    .qc-auth-card {
        position: relative; z-index: 2;
        width: min(420px, 100%);
        background: #0b0b0e;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 40px 34px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
    }
    .qc-auth-logo { display: block; text-align: center; margin-bottom: 24px; }
    .qc-auth-logo img { height: 54px; width: auto; object-fit: contain; }
    .qc-auth h1 { color: #f5f6f8; font-size: 1.4rem; font-weight: 700; text-align: center; margin: 0 0 8px; }
    .qc-auth-sub { color: #7d8494; font-size: .85rem; text-align: center; margin: 0 0 26px; line-height: 1.55; }
    .qc-auth .form-label { color: #9aa3b2; font-size: .8rem; font-weight: 600; }
    .qc-auth .form-control {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e6e8ec; border-radius: 10px; padding: 11px 14px;
    }
    .qc-auth .form-control:focus {
        background: rgba(255, 255, 255, 0.06);
        border-color: #f1719f; color: #fff;
        box-shadow: 0 0 0 3px rgba(227, 28, 100, 0.18);
    }
    .qc-auth .form-control::placeholder { color: #5f6673; }
    .qc-auth .form-text { color: #7d8494; }
    .qc-auth-btn {
        width: 100%; height: 50px;
        border: 0; border-radius: 12px; cursor: pointer;
        background: linear-gradient(135deg, #e31c64, #a51149);
        color: #fff; font-weight: 700; font-size: .95rem;
        box-shadow: 0 12px 30px rgba(227, 28, 100, .32);
        transition: transform .15s ease, box-shadow .2s ease, filter .2s ease;
    }
    .qc-auth-btn:hover { filter: brightness(1.06); transform: translateY(-1px); box-shadow: 0 16px 38px rgba(227, 28, 100, .4); }
    .qc-auth-links {
        display: flex; justify-content: space-between; gap: 12px;
        margin-top: 20px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.06);
    }
    .qc-auth-links a { color: #f06b9d; font-size: .82rem; font-weight: 600; text-decoration: none; }
    .qc-auth-links a:hover { color: #ff7bac; }
</style>
{% endblock %}
