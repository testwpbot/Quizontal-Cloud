<style>
:root{--qc-bg:#0d0e12;--qc-panel:#15171d;--qc-card:#1b1e25;--qc-border:#2a2e37;--qc-text:#f4f5f7;--qc-muted:#9298a5;--qc-pink:#e31c64;--qc-pink-soft:rgba(227,28,100,.14)}
html[data-bs-theme=dark],body{background:var(--qc-bg)!important;color:var(--qc-text)!important}body{min-height:100vh}.container{max-width:1420px!important}.navbar{background:transparent!important}.navbar-brand img{object-fit:contain;max-width:190px;height:48px!important}.navbar-toggler-icon{filter:invert(1)}.content-block,.breadcrumb{color:var(--qc-text)}a{color:#f06a9b}.card,.accordion-item,.dropdown-menu,.list-group-item,.table{background-color:var(--qc-card)!important;color:var(--qc-text)!important;border-color:var(--qc-border)!important}.card{border-radius:14px!important;box-shadow:0 12px 30px rgba(0,0,0,.14)}.card-header,.card-footer,.accordion-button,.table td,.table th{border-color:var(--qc-border)!important;background-color:transparent!important;color:var(--qc-text)!important}.text-muted,.text-secondary,.form-text,.card-subtitle{color:var(--qc-muted)!important}.form-control,.form-select{background:#111319!important;border-color:var(--qc-border)!important;color:var(--qc-text)!important}.form-control:focus,.form-select:focus{border-color:var(--qc-pink)!important;box-shadow:0 0 0 3px rgba(227,28,100,.13)!important}.btn-primary{background:var(--qc-pink)!important;border-color:var(--qc-pink)!important}.btn-primary:hover{background:#c91858!important;border-color:#c91858!important}.btn-dark,.btn-outline-secondary{background:#22252d!important;border-color:#343943!important;color:var(--qc-text)!important}.alert-info{background:#171e26!important;border-color:#2d465a!important;color:#cfe8f8!important}.alert-success{background:#15231c!important;border-color:#285b40!important;color:#c9f5d9!important}.alert-warning{background:#292317!important;border-color:#68562a!important;color:#f5dfaa!important}.badge.bg-warning{background:#70591e!important;color:#fff!important}.badge.bg-success{background:#206b42!important}.table-striped>tbody>tr:nth-of-type(odd)>*{--bs-table-accent-bg:rgba(255,255,255,.018);color:var(--qc-text)}
.qc-sidebar{position:sticky;top:20px;min-height:calc(100vh - 40px);padding:18px 14px;border:1px solid var(--qc-border);border-radius:16px;background:var(--qc-panel);display:flex;flex-direction:column}.qc-sidebar-nav{gap:5px}.qc-nav-link{display:flex;align-items:center;gap:12px;padding:11px 13px;border-radius:10px;color:#b8bdc7!important;font-weight:600;text-decoration:none;transition:.18s}.qc-nav-link svg{width:20px;height:20px;fill:currentColor}.qc-nav-link:hover,.qc-nav-link.active{background:var(--qc-pink-soft);color:#ff74a6!important}.qc-balance{margin-top:auto;padding:16px;border:1px solid var(--qc-border);border-radius:13px;background:#111319}.qc-balance strong{display:block;font-size:22px;color:#fff;margin:4px 0 12px}.qc-account-mini{padding-top:14px;margin-top:14px;border-top:1px solid var(--qc-border)}
@media(min-width:768px){body>.container>header+ .container>.row>.col-3{width:260px;flex:0 0 260px}body>.container>header+ .container>.row>.col-md-9{width:calc(100% - 260px);flex:0 0 calc(100% - 260px);padding-left:26px}}
@media(max-width:767.98px){body>.container{padding:0 14px}.navbar{padding:14px 0!important}.navbar-brand img{max-width:150px;height:40px!important}.navbar-toggler{z-index:1062;border-color:var(--qc-border)!important}#navbarSupportedContent{display:block!important;position:fixed;top:0;right:-320px;width:min(310px,88vw);height:100vh;background:var(--qc-panel);border-left:1px solid var(--qc-border);z-index:1061;padding:18px;transition:right .25s ease;overflow-y:auto;box-shadow:-18px 0 45px rgba(0,0,0,.35)}#navbarSupportedContent.show{right:0}#navbarSupportedContent .navbar-nav{height:100%;display:flex!important;flex-direction:column!important}#navbarSupportedContent .d-md-none{height:100%;display:flex!important;flex-direction:column}.qc-mobile-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.62);z-index:1060;opacity:0;pointer-events:none;transition:.2s}.qc-mobile-backdrop.show{opacity:1;pointer-events:auto}.content-block{padding-top:8px}.breadcrumb{display:none!important}}
</style>
<div class="qc-sidebar">
  <nav class="nav flex-column qc-sidebar-nav">
    {% if settings.side_menu_dashboard %}<a class="qc-nav-link" data-qc-path="/" href="{{ '/'|link }}"><svg viewBox="0 0 24 24"><path d="M3 13h8V3H3v10Zm0 8h8v-6H3v6Zm10 0h8V11h-8v10Zm0-18v6h8V3h-8Z"/></svg><span>Dashboard</span></a>{% endif %}
    {% if settings.side_menu_order %}<a class="qc-nav-link" data-qc-path="/order" href="{{ '/order'|link }}"><svg viewBox="0 0 24 24"><path d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM1 2v2h2l3.6 7.59-1.35 2.45A2 2 0 0 0 7 17h12v-2H7.42a.25.25 0 0 1-.22-.37L8.1 13h7.45a2 2 0 0 0 1.75-1.03L20.88 5.5A1 1 0 0 0 20 4H5.21l-.94-2H1Zm16 16a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/></svg><span>Order</span></a>{% endif %}
    {% if settings.side_menu_services %}<a class="qc-nav-link" data-qc-path="/order/service" href="{{ '/order/service'|link }}"><svg viewBox="0 0 24 24"><path d="M4 3h16a2 2 0 0 1 2 2v4H2V5a2 2 0 0 1 2-2Zm-2 8h20v4H2v-4Zm0 6h20v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-2Zm4-12v2h2V5H6Zm0 8v1h2v-1H6Zm0 6h2v-1H6v1Z"/></svg><span>Services</span></a>{% endif %}
    {% if settings.side_menu_invoices %}<a class="qc-nav-link" data-qc-path="/invoice" href="{{ '/invoice'|link }}"><svg viewBox="0 0 24 24"><path d="M6 2h12l4 4v16H2V2h4Zm1 5v2h10V7H7Zm0 4v2h10v-2H7Zm0 4v2h7v-2H7Z"/></svg><span>Invoices</span></a>{% endif %}
    {% if settings.side_menu_support %}<a class="qc-nav-link" data-qc-path="/support" href="{{ '/support'|link }}"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8 16l-2 4 4-2a10 10 0 1 0 6-18Zm-1 15H9v-2h2v2Zm2.1-5.2c-.8.5-1.1.8-1.1 1.7h-2c0-1.8.7-2.5 1.8-3.2.8-.5 1.2-.9 1.2-1.6 0-.9-.7-1.5-1.7-1.5-1 0-1.7.5-2.3 1.3L7.5 7.3A4.7 4.7 0 0 1 11.4 5c2.2 0 3.8 1.4 3.8 3.5 0 1.6-.8 2.5-2.1 3.3Z"/></svg><span>Support</span></a>{% endif %}
    {% if settings.side_menu_emails %}<a class="qc-nav-link" data-qc-path="/email" href="{{ '/email'|link }}"><svg viewBox="0 0 24 24"><path d="M2 4h20v16H2V4Zm10 9 8-5V6l-8 5-8-5v2l8 5Z"/></svg><span>Email</span></a>{% endif %}
    {% if settings.side_menu_payments %}<a class="qc-nav-link" data-qc-path="/client/balance" href="{{ '/client/balance'|link }}"><svg viewBox="0 0 24 24"><path d="M3 5h16v3h2v11H5a2 2 0 0 1-2-2V5Zm2 5v7h14v-7H5Zm10 2h3v3h-3v-3Z"/></svg><span>Wallet</span></a>{% endif %}
    {% if guest.extension_is_on({"mod":"news"}) and settings.side_menu_news %}<a class="qc-nav-link" data-qc-path="/news" href="{{ '/news'|link }}"><svg viewBox="0 0 24 24"><path d="M3 3h18v18H3V3Zm3 4v5h5V7H6Zm7 0v2h5V7h-5Zm0 4v2h5v-2h-5ZM6 15v2h12v-2H6Z"/></svg><span>News</span></a>{% endif %}
  </nav>
  {% if client %}<div class="qc-balance"><span class="text-muted small">Wallet balance</span><strong>{{ profile.balance|money(profile.currency) }}</strong><a class="btn btn-primary btn-sm w-100" href="{{ '/client/balance'|link }}">Add funds</a></div><div class="qc-account-mini"><div class="d-flex align-items-center gap-2"><img class="rounded-circle" src="{{ profile.email|gravatar(60) }}" width="34" height="34" alt=""><div class="small"><strong class="d-block">{{ profile.first_name }} {{ profile.last_name }}</strong><span class="text-muted">{{ profile.email }}</span></div></div></div>{% endif %}
</div>
<script>
document.addEventListener('DOMContentLoaded',function(){document.documentElement.setAttribute('data-bs-theme','dark');var logo=document.querySelector('.navbar-brand img');if(logo){logo.src='https://res.cloudinary.com/dt1sdefd6/image/upload/v1786291141/quizontal-cloud-logo_wa4agd.png';logo.classList.remove('d-none');logo.classList.add('d-block');var mobileName=document.querySelector('.navbar-brand span');if(mobileName)mobileName.style.display='none';}var path=window.location.pathname.replace(/\/$/,'')||'/';var navMatches=[];document.querySelectorAll('.qc-nav-link').forEach(function(link){var target=link.dataset.qcPath||new URL(link.href,window.location.origin).pathname.replace(/\/$/,'')||'/';if(target==='/'?path==='/' : path.indexOf(target)===0)navMatches.push({link:link,length:target.length});});navMatches.sort(function(a,b){return b.length-a.length;});if(navMatches[0])navMatches[0].link.classList.add('active');var menu=document.getElementById('navbarSupportedContent');if(menu){var backdrop=document.createElement('div');backdrop.className='qc-mobile-backdrop';document.body.appendChild(backdrop);var sync=function(){backdrop.classList.toggle('show',menu.classList.contains('show'));document.body.style.overflow=menu.classList.contains('show')?'hidden':'';};new MutationObserver(sync).observe(menu,{attributes:true,attributeFilter:['class']});backdrop.addEventListener('click',function(){var toggler=document.querySelector('.navbar-toggler');if(toggler&&menu.classList.contains('show'))toggler.click();});}});
</script>
