{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ order.title }}{% endblock %}

{% set addons = client.order_addons({ "id": order.id }) %}

{% block body_class %}order-manage qc-has-banner{% endblock %}
{% block breadcrumbs %}{% endblock %}

{% set service_partial = "mod_service" ~ order.service_type ~ "_manage.html.twig" %}
{% set upgradables = client.order_upgradables({ 'id': order.id }) %}

{# Quizontal Cloud: an active order whose server is still being created must not
   claim the server is active. The service layer reports the honest state. #}
{% set qc_setup = false %}
{% if order.service_type == 'interserver' and order.service_id and order.status == 'active' and not order.unpaid_invoice_id %}
    {% set qc_service = client.order_service({ 'id': order.id }) %}
    {% if qc_service is not empty and qc_service.provisioning_state is defined and qc_service.provisioning_state != 'active' %}
        {% set qc_setup = true %}
    {% endif %}
{% endif %}

{# status ring colour (matches the dashboard accent system) #}
{% set qc_status_ring = '#20c997' %}
{% if qc_setup or order.status == 'pending_setup' %}
    {% set qc_status_ring = '#ffbc35' %}
{% elseif order.status in ['suspended', 'failed_setup', 'failed_renew'] %}
    {% set qc_status_ring = '#f4113c' %}
{% elseif order.status == 'canceled' %}
    {% set qc_status_ring = '#6b7280' %}
{% endif %}

{% block head %}
    {{ mf.wysiwyg('.editor-textarea') }}
{% endblock %}

{% block banner %}
    <div class="iq-banner">
        <div class="iq-banner-art" aria-hidden="true"></div>
        <div class="container-fluid iq-container">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <h1>{{ order.title }}</h1>
                    <p>{{ 'Service details — everything about this service in one place.'|trans }}</p>
                    <span class="banner-date">
                        <svg fill="currentColor"><use href="#i-document"/></svg>
                        {{ 'Order'|trans }} #{{ order.id }}
                    </span>
                </div>
                <div>
                    <a href="{{ 'service'|link }}" class="premium-btn">{{ 'Back to services'|trans }}</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
{% if client %}
    <style>
        .qc-details{display:flex;flex-direction:column}
        .qc-details-row{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:12px 2px;border-bottom:1px solid var(--iq-line, rgba(255,255,255,.06))}
        .qc-details-row:last-child{border-bottom:0}
        .qc-details-label{font-size:.74rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#7d8494;padding-top:3px;flex:none}
        .qc-details-value{font-weight:600;color:var(--iq-heading, #f5f6f8);text-align:right;min-width:0;word-break:break-word}
        @media (max-width:575.98px){
            .qc-details-row{flex-direction:column;gap:3px}
            .qc-details-value{text-align:left}
        }
    </style>

    {# ================= key stat cards ================= #}
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress" style="--val:100">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-wallet"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Payment amount'|trans }}</p>
                            <h4>{{ order.total|money(order.currency) }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress circle-progress-info" style="--val:100">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-activity"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Billing cycle'|trans }}</p>
                            <h4>{% if order.period %}{{ order.period|period_title }}{% else %}{{ 'One-time'|trans }}{% endif %}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress circle-progress-warning" style="--val:100">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-calendar"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Next renewal'|trans }}</p>
                            <h4>{% if order.expires_at %}{{ order.expires_at|format_date(pattern="MMM d, yyyy") }}{% else %}—{% endif %}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xxl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="progress-widget">
                        <div class="circle-progress" style="--val:100;--ring:{{ qc_status_ring }}">
                            <span class="circle-inner"><svg fill="currentColor"><use href="#i-folder"/></svg></span>
                        </div>
                        <div class="progress-detail">
                            <p class="mb-2">{{ 'Status'|trans }}</p>
                            <h4>{% if qc_setup %}{{ 'Setting up'|trans }}{% else %}{{ mf.status_name(order.status) }}{% endif %}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            {# Order details #}
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="header-title">
                        <h4 class="card-title">{{ 'Service details'|trans }}</h4>
                        <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'All information about your service'|trans }}</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="qc-details">
                        <div class="qc-details-row">
                            <span class="qc-details-label">{{ 'Product name'|trans }}</span>
                            <span class="qc-details-value"><strong>{{ order.title }}</strong></span>
                        </div>

                        <div class="qc-details-row">
                            <span class="qc-details-label">{{ 'Order created'|trans }}</span>
                            <span class="qc-details-value">{{ order.created_at|format_date }}</span>
                        </div>

                        <div class="qc-details-row">
                            <span class="qc-details-label">{{ 'Activated at'|trans }}</span>
                            <span class="qc-details-value">{% if order.activated_at %}{{ order.activated_at|format_date }}{% else %}-{% endif %}</span>
                        </div>

                        {% if order.period %}
                            <div class="qc-details-row">
                                <span class="qc-details-label">{{ 'Renewal date'|trans }}</span>
                                <span class="qc-details-value">
                                    {% if order.expires_at %}
                                        {{ order.expires_at|format_date }} <span class="text-size-12" style="color:#98a1b3">· {{ order.expires_at|daysleft }} {{ 'day(s)'|trans }}</span>
                                    {% else %}-{% endif %}
                                </span>
                            </div>
                        {% endif %}

                        {% if order.notes %}
                            <div class="qc-details-row">
                                <span class="qc-details-label">{{ 'Order notes'|trans }}</span>
                                <span class="qc-details-value">{{ order.notes|markdown }}</span>
                            </div>
                        {% endif %}

                        {% if order.active_tickets > 0 %}
                            <div class="qc-details-row">
                                <span class="qc-details-label">{{ 'Active support tickets'|trans }}</span>
                                <span class="qc-details-value">
                                    <a href="{{ 'support'|link }}" class="iq-badge bg-soft-danger text-decoration-none">{{ order.active_tickets }}</a>
                                </span>
                            </div>
                        {% endif %}
                    </div>

                    {% if qc_setup %}
                        <div class="alert alert-warning mt-3 mb-0">
                            {{ 'Payment confirmed — your server is being created. Most servers are ready within 30 minutes of payment.'|trans }}
                        </div>
                    {% endif %}
                </div>
                <div class="card-footer d-flex flex-wrap gap-2">
                    {% if order.period and order.status != 'failed_renew' %}
                        <button class="btn btn-primary btn-sm" type="button" id="renewal-button">{{ 'Renew now'|trans }}</button>
                    {% endif %}
                    {% if upgradables %}
                        <button class="btn btn-sm btn-outline-primary" type="button" id="request-upgrade" data-bs-toggle="modal" data-bs-target="#upgrade-request-modal">{{ 'Request Upgrade'|trans }}</button>
                    {% endif %}
                    <button class="btn btn-sm btn-outline-secondary" type="button" id="open-ticket" data-bs-toggle="modal" data-bs-target="#open-ticket-modal">{{ 'Open ticket'|trans }}</button>
                    {% if order.status == 'active' %}
                        <button class="btn btn-sm btn-outline-danger" type="button" id="request-cancel" data-bs-toggle="modal" data-bs-target="#cancel-request-modal">{{ 'Request cancellation'|trans }}</button>
                    {% endif %}
                </div>
            </div>

            {# Service management #}
            {% if guest.system_template_exists({ 'file': service_partial }) %}
                {% set service = (qc_service is defined and qc_service is not empty) ? qc_service : client.order_service({ 'id': order.id }) %}
                {{ include(service_partial, { 'order': order, 'service': service }) }}
            {% endif %}

            {# Order addons #}
            {% if order.group_master == 1 and addons|length > 0 %}
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="header-title">
                        <h4 class="card-title">{{ 'Addons'|trans }}</h4>
                        <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'Addons you have ordered with this service'|trans }}</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-layout-flat">
                            <thead>
                            <tr>
                                <th>{{ 'Product/Service'|trans }}</th>
                                <th>{{ 'Price'|trans }}</th>
                                <th>{{ 'Billing Cycle'|trans }}</th>
                                <th>{{ 'Next due date'|trans }}</th>
                                <th>{{ 'Status'|trans }}</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for i, addon in addons %}
                                <tr>
                                    <td>
                                        <div class="service-cell">
                                            <span class="service-ico bg-soft-primary"><svg fill="currentColor"><use href="#i-folder"/></svg></span>
                                            <div>
                                                <div class="service-name">{{ addon.title }}</div>
                                                <div class="service-sub">#{{ addon.id }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-medium" style="color:var(--iq-heading)">{{ addon.total|money(addon.currency) }}</td>
                                    <td class="text-size-12">{{ addon.period|period_title }}</td>
                                    <td class="text-size-12">{% if addon.expires_at %}{{ addon.expires_at|format_date(pattern="MMM d, yyyy") }}{% else %}—{% endif %}</td>
                                    <td>
                                        {% if addon.status == 'active' %}
                                            <span class="iq-badge bg-soft-success"><span class="iq-badge-dot"></span>{{ mf.status_name(addon.status) }}</span>
                                        {% elseif addon.status == 'pending_setup' %}
                                            <span class="iq-badge bg-soft-warning"><span class="iq-badge-dot"></span>{{ mf.status_name(addon.status) }}</span>
                                        {% else %}
                                            <span class="iq-badge" style="background:#1e1e24;color:#9aa3b2"><span class="iq-badge-dot"></span>{{ mf.status_name(addon.status) }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a class="premium-btn premium-btn-sm" href="{{ '/order/service/manage'|link }}/{{ addon.id }}">{{ 'Manage'|trans }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}

            <div class="modal fade" id="cancel-request-modal" tabindex="-1" role="dialog" aria-labelledby="cancel-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit cancellation request'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="cancel-request-form" class="request-cancellation">
                            <div class="modal-body">
                                <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <input type="hidden" name="rel_task" value="cancel">
                                <div class="mb-3">
                                    <label for="support-helpdesk-id" class="form-label">{{ 'Help desk'|trans }}</label>
                                    {{ mf.selectbox('support_helpdesk_id', client.support_helpdesk_get_pairs, request.support_helpdesk_id, 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" id="subject" value="{{ request.subject|e }}" required/>
                                </div>
                                <div class="mb-3">
                                    <label for="content" class="form-label">{{ 'Reason'|trans }}</label>
                                    <textarea class="form-control" id="content" name="content" rows="5" required>{{ request.content|e }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-danger">{{ 'Request'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="open-ticket-modal" tabindex="-1" role="dialog" aria-labelledby="ticket-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit new support ticket'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="open-ticket-form" class="open-ticket">
                            <div class="modal-body">
                                <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <input type="hidden" name="rel_task" value="open">
                                <div class="mb-3">
                                    <label for="support-helpdesk-id" class="form-label">{{ 'Help desk'|trans }}</label>
                                    {{ mf.selectbox('support_helpdesk_id', client.support_helpdesk_get_pairs, request.support_helpdesk_id, 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" id="subject" value="{{ request.subject|e }}" required/>
                                </div>
                                <div class="mb-3">
                                    <label for="content" class="form-label">{{ 'Message'|trans }}</label>
                                    <textarea class="editor-textarea form-control" id="content" name="content" rows="5" required>{{ request.content|e }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">{{ 'Open ticket'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="upgrade-request-modal" tabindex="-1" role="dialog" aria-labelledby="upgrade-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit upgrade request'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="upgrade-request-form" class="request-upgrade">
                            <div class="modal-body">
                                <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <input type="hidden" name="rel_task" value="upgrade">
                                <div class="mb-3">
                                    <label for="support-helpdesk-id" class="form-label">{{ 'Help desk'|trans }}</label>
                                    {{ mf.selectbox('support_helpdesk_id', client.support_helpdesk_get_pairs, request.support_helpdesk_id, 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="rel_new_value" class="form-label">{{ 'Upgrade to'|trans }}</label>
                                    {{ mf.selectbox('rel_new_value', upgradables, '', 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="subject" class="form-label">{{ 'Content'|trans }}</label>
                                    <textarea id="content" name="content" rows="5" required class="form-control" placeholder="Your comment">{{ 'I would like to upgrade'|trans }} {{ order.title }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary" id="open-ticket-submit">{{ 'Request'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endif %}
{% endblock %}

{% block js %}
{% autoescape "js" %}
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", () => {

            const cancelRequestForm = document.getElementById('cancel-request-form');
            const upgradeRequestForm = document.getElementById('upgrade-request-form');
            const openTicketForm = document.getElementById('open-ticket-form');

            cancelRequestForm.addEventListener('submit', (e) => {
                e.preventDefault();
                API.client.post('support/ticket_create',
                    new FormData(cancelRequestForm).serializeObject(),
                    () => {
                        FOSSBilling.message('Service cancellation request received');
                        const cancelRequestModal = bootstrap.Modal.getInstance(document.getElementById('cancel-request-modal'))
                        cancelRequestModal.hide();
                    },
                    (res) => FOSSBilling.message(`${res.message} (${res.code})`, 'error')
                )
            });

            upgradeRequestForm.addEventListener('submit', (e) => {
                e.preventDefault();
                API.client.post('support/ticket_create',
                    new FormData(upgradeRequestForm).serializeObject(),
                    () => {
                        FOSSBilling.message('Service upgrade request received');
                        const upgradeRequestModal = bootstrap.Modal.getInstance(document.getElementById('upgrade-request-modal'))
                        upgradeRequestModal.hide();
                    },
                    (res) => FOSSBilling.message(`${res.message} (${res.code})`, 'error')
                )
            });

            openTicketForm.addEventListener('submit', (e) => {
                e.preventDefault();
                API.client.post('support/ticket_create',
                    new FormData(openTicketForm).serializeObject(),
                    () => {
                        FOSSBilling.message('Ticket was submitted. If you want to track conversation please go to support section');
                        let openTicketModal = bootstrap.Modal.getInstance(document.getElementById('open-ticket-modal'));
                        openTicketModal.hide();
                    },
                    (res) => FOSSBilling.message(`${res.message} (${res.code})`, 'error')
                )
            });

        });

        $(function () {
            $('#renewal-button').on('click', function (e) {
                e.preventDefault();

                if (confirm("This will generate new invoice. Are you sure you want to continue?")) {
                    bb.post(
                        'client/invoice/renewal_invoice',
                        {order_id: {{ order.id }}, CSRFToken: "{{ CSRFToken }}"},
                        function (result) {
                            bb.redirect("{{ 'invoice'|link }}" + '/' + result);
                        }
                    );
                }
            });
        });
    </script>
{% endautoescape %}
{% endblock %}
