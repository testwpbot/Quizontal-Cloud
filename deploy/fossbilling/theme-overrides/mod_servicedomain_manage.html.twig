{% if order.status == 'active' or order.status == 'failed_renew' %}
    {# Quizontal Cloud: probe the domain-manager module first so the DNS tab
       silently stays hidden whenever the module is inactive. #}
    {% set qc_dns_mod_on = guest.extension_is_on({"mod": "quizontaldomains"}) %}
    {% set qc_dns = qc_dns_mod_on ? client.quizontaldomains_supported({'order_id': order.id}) : {'supported': false} %}
    <style>
    #qc-dns-rows .qc-dns-skel{height:16px;border-radius:6px;background:linear-gradient(90deg,#f0f1f3 25%,#fff 50%,#f0f1f3 75%);background-size:200% 100%;animation:qc-dns-shimmer 1.15s infinite}
    @keyframes qc-dns-shimmer{to{background-position:-200% 0}}
    #qc-dns-rows td{vertical-align:middle}
    .qc-dns-content{word-break:break-all;max-width:340px;display:inline-block}
    .qc-dns-edit-row .form-control,#qc-dns-add .form-control,#qc-dns-add .form-select{margin-bottom:0}
    </style>

    <div class="card mb-4">
        <div class="card-header">
            <div class="flex-column align-items-center py-2">
                <h1 class="mb-1">{{ 'Manage'|trans }} {{ service.domain }}</h1>
            </div>
            <nav class="nav nav-tabs card-header-tabs">
                <a class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details-tab-pane"
                   href="#">{{ 'Details'|trans }}</a>
                <a class="nav-link" id="protect-tab" data-bs-toggle="tab" data-bs-target="#protect-tab-pane"
                   href="#">{{ 'Protection'|trans }}</a>
                <a class="nav-link" id="privacy-tab" data-toggle="tab" data-bs-toggle="tab"
                   data-bs-target="#privacy-tab-pane" href="#">{{ 'Privacy'|trans }}</a>
                <a class="nav-link" id="ns-tab" data-toggle="tab" data-bs-toggle="tab" data-bs-target="#ns-tab-pane"
                   href="#">{{ 'Nameservers'|trans }}</a>
                {% if qc_dns.supported %}
                <a class="nav-link" id="dns-tab" data-toggle="tab" data-bs-toggle="tab" data-bs-target="#dns-tab-pane"
                   href="#">{{ 'DNS Records'|trans }}</a>
                {% endif %}
                <a class="nav-link" id="whois-tab" data-toggle="tab" data-bs-toggle="tab"
                   data-bs-target="#whois-tab-pane" href="#">{{ 'Whois'|trans }}</a>
                <a class="nav-link" id="transfer-tab" data-toggle="tab" data-bs-toggle="tab"
                   data-bs-target="#transfer-tab-pane" href="#">{{ 'Transfer'|trans }}</a>
            </nav>
        </div>
        <div class="tab-content">
            {# Domain details #}
            <div class="card-body tab-pane active" id="details-tab-pane" role="tabpanel" tabindex="0">
                <div class="tab-pane container active" id="details">
                    <h5 class="mb-3 mt-1">{{ 'Domain details'|trans }}</h5>
                    <div class="d-flex justify-content-around py-3">
                        <div class="d-flex flex-column">
                            <span class="fs-6 text-muted">{{ 'Name'|trans }}</span>
                            <a class="fs-4" target="_blank" href="http://{{ service.domain }}">{{ service.domain }}</a>
                        </div>
                        <div class="d-flex flex-column">
                            <span class="fs-6 text-muted">{{ 'Expires on'|trans }}</span>
                            <span class="fs-4">{{ service.expires_at|format_date(pattern="MMM dd, yyyy") }}</span>
                        </div>
                        <div class="d-flex flex-column">
                            <span class="fs-6 text-muted">{{ 'Registered on'|trans }}</span>
                            <span class="fs-4">{{ service.registered_at|format_date(pattern="MMM dd, yyyy") }}</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Domain protection #}
            <div class="card-body tab-pane" id="protect-tab-pane" role="tabpanel" tabindex="0">
                <div class="mb-3">
                    <h5 class="mt-1 mb-1">{{ 'Domain Protection'|trans }}</h5>
                    <span class="small text-secondary">{{ 'Domain locking is a security feature which prevents your domain name from being transferred without first unlocking it. When this is enabled, a domain cannot be transferred even with the transfer code.'|trans }}</span>
                </div>
                <button class="btn btn-danger icon-link" type="button" id="domain-unlock" {% if service.locked == 0 %}style="display:none;"{% endif %}>
                    <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M10 13C11.1 13 12 13.89 12 15C12 16.11 11.11 17 10 17S8 16.11 8 15 8.9 13 10 13M18 1C15.24 1 13 3.24 13 6V8H4C2.9 8 2 8.9 2 10V20C2 21.1 2.9 22 4 22H16C17.1 22 18 21.1 18 20V10C18 8.9 17.1 8 16 8H15V6C15 4.34 16.34 3 18 3S21 4.34 21 6V8H23V6C23 3.24 20.76 1 18 1M16 10V20H4V10H16Z" /></svg>
                    {{ 'Unlock'|trans }}
                </button>
                <button class="btn btn-primary icon-link" type="button" id="domain-lock" {% if service.locked == 1 %}style="display:none;"{% endif %}>
                    <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12,17C10.89,17 10,16.1 10,15C10,13.89 10.89,13 12,13A2,2 0 0,1 14,15A2,2 0 0,1 12,17M18,20V10H6V20H18M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" /></svg>
                    {{ 'Lock'|trans }}
                </button>
            </div>

            {# Domain privacy settings #}
            <div class="card-body tab-pane" id="privacy-tab-pane" role="tabpanel" tabindex="0">
                <div class="mb-3">
                    <h5 class="mt-1 mb-1">{{ 'Domain Privacy Settings'|trans }}</h5>
                    <span class="small text-muted">{{ 'If you would like to hide domain contact information which is shown on WHOIS you can enable privacy protection. Once domain privacy protection is enabled no one will know who registered this service. And once you decide to disable privacy protection, information that is listed above on "Update Domain Contact Details" section will be seen on domain WHOIS again.'|trans }}</span>
                </div>
                <button class="btn btn-warning" type="button" id="domain-disable-pp" {% if service.privacy == 0 %}style="display:none;"{% endif %}>{{ 'Disable Privacy protection'|trans }}</button>
                <button class="btn btn-primary" type="button" id="domain-enable-pp" {% if service.privacy == 1 %}style="display:none;"{% endif %}>{{ 'Enable Privacy protection'|trans }}</button>
            </div>

            {# Domain nameservers #}
            <div class="card-body tab-pane" id="ns-tab-pane" role="tabpanel" tabindex="0">
                <div class="mb-3">
                    <h5 class="mt-1 mb-1">{{ 'Update Nameservers'|trans }}</h5>
                    <span class="small text-muted">{{ 'If you would like to host this domain with another company you can update nameservers.'|trans }}</span>
                </div>
                {# Quizontal Cloud: the live nameservers, shown clearly. Synced from the registrar so this is never blank. #}
                {% set qc_ns_list = [] %}
                {% for qc_ns in [service.ns1, service.ns2, service.ns3, service.ns4] %}
                    {% if qc_ns is not empty %}{% set qc_ns_list = qc_ns_list|merge([qc_ns]) %}{% endif %}
                {% endfor %}
                <div class="rounded-3 p-3 mb-3" style="background:#fdf2f7;border:1px solid #f3c6db">
                    <div class="d-flex align-items-center mb-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="#e31c64" class="me-2"><path d="M4 1h16a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1m0 8h16a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1m2 1.5A1.5 1.5 0 1 0 7.5 9 1.5 1.5 0 0 0 6 10.5M6 2.5A1.5 1.5 0 1 0 7.5 1 1.5 1.5 0 0 0 6 2.5M13 11h4v1h-4zM13 3h4v1h-4z"/></svg>
                        <strong class="small">{{ 'Current nameservers'|trans }}</strong>
                    </div>
                    {% if qc_ns_list is not empty %}
                    <ul class="list-unstyled mb-2 small">
                        {% for qc_ns in qc_ns_list %}
                        <li class="mb-1"><code>{{ qc_ns }}</code></li>
                        {% endfor %}
                    </ul>
                    <span class="small text-muted">{{ 'These servers answer DNS for your domain. Only change them below if you are moving DNS to an external provider.'|trans }}</span>
                    {% else %}
                    <span class="small text-muted">{{ 'Your nameservers are being assigned for this domain — refresh this page in a moment.'|trans }}</span>
                    {% endif %}
                </div>
                <form class="api-form" action="{{ 'api/client/servicedomain/update_nameservers'|link }}" data-api-msg="{{ 'Nameservers updated'|trans }}" method="post">
                    <div class="row">
                        <div class="col-md-12">
                            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                            <div class="mb-3 row">
                                <div class="col-md-5">
                                    <label for="ns1" class="form-label">{{ 'Nameserver 1'|trans }}</label>
                                    <input class="form-control" type="text" name="ns1" id="ns1"
                                           value="{{ request.ns1|default(service.ns1) }}" required>
                                </div>
                                <div class="col-md-5">
                                    <label for="ns2" class="form-label">{{ 'Nameserver 2'|trans }}</label>
                                    <input class="form-control" type="text" name="ns2" id="ns2"
                                           value="{{ request.ns2|default(service.ns2) }}" required>
                                </div>
                            </div>
                            <div class="mb-3 row">
                                <div class="col-md-5">
                                    <label for="ns3" class="form-label">{{ 'Nameserver 3'|trans }}</label>
                                    <input class="form-control" type="text" name="ns3" id="ns3"
                                           value="{{ request.ns3|default(service.ns3) }}">
                                </div>
                                <div class="col-md-5">
                                    <label for="ns4" class="form-label">{{ 'Nameserver 4'|trans }}</label>
                                    <input class="form-control" type="text" name="ns4" id="ns4"
                                           value="{{ request.ns4|default(service.ns4) }}">
                                </div>
                            </div>
                            <input type="hidden" name="order_id" value="{{ order.id }}">
                            <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
                        </div>
                    </div>
                </form>
            </div>

            {% if qc_dns.supported %}
            {# Quizontal Cloud DNS zone manager — live at the registrar. #}
            <div class="card-body tab-pane" id="dns-tab-pane" role="tabpanel" tabindex="0">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h5 class="mt-1 mb-1">{{ 'DNS records'|trans }}</h5>
                        <span class="small text-muted">{{ 'Manage DNS records for'|trans }} <strong>{{ qc_dns.domain }}</strong>. {{ 'Changes apply immediately and resolve worldwide within minutes.'|trans }}</span>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" id="qc-dns-reload" type="button">{{ 'Refresh'|trans }}</button>
                </div>
                {% if qc_dns.registrar_nameservers is same as(false) %}
                <div class="alert alert-warning mb-3">{{ 'Heads up: this domain currently uses custom nameservers, so these zone records do not affect live DNS until the domain points back to our default nameservers (see the Nameservers tab).'|trans }}</div>
                {% endif %}
                <div class="alert alert-danger" id="qc-dns-error" style="display:none"></div>
                <div class="table-responsive">
                    <table class="table card-table table-vcenter mb-0">
                        <thead>
                            <tr>
                                <th style="width:86px">{{ 'Type'|trans }}</th>
                                <th style="width:150px">{{ 'Name'|trans }}</th>
                                <th>{{ 'Content'|trans }}</th>
                                <th style="width:88px">{{ 'TTL'|trans }}</th>
                                <th style="width:72px">{{ 'Priority'|trans }}</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody id="qc-dns-rows"></tbody>
                    </table>
                </div>
                <h6 class="mt-4 mb-2">{{ 'Add a new record'|trans }}</h6>
                <form id="qc-dns-add" class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label" for="qc-dns-add-type">{{ 'Type'|trans }}</label>
                        <select class="form-select" id="qc-dns-add-type"></select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="qc-dns-add-name">{{ 'Name'|trans }}</label>
                        <input class="form-control" id="qc-dns-add-name" placeholder="@ or www" autocomplete="off">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="qc-dns-add-content">{{ 'Content'|trans }}</label>
                        <input class="form-control" id="qc-dns-add-content" placeholder="192.0.2.10" autocomplete="off" required>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label" for="qc-dns-add-ttl">{{ 'TTL'|trans }}</label>
                        <input class="form-control" id="qc-dns-add-ttl" type="number" value="600" min="600" step="60">
                    </div>
                    <div class="col-md-2" id="qc-dns-add-prio-wrap" style="display:none">
                        <label class="form-label" for="qc-dns-add-prio">{{ 'Priority'|trans }}</label>
                        <input class="form-control" id="qc-dns-add-prio" type="number" value="10" min="0">
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" id="qc-dns-add-btn" type="submit">{{ 'Add record'|trans }}</button>
                    </div>
                </form>
                <p class="small text-muted mt-2 mb-0"><strong>{{ 'Hints'|trans }}:</strong> {{ '@ or an empty name targets the root domain. Point your website with an A record, mail with MX, and verifications with TXT. Minimum TTL is 600 seconds.'|trans }}</p>
            </div>
            {% endif %}

            {# Domain WHOIS #}
            <div class="card-body tab-pane" id="whois-tab-pane" role="tabpanel" tabindex="0">
                <div class="mb-3">
                    <h5 class="mt-1 mb-1">{{ 'Update domain contact details'|trans }}</h5>
                    <span class="small text-secondary">{{ 'Domain contact details will be displayed once someone will check WHOIS output (which is public) of your service. This will update Technical, Billing and Admin contacts for this service. You can enable domain privacy protection if you want to hide your public WHOIS information.'|trans }}</span>
                </div>
                <form class="api-form" method="post" action="{{ 'api/client/servicedomain/update_contacts'|link }}" data-api-msg="{{ 'Contact details updated'|trans }}">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    <div class="mb-3 row">
                        <div class="col-md-5">
                            <label for="whois_first_name" class="form-label">{{ 'First Name'|trans }}</label>
                            <input class="form-control" type="text" name="contact[first_name]" id="whois_first_name"
                                   value="{{ request.first_name|default(service.contact.first_name) }}" required>
                        </div>
                        <div class="col-md-5">
                            <label for="whois_last_name" class="form-label">{{ 'Last Name'|trans }}</label>
                            <input class="form-control" type="text" name="contact[last_name]" id="whois_last_name"
                                   value="{{ request.last_name|default(service.contact.last_name) }}" required>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-md-5">
                            <label for="whois_email" class="form-label">{{ 'Email'|trans }}</label>
                            <input class="form-control" type="text" name="contact[email]" id="whois_email"
                                   value="{{ request.email|default(service.contact.email) }}" required>
                        </div>
                        <div class="col-md-5">
                            <label for="whois_company" class="form-label">{{ 'Company'|trans }}</label>
                            <input class="form-control" type="text" name="contact[company]" id="whois_company"
                                   value="{{ request.company|default(service.contact.company) }}">
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-md-5">
                            <label for="whois_address1" class="form-label">{{ 'Address Line 1'|trans }}</label>
                            <input class="form-control" type="text" name="contact[address1]" id="whois_address1"
                                   value="{{ request.address1|default(service.contact.address1) }}" required>
                        </div>
                        <div class="col-md-5">
                            <label for="whois_address2" class="form-label">{{ 'Address Line 2'|trans }}</label>
                            <input class="form-control" type="text" name="contact[address2]" id="whois_address2"
                                   value="{{ request.address2|default(service.contact.address2) }}">
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-md-5">
                            <label for="whois_country" class="form-label">{{ 'Country'|trans }}</label>
                            <input class="form-control" type="text" name="contact[country]" id="whois_country"
                                   value="{{ request.country|default(service.contact.country) }}" required>
                        </div>
                        <div class="col-md-5">
                            <label for="whois_city" class="form-label">{{ 'City'|trans }}</label>
                            <input class="form-control" type="text" name="contact[city]" id="whois_city"
                                   value="{{ request.city|default(service.contact.city) }}" required>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-md-5">
                            <label for="whois_state" class="form-label">{{ 'State'|trans }}</label>
                            <input class="form-control" type="text" name="contact[state]" id="whois_state"
                                   value="{{ request.state|default(service.contact.state) }}" required>
                        </div>

                        <div class="col-md-5">
                            <label for="whois_postcode" class="form-label">{{ 'Zip'|trans }}</label>
                            <input class="form-control" type="text" name="contact[postcode]" id="whois_postcode"
                                   value="{{ request.postcode|default(service.contact.postcode) }}" required>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-md-5">
                            <label for="whois_phone_cc" class="form-label">{{ 'Phone Country Code'|trans }}</label>
                            <input class="form-control" type="text" name="contact[phone_cc]" id="whois_phone_cc"
                                   value="{{ request.phone_cc|default(service.contact.phone_cc) }}" required>
                        </div>
                        <div class="col-md-5">
                            <label for="whois_phone" class="form-label">{{ 'Phone number'|trans }}</label>
                            <input class="form-control" type="text" name="contact[phone]" id="whois_phone"
                                   value="{{ request.phone|default(service.contact.phone) }}" required>
                        </div>
                    </div>
                    <input type="hidden" name="order_id" value="{{ order.id }}">
                    <button class="btn btn-primary" type="submit" value="{{ 'Update' }}">{{ 'Update'|trans }}</button>
                </form>
            </div>

            {# Domain transfer #}
            <div class="card-body tab-pane" id="transfer-tab-pane" role="tabpanel" tabindex="0">
                <div class="mb-3">
                    <h5 class="mt-1 mb-1">{{ 'Domain Secret'|trans }}</h5>
                    <span class="small text-secondary">{{ 'Most domain names (except a few top-level domains like .EU and .UK) have a Domain Secret Key/Authorization Code (EPP Code) associated with them. This code is typically required when transferring the domain to a new registrar.'|trans }}</span>
                </div>
                <button class="btn btn-primary" type="button" id="get-epp">{{ 'Get EPP code'|trans }}</button>
            </div>
        </div>
    </div>

    {% block js %}
        <script>
            $(function () {
                $('.domain-tabs a').on('click', function (e) {
                    e.preventDefault();

                    $(this).tab('show');
                });

                $('#domain-lock').on('click', function (event) {
                    event.preventDefault();

                    bb.post(
                        'client/servicedomain/lock',
                        {order_id: {{ order.id }}, CSRFToken: "{{ CSRFToken }}"},
                        function (result) {
                            FOSSBilling.message('Domain locked');
                            $('#domain-lock').toggle();
                            $('#domain-unlock').toggle();
                        }
                    );
                });

                $('#domain-unlock').on('click', function (event) {
                    event.preventDefault();

                    bb.post(
                        'client/servicedomain/unlock',
                        {order_id: {{ order.id }}, CSRFToken: "{{ CSRFToken }}"},
                        function (result) {
                            FOSSBilling.message('Domain unlocked');
                            $('#domain-lock').toggle();
                            $('#domain-unlock').toggle();
                        }
                    );
                });

                $('#domain-enable-pp').on('click', function (event) {
                    event.preventDefault();

                    bb.post(
                        'client/servicedomain/enable_privacy_protection',
                        {order_id: {{ order.id }}, CSRFToken: "{{ CSRFToken }}"},
                        function (result) {
                            FOSSBilling.message('Privacy Protection enabled');
                            $('#domain-enable-pp').toggle();
                            $('#domain-disable-pp').toggle();
                        }
                    );
                });

                $('#domain-disable-pp').on('click', function (event) {
                    event.preventDefault();

                    bb.post(
                        'client/servicedomain/disable_privacy_protection',
                        {order_id: {{ order.id }}, CSRFToken: "{{ CSRFToken }}"},
                        function (result) {
                            FOSSBilling.message('Privacy Protection disabled');
                            $('#domain-enable-pp').toggle();
                            $('#domain-disable-pp').toggle();
                        }
                    );
                });

                $('#get-epp').on('click', function (event) {
                    event.preventDefault();
                    bb.post(
                        'client/servicedomain/get_transfer_code',
                        {order_id: {{ order.id }}, CSRFToken: "{{ CSRFToken }}"},
                        function (result) {
                            FOSSBilling.message('Domain transfer code is: ' + result);
                        }
                    );
                });
            });
        </script>
        {% if qc_dns.supported %}
        <script>
        (function () {
            var ORDER_ID = {{ order.id }};
            var TOKEN = '{{ CSRFToken }}';
            var TYPES = ['A', 'AAAA', 'CNAME', 'ALIAS', 'MX', 'TXT', 'SRV', 'CAA'];
            var tbody = document.getElementById('qc-dns-rows');
            var errorBox = document.getElementById('qc-dns-error');
            var addForm = document.getElementById('qc-dns-add');
            var addBtn = document.getElementById('qc-dns-add-btn');
            var addType = document.getElementById('qc-dns-add-type');
            var prioWrap = document.getElementById('qc-dns-add-prio-wrap');
            var reloadBtn = document.getElementById('qc-dns-reload');
            var editId = null;
            var lastRows = [];
            if (!tbody || !addForm) return;

            TYPES.forEach(function (t) {
                var o = document.createElement('option');
                o.value = t; o.textContent = t;
                addType.appendChild(o);
            });

            function esc(s) {
                return String(s === null || s === undefined ? '' : s).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }
            function byId(id) { return document.getElementById(id); }
            function shownName(n) { return n === '' ? '@' : n; }
            function prioFor(type) { return type === 'MX' || type === 'SRV'; }
            function showError(message) {
                if (!errorBox) return;
                errorBox.textContent = message || '{{ 'Something went wrong. Please try again.'|trans }}';
                errorBox.style.display = '';
            }
            function clearError() { if (errorBox) errorBox.style.display = 'none'; }
            function notify(text) { if (window.FOSSBilling && FOSSBilling.message) FOSSBilling.message(text); }

            function api(endpoint, data) {
                data = data || {};
                data.order_id = ORDER_ID;
                data.CSRFToken = TOKEN;
                return fetch('/api/client/quizontaldomains/' + endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(data)
                }).then(function (response) { return response.json(); }).then(function (json) {
                    if (json && json.error) {
                        throw new Error(json.error.message ? String(json.error.message) : '{{ 'The domain service reported an error.'|trans }}');
                    }
                    return json ? json.result : null;
                });
            }

            function typeSelect(current) {
                var html = '<select class="form-select form-select-sm" id="qc-dns-ed-type">';
                TYPES.forEach(function (t) {
                    html += '<option value="' + t + '"' + (t === current ? ' selected' : '') + '>' + t + '</option>';
                });
                return html + '</select>';
            }

            function loading() {
                tbody.innerHTML = '<tr><td colspan="6">' +
                    '<div class="qc-dns-skel" style="width:55%"></div>' +
                    '<div class="qc-dns-skel" style="width:88%;margin-top:8px"></div></td></tr>';
            }

            function render() {
                if (!lastRows.length) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-muted text-center py-4">{{ 'No DNS records yet — add your first one below.'|trans }}</td></tr>';
                    return;
                }
                tbody.innerHTML = lastRows.map(function (r) {
                    if (editId === r.id) {
                        return '<tr class="qc-dns-edit-row">' +
                            '<td>' + typeSelect(r.type) + '</td>' +
                            '<td><input class="form-control form-control-sm" id="qc-dns-ed-name" value="' + esc(r.name) + '" autocomplete="off"></td>' +
                            '<td><input class="form-control form-control-sm" id="qc-dns-ed-content" value="' + esc(r.content) + '" autocomplete="off"></td>' +
                            '<td><input class="form-control form-control-sm" id="qc-dns-ed-ttl" type="number" min="600" step="60" value="' + esc(r.ttl) + '"></td>' +
                            '<td><input class="form-control form-control-sm" id="qc-dns-ed-prio" type="number" min="0" value="' + esc(r.prio) + '"' + (prioFor(r.type) ? '' : ' disabled') + '></td>' +
                            '<td class="text-end text-nowrap">' +
                                '<button type="button" class="btn btn-primary btn-sm" data-dns-action="save" data-id="' + esc(r.id) + '">{{ 'Save'|trans }}</button> ' +
                                '<button type="button" class="btn btn-outline-secondary btn-sm" data-dns-action="cancel">{{ 'Cancel'|trans }}</button>' +
                            '</td></tr>';
                    }
                    return '<tr>' +
                        '<td><span class="badge bg-secondary">' + esc(r.type) + '</span></td>' +
                        '<td><strong>' + esc(shownName(r.name)) + '</strong></td>' +
                        '<td><code class="qc-dns-content">' + esc(r.content) + '</code></td>' +
                        '<td>' + esc(r.ttl) + '</td>' +
                        '<td>' + (prioFor(r.type) ? esc(r.prio) : '\u2014') + '</td>' +
                        '<td class="text-end text-nowrap">' +
                            '<button type="button" class="btn btn-outline-primary btn-sm" data-dns-action="edit" data-id="' + esc(r.id) + '">{{ 'Edit'|trans }}</button> ' +
                            '<button type="button" class="btn btn-outline-danger btn-sm" data-dns-action="delete" data-id="' + esc(r.id) + '">{{ 'Delete'|trans }}</button>' +
                        '</td></tr>';
                }).join('');
            }

            function load() {
                loading();
                clearError();
                api('records').then(function (res) {
                    lastRows = (res && res.records) || [];
                    render();
                }).catch(function (e) {
                    tbody.innerHTML = '';
                    showError(e.message);
                });
            }

            tbody.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-dns-action]');
                if (!btn) return;
                e.preventDefault();
                clearError();
                var action = btn.getAttribute('data-dns-action');
                var id = btn.getAttribute('data-id');
                if (action === 'edit') { editId = id; render(); return; }
                if (action === 'cancel') { editId = null; render(); return; }
                if (action === 'save') {
                    btn.disabled = true;
                    api('update', {
                        record_id: id,
                        type: byId('qc-dns-ed-type').value,
                        name: byId('qc-dns-ed-name').value,
                        content: byId('qc-dns-ed-content').value,
                        ttl: byId('qc-dns-ed-ttl').value,
                        prio: byId('qc-dns-ed-prio').value
                    }).then(function () {
                        editId = null;
                        notify('{{ 'Record updated'|trans }}');
                        load();
                    }).catch(function (err) { btn.disabled = false; showError(err.message); });
                    return;
                }
                if (action === 'delete') {
                    if (!confirm('{{ 'Delete this DNS record?'|trans }}')) return;
                    btn.disabled = true;
                    api('delete', { record_id: id }).then(function () {
                        notify('{{ 'Record deleted'|trans }}');
                        load();
                    }).catch(function (err) { btn.disabled = false; showError(err.message); });
                }
            });

            addType.addEventListener('change', function () {
                prioWrap.style.display = prioFor(addType.value) ? '' : 'none';
            });

            addForm.addEventListener('submit', function (e) {
                e.preventDefault();
                clearError();
                addBtn.disabled = true;
                api('create', {
                    type: addType.value,
                    name: byId('qc-dns-add-name').value,
                    content: byId('qc-dns-add-content').value,
                    ttl: byId('qc-dns-add-ttl').value,
                    prio: byId('qc-dns-add-prio').value
                }).then(function (res) {
                    addBtn.disabled = false;
                    byId('qc-dns-add-name').value = '';
                    byId('qc-dns-add-content').value = '';
                    notify(res && res.already_existed ? '{{ 'That exact record already existed — no duplicate created.'|trans }}' : '{{ 'Record added'|trans }}');
                    load();
                }).catch(function (err) { addBtn.disabled = false; showError(err.message); });
            });

            if (reloadBtn) reloadBtn.addEventListener('click', function (e) { e.preventDefault(); load(); });

            load();
        })();
        </script>
        {% endif %}
    {% endblock %}
{% endif %}
