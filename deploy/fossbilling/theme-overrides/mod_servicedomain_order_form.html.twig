{% set periods = guest.system_periods %}
{% set pricing = product.pricing %}
{% set transfer_tlds = guest.serviceDomain_tlds({ "allow_transfer": 1 }) %}
{% set tlds = guest.serviceDomain_tlds({"allow_register":1}) %}
<div class="d-flex mb-3">
    <nav class="nav nav-pills flex-column border-end me-3 gap-2">
        {% if tlds is not empty %}
            <a class="nav-link me-3 py-1 px-2 fs-7 active" href="#" id="register-tab" data-bs-toggle="tab" data-bs-target="#register-tab-pane"
                role="tab" aria-controls="register-tab-pane">Register</a>
        {% endif %}
        {% if transfer_tlds is not empty %}
        <a class="nav-link me-3 py-1 px-2 fs-7 {% if tlds is empty %} active {% endif %}" href="#" id="transfer-tab" data-bs-toggle="tab" data-bs-target="#transfer-tab-pane"
               role="tab" aria-controls="transfer-tab-pane">Transfer</a>
        {% endif %}
    </nav>
    <div class="tab-content">
        {% if tlds is not empty %}
            <div class="tab-pane show active" id="register-tab-pane" role="tabpanel" aria-labelledby="register-tab" tabindex="0">
                <div class="row">
                    <div class="col-sm-12">
                        <label class="form-label">{{ 'Register a new domain'|trans }}</label>
                        <div class="d-flex gap-2">
                            <div class="input-group">
                                <input class="form-control form-control-sm w-75" type="text" name="register_sld"
                                    value="{{ request.register_sld }}"
                                    placeholder="{{ 'Enter new domain name to register'|trans }}">
                                <select class="form-select form-select-sm w-25" name="register_tld">
                                    {% for tld in tlds %}
                                        <option value="{{ tld.tld }}" label="{{ tld.tld }}"{% if request.register_tld == tld.tld %} selected{% endif %}>{{ tld.tld }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button class="btn btn-sm btn-dark" type="button" id="domain-check">{{ 'Check'|trans }}</button>
                        </div>
                        {# Quizontal: inline status + skeleton shimmer (replaces the stock spinner) #}
                        <div class="qc-dom-status" id="qcRegStatus" hidden>
                            <div class="qc-dom-skel" id="qcRegSkel">
                                <span class="qc-skel-bar" style="width:52%"></span>
                                <span class="qc-skel-bar" style="width:30%"></span>
                            </div>
                            <div class="small" id="qcRegMsg" hidden></div>
                        </div>
                    </div>
                    <div class="c">
                        <div class="onAfterDomainCheck" style="display:none;">
                            <label class="mt-2">
                                <select class="form-select form-select-sm" name="register_years" id="registration-years"></select>
                            </label>
                            <br/>
                            <div class="form-check form-switch my-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="nameserversCb">
                                <label class="form-check-label text-sm" for="nameserversCb">
                                    {{ 'I want to use my nameservers'|trans }}
                                </label>
                            </div>
                            <div id="nameservers" class="flex-column row" style="display:none;">
                                <div class="mb-2 col-md-6">
                                    <input class="form-control form-control-sm" type="text" name="ns1" value="" placeholder="{{ 'Nameserver 1'|trans }}"/>
                                </div>
                                <div class="mb-2 col-md-6">
                                    <input class="form-control form-control-sm" type="text" name="ns2" value="" placeholder="{{ 'Nameserver 2'|trans }}"/>
                                </div>
                                <div class="mb-2 col-md-6">
                                    <input class="form-control form-control-sm" type="text" name="ns3" value="" placeholder="{{ 'Nameserver 3'|trans }}"/>
                                </div>
                                <div class="mb-2 col-md-6">
                                    <input class="form-control form-control-sm" type="text" name="ns4" value="" placeholder="{{ 'Nameserver 4'|trans }}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
        {% if transfer_tlds is not empty %}
            <div class="tab-pane {% if tlds is empty %} show active {% endif %}" id="transfer-tab-pane" role="tabpanel" aria-labelledby="transfer-tab" tabindex="0">
                <div class="row">
                    <div class="col-sm-12">
                        <label class="form-label">{{ 'Transfer a new domain'|trans }}</label>
                        <div class="d-flex gap-2">
                            <div class="input-group">
                                <input class="form-control form-control-sm w-75" type="text" name="transfer_sld"
                                       value="{{ request.transfer_sld }}"
                                       placeholder="{{ 'Enter your domain name to transfer'|trans }}">
                                <select class="form-select form-select-sm w-25" name="transfer_tld">
                                    {% for tld in transfer_tlds %}
                                        <option value="{{ tld.tld }}" label="{{ tld.tld }}"{% if request.transfer_tld == tld.tld %} selected{% endif %}>{{ tld.tld }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button class="btn btn-sm btn-dark" type="button" id="transfer-check">{{ 'Check'|trans }}</button>
                        </div>
                        {# Quizontal: inline status + skeleton shimmer #}
                        <div class="qc-dom-status" id="qcTrStatus" hidden>
                            <div class="qc-dom-skel" id="qcTrSkel">
                                <span class="qc-skel-bar" style="width:52%"></span>
                                <span class="qc-skel-bar" style="width:30%"></span>
                            </div>
                            <div class="small" id="qcTrMsg" hidden></div>
                        </div>
                    </div>
                    <div id="domain-transfer-config" style="display:none;">
                        <p class="fs-7 mt-2">{{ 'Transfer price is'|trans }}&nbsp;<span class="fw-bold" id="transfer-price"></span></p>
                        <input class="form-control form-control-sm" type="text" name="transfer_code" value="{{ request.transfer_code }}"
                               style="width: 200px" placeholder="{{ 'Enter domain transfer code'|trans }}">
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<input type="hidden" name="id" value="{{ product.id }}"/>
<input type="hidden" name="action" value="register" id="domain-action"/>

{% set currency = guest.cart_get_currency %}

<style>
    .qc-dom-status { margin-top: .5rem; }
    .qc-dom-skel { display: flex; flex-direction: column; gap: 8px; padding: 6px 0 2px; }
    .qc-skel-bar {
        display: block; height: 10px; border-radius: 999px;
        background: linear-gradient(90deg, rgba(134,134,139,.14) 20%, rgba(134,134,139,.34) 48%, rgba(134,134,139,.14) 76%);
        background-size: 400% 100%; animation: qcSkel 1.1s ease-in-out infinite;
    }
    .qc-skel-bar + .qc-skel-bar { animation-delay: .14s; }
    @keyframes qcSkel { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
    @media (prefers-reduced-motion: reduce) { .qc-skel-bar { animation: none; } }
</style>

<script type="text/javascript">
    (function () {
        // ---------------------------------------------------------------
        // Quizontal UX layer:
        // - our own skeleton shimmer while checking (never the stock spinner)
        // - registrar cooldowns ("retry in Ns") are retried silently
        // - results and errors render inline next to the input
        // ---------------------------------------------------------------

        var nameserversCbEl = document.getElementById('nameserversCb');
        var nameserversEl = document.getElementById('nameservers');
        if (nameserversCbEl && nameserversEl) {
            nameserversCbEl.addEventListener('change', function () {
                nameserversEl.style.display = nameserversCbEl.checked ? 'flex' : 'none';
            });
        }

        // Direct guest-API calls: same-origin, no global loader overlay.
        function qcApi(endpoint, data) {
            return fetch('/api/guest/' + endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(data || {})
            }).then(function (response) { return response.json(); }).then(function (json) {
                if (json && json.error) {
                    var message = json.error.message ? String(json.error.message) : '{{ 'The domain service reported an error.'|trans }}';
                    var error = new Error(message);
                    var retry = /retry in (\d+)\s*s/i.exec(message);
                    if (retry) { error.retryAfter = parseInt(retry[1], 10); }
                    throw error;
                }
                return json ? json.result : null;
            });
        }

        function cleanMessage(message) {
            return String(message || '{{ 'Something went wrong. Please try again.'|trans }}')
                .replace(/\s*\(\s*retry in \d+\s*s\s*\)\s*/i, ' {{ 'Please wait a moment and try again.'|trans }}');
        }

        function domStatus(prefix, state, text) {
            var wrap = document.getElementById(prefix + 'Status');
            if (!wrap) { return; }
            var skel = document.getElementById(prefix + 'Skel');
            var msg = document.getElementById(prefix + 'Msg');
            wrap.hidden = false;
            skel.hidden = !(state === 'loading' || state === 'hint');
            msg.hidden = !text;
            if (text) {
                msg.textContent = text;
                msg.className = 'small ' + (state === 'ok' ? 'text-success' : (state === 'error' ? 'text-danger' : 'text-muted'));
            }
        }

        function hideStatus(prefix) {
            var wrap = document.getElementById(prefix + 'Status');
            if (wrap) { wrap.hidden = true; }
        }

        function enableNext() {
            $('#config-next').show();
            $('#config-next').prop('disabled', false);
        }

        function setPricing(prefix, tld, domainLabel) {
            return qcApi('servicedomain/pricing', { tld: tld }).then(function (result) {
                if (prefix === 'qcReg') {
                    var select = document.getElementById('registration-years');
                    select.innerHTML = '';
                    for (var i = 1; i < 6; i++) {
                        var price = bb.currency(result.price_registration, {{ currency.conversion_rate }}, '{{ currency.code }}', i);
                        select.appendChild(new Option(i + '{{ ' Year/s @ '|trans }}' + price, i));
                    }
                } else {
                    $('#transfer-price').text(bb.currency(result.price_transfer, {{ currency.conversion_rate }}, '{{ currency.code }}'));
                }
                $('#domain-name').text(domainLabel);
                enableNext();
                {% if request.auto and request.register_sld %}
                // Storefront "Add to cart" deep link — availability passed, go straight to checkout.
                setTimeout(function () {
                    var next = $('#config-next');
                    if (next.length && !next.prop('disabled')) { next.trigger('click'); }
                }, 350);
                {% endif %}
            }).catch(function (error) {
                domStatus(prefix, 'error', cleanMessage(error.message));
            });
        }

        // ------------------------- register -------------------------
        var registerBtn = document.getElementById('domain-check');

        function runRegisterCheck(attempt) {
            var sldInput = document.querySelector('input[name="register_sld"]');
            var tldInput = document.querySelector('select[name="register_tld"]');
            var sld = (sldInput.value || '').toLowerCase().trim();
            if (sld === '') { sldInput.focus(); return; }
            var tld = tldInput.value;
            document.getElementById('domain-action').value = 'register';
            registerBtn.disabled = true;
            domStatus('qcReg', 'loading');

            qcApi('servicedomain/check', { sld: sld, tld: tld }).then(function () {
                domStatus('qcReg', 'ok', '✓ ' + sld + tld + ' {{ 'is available'|trans }}');
                registerBtn.style.display = 'none';
                $('.onAfterDomainCheck').fadeIn('fast');
                $('#register .order-button').show();
                setPricing('qcReg', tld, sld + tld);
            }).catch(function (error) {
                if (error.retryAfter && attempt < 3) {
                    domStatus('qcReg', 'hint', '{{ 'The availability checker is cooling down — retrying automatically…'|trans }}');
                    setTimeout(function () { runRegisterCheck(attempt + 1); }, error.retryAfter * 1000 + 400);
                    return;
                }
                domStatus('qcReg', 'error', cleanMessage(error.message));
                registerBtn.disabled = false;
            });
        }

        // ------------------------- transfer -------------------------
        var transferBtn = document.getElementById('transfer-check');

        function runTransferCheck(attempt) {
            var sldInput = document.querySelector('input[name="transfer_sld"]');
            var tldInput = document.querySelector('select[name="transfer_tld"]');
            var sld = (sldInput.value || '').toLowerCase().trim();
            if (sld === '') { sldInput.focus(); return; }
            var tld = tldInput.value;
            document.getElementById('domain-action').value = 'transfer';
            transferBtn.disabled = true;
            domStatus('qcTr', 'loading');

            qcApi('servicedomain/can_be_transferred', { sld: sld, tld: tld }).then(function () {
                hideStatus('qcTr');
                transferBtn.style.display = 'none';
                $('#domain-transfer-config').fadeIn('fast');
                $('.onAfterDomainCheck').fadeIn('fast');
                $('#transfer .order-button').show();
                setPricing('qcTr', tld, sld + tld);
            }).catch(function (error) {
                if (error.retryAfter && attempt < 3) {
                    domStatus('qcTr', 'hint', '{{ 'The availability checker is cooling down — retrying automatically…'|trans }}');
                    setTimeout(function () { runTransferCheck(attempt + 1); }, error.retryAfter * 1000 + 400);
                    return;
                }
                domStatus('qcTr', 'error', cleanMessage(error.message));
                transferBtn.disabled = false;
            });
        }

        $(function () {
            $('ul.nav.nav-tabs > li.domain-tab a').on('click', function () {
                $('#domain-action').val($(this).attr('rel'));
            });

            $('#config-next').hide();
            $('#config-next').prop('disabled', true);

            if ($('.addons').length) {
                $('.order-button').one('click', function () {
                    $(this).hide();
                    $('.addons').slideDown('fast');
                    return false;
                });
            }

            $('.addon-period-selector').on('change', function () {
                var rel = $(this).attr('rel');
                $('#' + rel + ' span').hide();
                $('#' + rel + ' span.' + $(this).val()).fadeIn();
            }).trigger('change');

            if (registerBtn) {
                registerBtn.addEventListener('click', function () { runRegisterCheck(0); return false; });
            }
            if (transferBtn) {
                transferBtn.addEventListener('click', function () { runTransferCheck(0); return false; });
            }

            {% if request.transfer_sld and transfer_tlds is not empty %}
            // Quizontal: transfer link prefilled — open the Transfer tab and run the check.
            $('#transfer-tab').tab('show');
            setTimeout(function () { runTransferCheck(0); }, 300);
            {% elseif request.register_sld and tlds is not empty %}
            // Quizontal: register link prefilled — run the availability check immediately.
            setTimeout(function () { runRegisterCheck(0); }, 300);
            {% endif %}
        });
    })();
</script>
