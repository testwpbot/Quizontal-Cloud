{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ ticket.subject }}{% endblock %}

{% block head %}
    {{ encore_entry_link_tags('markdown') }}
    {{ mf.wysiwyg('.editor-textarea') }}
{% endblock %}

{% block body_class %}support-ticket qc-has-banner{% endblock %}
{% block breadcrumbs %}{% endblock %}

{% block banner %}
    <div class="iq-banner">
        <div class="iq-banner-art" aria-hidden="true"></div>
        <div class="container-fluid iq-container">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <h1>{{ ticket.subject }}</h1>
                    <p>{{ 'Ticket'|trans }} #{{ ticket.id }} · {{ ticket.helpdesk.name }}</p>
                    <span class="banner-date">
                        <svg fill="currentColor"><use href="#i-chat"/></svg>
                        {{ mf.status_name(ticket.status) }}
                    </span>
                </div>
                <div>
                    <a href="{{ 'support'|link }}" class="premium-btn">{{ 'Back to tickets'|trans }}</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
{% if client %}
    <style>
        .qc-ticket-meta { display: flex; flex-direction: column; gap: 12px; }
        .qc-ticket-meta .qc-meta-row { display: flex; justify-content: space-between; gap: 14px; padding: 11px 2px; border-bottom: 1px solid var(--iq-line, rgba(255,255,255,.06)); }
        .qc-ticket-meta .qc-meta-row:last-child { border-bottom: 0; }
        .qc-meta-label { font-size: .74rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #7d8494; }
        .qc-meta-value { font-weight: 600; color: var(--iq-heading); text-align: right; }
        .qc-message-card { background: var(--iq-surface, #0b0b0e); border: 1px solid var(--iq-line, rgba(255,255,255,.06)); border-radius: .75rem; }
        .qc-message-card.qc-admin { border-color: rgba(227,28,100,.3); }
        .qc-message-head { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--iq-line, rgba(255,255,255,.06)); }
        .qc-message-avatar { width: 40px; height: 40px; border-radius: 50%; overflow: hidden; flex: none; }
        .qc-message-body { padding: 18px; }
        .qc-message-body .markdown-body { background: transparent; color: var(--iq-body, #9aa3b2); }
    </style>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="header-title">
                <h4 class="card-title">{{ 'Ticket'|trans }} #{{ ticket.id }}</h4>
                <p class="mb-0 text-size-12" style="color:#98a1b3">{{ 'Opened'|trans }} {{ ticket.created_at|format_date }}</p>
            </div>
            <div class="d-flex gap-2">
                {% if (ticket.status != 'closed') or (ticket.helpdesk.can_reopen) %}
                    <button class="btn btn-primary btn-sm" id="reply-to-btn">{{ 'Reply'|trans }}</button>
                {% endif %}
                {% if ticket.status != 'closed' %}
                    <button class="btn btn-outline-secondary btn-sm" type="button" id="ticket-close">{{ 'Close ticket'|trans }}</button>
                {% endif %}
            </div>
        </div>
        <div class="card-body">
            <div class="qc-ticket-meta">
                <div class="qc-meta-row"><span class="qc-meta-label">{{ 'Help desk'|trans }}</span><span class="qc-meta-value">{{ ticket.helpdesk.name }}</span></div>
                <div class="qc-meta-row">
                    <span class="qc-meta-label">{{ 'Status'|trans }}</span>
                    <span class="qc-meta-value">
                        {% if ticket.status == 'open' %}
                            <span class="iq-badge bg-soft-success"><span class="iq-badge-dot"></span>{{ mf.status_name(ticket.status) }}</span>
                        {% elseif ticket.status == 'on_hold' %}
                            <span class="iq-badge bg-soft-warning"><span class="iq-badge-dot"></span>{{ mf.status_name(ticket.status) }}</span>
                        {% else %}
                            <span class="iq-badge bg-soft-danger"><span class="iq-badge-dot"></span>{{ mf.status_name(ticket.status) }}</span>
                        {% endif %}
                    </span>
                </div>
                <div class="qc-meta-row"><span class="qc-meta-label">{{ 'Time opened'|trans }}</span><span class="qc-meta-value">{{ ticket.created_at|format_date }}</span></div>
                {% if ticket.rel_type == 'order' and ticket.rel_id %}
                    <div class="qc-meta-row"><span class="qc-meta-label">{{ 'Related to'|trans }}</span><span class="qc-meta-value"><a href="{{ 'order/service/manage'|link }}/{{ ticket.rel_id }}" style="color:#f06b9d">{{ 'Service #'|trans }} {{ ticket.rel_id }}</a></span></div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="d-flex flex-column gap-3 mb-3">
        {% for i, message in ticket.messages %}
            <div class="qc-message-card {{ message.admin_id ? 'qc-admin' : '' }}">
                <div class="qc-message-head">
                    <div class="qc-message-avatar"><img src="{{ message.author.email|gravatar(80) }}" alt="{{ message.author.name }}" class="w-100 h-100" style="object-fit:cover"></div>
                    <div class="d-flex flex-column">
                        <span class="service-name" style="color:var(--iq-heading)">{{ message.author.name }}</span>
                        {% if message.admin_id %}
                            <span class="iq-badge bg-soft-primary"><span class="iq-badge-dot"></span>{{ 'Operator'|trans }}</span>
                        {% else %}
                            <span class="iq-badge" style="background:#1e1e24;color:#9aa3b2"><span class="iq-badge-dot"></span>{{ 'You'|trans }}</span>
                        {% endif %}
                    </div>
                    <span class="text-muted ms-auto fs-7">on {{ message.created_at|format_date }}</span>
                    {% if (ticket.status != 'closed') or (ticket.helpdesk.can_reopen) %}
                        <button class="btn btn-outline-secondary btn-sm btn-quote-reply"
                                message-quote="{{ mf.markdown_quote(message.content) }}"
                                data-bs-toggle="tooltip" data-bs-title="{{ 'Quote reply'|trans }}" title="{{ 'Quote reply'|trans }}">
                            <svg class="svg-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="width:16px;height:16px"><path d="M11 18V10H9.12L11.12 6H5.38L3 10.76V18M9 16H5V11.24L6.62 8H7.88L5.88 12H9M21 18V10H19.12L21.12 6H15.38L13 10.76V18M19 16H15V11.24L16.62 8H17.88L15.88 12H19Z"/></svg>
                        </button>
                    {% endif %}
                </div>
                <div class="qc-message-body">
                    <article class="markdown-body bg-transparent text-reset" id="message-{{ message.id }}">
                        {{ message.content|markdown }}
                    </article>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if ticket.status == 'closed' and not ticket.helpdesk.can_reopen %}
        <div class="mt-3 alert alert-secondary text-center">{{ 'Ticket was closed and cannot be reopened.'|trans }}</div>
    {% else %}
        {% if ticket.status == 'closed' %}
            <div class="mt-3 alert alert-secondary text-center">{{ 'This ticket was closed, but you can still reopen it by replying.'|trans }}</div>
        {% endif %}
        <div class="card mt-3" id="reply-to">
            <div class="card-header">
                <div class="header-title"><h4 class="card-title">{{ 'Reply'|trans }}</h4></div>
            </div>
            <div class="card-body">
                <form id="ticket-reply-form">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    <input type="hidden" name="id" value="{{ ticket.id }}">
                    <textarea name="content" cols="5" rows="10" class="editor-textarea form-control" required="required" id="ticket-reply-text"></textarea>
                    <button class="mt-3 premium-btn" type="submit" id="post-reply-btn" value="{{ 'Post'|trans }}">{{ 'Post'|trans }}</button>
                </form>
            </div>
        </div>
    {% endif %}
{% endif %}
{% endblock %}

{% block js %}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ticketReplyForm = document.getElementById('ticket-reply-form');
            const closeTicketBtn = document.getElementById('ticket-close');
            const postReplyBtn = document.getElementById('post-reply-btn');
            const replyToMessageBtn = document.querySelectorAll('.btn-quote-reply');
            const ticketReplyTextArea = document.getElementById('ticket-reply-text');

            ticketReplyForm.addEventListener('submit', (e) => {
                e.preventDefault();
                API.client.post('support/ticket_reply',
                    new FormData(ticketReplyForm).serializeObject(),
                    () => {
                        flashMessage({
                            message: 'Posted reply',
                            reload: true
                        });
                    },
                    (res) => FOSSBilling.message(`${res.message} (${res.code})`, 'error')
                )
            });

            closeTicketBtn.addEventListener('click', (e) => {
                e.preventDefault();
                toggleLoader();
                API.client.post('support/ticket_close',
                    new FormData(ticketReplyForm).serializeObject(),
                    () => {
                        flashMessage({
                            message: 'Closed ticket #{{ ticket.id }}',
                            reload: true
                        });
                    },
                    (res) => FOSSBilling.message(`${res.message} (${res.code})`, 'error')
                )
            });

            postReplyBtn.addEventListener('click', () => {
                if (document.getElementById('ticket-reply-text').value.length > 0) {
                    toggleLoader();
                }
            });

            replyToMessageBtn.forEach((reply) => {
                reply.addEventListener('click', (e) => {
                    e.preventDefault();
                    let quote = e.currentTarget.getAttribute('message-quote');
                    ticketReplyTextArea.textContent = quote.replace(/^\s*$(?:\r\n?|\n)/gm, '');
                    ticketReplyTextArea.focus();
                });
            })

            document.getElementById('reply-to-btn').addEventListener('click', () => {
                ticketReplyTextArea.focus();
            });

            const toggleLoader = () => {
                let loader = document.querySelector('.wait');
                if (loader.style.display === 'none') {
                    loader.style.display = 'block';
                } else {
                    loader.style.display = 'none';
                }
            }
        });
    </script>
{% endblock %}
