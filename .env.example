# Never commit real keys. Rotate any key that has been shared publicly.
PORT=3000
FOSSBILLING_URL=https://billing.example.com
# Optional: exact FOSSBilling order URL. Use {productId} as a placeholder if needed.
FOSSBILLING_ORDER_URL=https://billing.example.com/order
INTERSERVER_API_URL=https://my.interserver.net/apiv2
INTERSERVER_API_KEY=replace_with_your_interserver_api_key
EXCHANGERATE_API_KEY=replace_with_your_exchangerate_api_key
# Protects POST /api/admin/import. Use a long random value.
IMPORT_TOKEN=replace_with_a_long_random_token
# Add this many USD to InterServer's monthly USD price before converting to LKR.
PROFIT_USD=1
